/**
 * -----------------------------------------------------------------------------
 *  Declarators and type names, 6.7.7 and 6.7.8.
 * -----------------------------------------------------------------------------
 *
 *  A declarator is turned into the tree of types of what it declares: the
 *  reducers return no node, but a function from the type of the specifiers
 *  to the declared type, which the reducer of the declaration applies. The
 *  parts nearest to the name apply last: in "*a[3]" the pointer applies to
 *  the base, the array to the pointer. A concrete declarator gives its
 *  parent the name, the function and the attributes written after the name,
 *  which belong to the declaration, an abstract one gives the function
 *  alone.
 */

/**
 * 6.7.7.1 General, a declarator with a name
 */
Declarator
  : AttributedNameDeclarator()
  | PointerDeclarator()
  | NameDeclarator()
  | NestedDeclarator()
  ;

/**
 * A pointer or a block pointer before the rest of the declarator, the
 * calling conventions before a pointer or the GCC attributes at the start
 * of a parenthesized declarator. Each wraps the type the declarator receives: in
 * "(__stdcall *f)(int)" the calling convention applies to the function f
 * points to, in "int (__attribute__((x)) a[3])" the attribute applies to
 * the int.
 */
PointerDeclarator -> {
    /**
     * @var list{
     *     \Closure(Type\TypeInterface|null): (Type\TypeInterface|null),
     *     Node\Identifier,
     *     \Closure(Type\TypeInterface|null): (Type\TypeInterface|null),
     *     ...<Attribute\AttributeInterface>
     * } $children
     */
    $result = [
        $children[1],
        static fn(?Type\TypeInterface $type): ?Type\TypeInterface => $children[2]($children[0]($type)),
    ];

    for ($i = 3, $count = \count($children); $i < $count; ++$i) {
        $result[] = $children[$i];
    }

    return $result;
}
  : (Pointer() | BlockPointer() | DeclaratorAttributes()) Declarator()
  ;

/**
 * MSVC: the calling conventions before a name or a parenthesized declarator
 * apply to the type the rest declares: "int __stdcall f(void)",
 * "void * __stdcall g(void)" and "int __stdcall (f)(void)" are functions
 * with the calling convention.
 */
AttributedNameDeclarator -> {
    /**
     * @var list{
     *     \Closure(Type\TypeInterface|null): Type\TypeInterface,
     *     Node\Identifier,
     *     \Closure(Type\TypeInterface|null): (Type\TypeInterface|null),
     *     ...<Attribute\AttributeInterface>
     * } $children
     */
    $result = [
        $children[1],
        static fn(?Type\TypeInterface $type): Type\TypeInterface => $children[0]($children[2]($type)),
    ];

    for ($i = 3, $count = \count($children); $i < $count; ++$i) {
        $result[] = $children[$i];
    }

    return $result;
}
  : &<T_CALLING_CONVENTION> DeclaratorAttributes() (NameDeclarator() | NestedDeclarator())
  ;

/**
 * The attributes a declarator starts with: the calling conventions of MSVC
 * or the GCC attributes and the MSVC attributes of PHP FFI at the start of
 * a parenthesized declarator. They belong to the nearest function type,
 * through the pointers, the block pointers, the qualifiers and the
 * attributed types, among its own attributes in the order written. A type
 * without a function with them is an AttributedType.
 */
DeclaratorAttributes -> {
    /** @var non-empty-list<Attribute\AttributeInterface> $children */
    $merge = static function (?Attribute\AttributeList $list) use ($children): Attribute\AttributeList {
        $attributes = $children;

        foreach ($list ?? [] as $attribute) {
            $attributes[] = $attribute;
        }

        \usort(
            $attributes,
            static fn(Attribute\AttributeInterface $a, Attribute\AttributeInterface $b): int => $a->offset <=> $b->offset,
        );

        return new Attribute\AttributeList($attributes, $attributes[0]->offset);
    };

    return static function (?Type\TypeInterface $type) use ($offset, $merge): Type\TypeInterface {
        $wrappers = [];
        $inner = $type;

        while ($inner instanceof Type\PointerType
            || $inner instanceof Type\BlockPointerType
            || $inner instanceof Type\QualifiedType
            || $inner instanceof Type\AttributedType) {
            $wrappers[] = $inner;
            $inner = $inner->type;
        }

        if ($type instanceof Type\AttributedType && !$inner instanceof Type\FunctionType) {
            return new Type\AttributedType($merge($type->attributes), $type->type, \min($offset, $type->offset));
        }

        if (!$inner instanceof Type\FunctionType) {
            return new Type\AttributedType($merge(null), $type, $offset);
        }

        $result = new Type\FunctionType(
            $inner->returnType,
            $inner->parameters,
            $inner->isVariadic,
            $merge($inner->attributes),
            $inner->offset,
        );

        for ($i = \count($wrappers) - 1; $i >= 0; --$i) {
            $wrapper = $wrappers[$i];

            $result = match (true) {
                $wrapper instanceof Type\PointerType
                    => new Type\PointerType($result, $wrapper->attributes, $wrapper->offset),
                $wrapper instanceof Type\BlockPointerType
                    => new Type\BlockPointerType($result, $wrapper->attributes, $wrapper->offset),
                $wrapper instanceof Type\QualifiedType
                    => new Type\QualifiedType($wrapper->qualifiers, $result, $wrapper->offset),
                default => new Type\AttributedType($wrapper->attributes, $result, $wrapper->offset),
            };
        }

        return $result;
    };
}
  : (GnuAttributeSpecifier() | TrailingDeclSpec())+
  | CallingConvention()+
  ;

/**
 * The name, its attributes and the arrays and the functions after it,
 * which apply in reverse order: "a[2][3]" is an array of two arrays of
 * three. The GCC attributes after a declarator belong to the declaration,
 * the member or the parameter, not to the name.
 */
NameDeclarator -> {
    /**
     * @var list{
     *     TokenInterface,
     *     ...<Attribute\AttributeInterface|\Closure(Type\TypeInterface|null): (Type\TypeInterface|null)>
     * } $children
     */
    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    $name = new Node\Identifier($children[0]->value, $offset);
    $attributes = [];
    $suffixes = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof \Closure) {
            $suffixes[] = $children[$i];
        } else {
            $attributes[] = $children[$i];
        }
    }

    return [$name, static function (?Type\TypeInterface $type) use ($suffixes): ?Type\TypeInterface {
        for ($i = \count($suffixes) - 1; $i >= 0; --$i) {
            $type = $suffixes[$i]($type);
        }

        return $type;
    }, ...$attributes];
}
  : (<T_IDENTIFIER> | <T_BUILTIN_CALL> | KeywordIdentifier()) StandardAttributeSpecifier()* DeclaratorSuffix()*
  ;

/**
 * A parenthesized declarator followed by the arrays and the functions. The
 * parenthesized declarator applies last of all: "(*f)(int)" is a pointer
 * to a function.
 */
NestedDeclarator -> {
    /**
     * @var list{
     *     Node\Identifier,
     *     \Closure(Type\TypeInterface|null): (Type\TypeInterface|null),
     *     ...<Attribute\AttributeInterface|\Closure(Type\TypeInterface|null): (Type\TypeInterface|null)>
     * } $children
     */
    $attributes = [];
    $suffixes = [];

    for ($i = 2, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof \Closure) {
            $suffixes[] = $children[$i];
        } else {
            $attributes[] = $children[$i];
        }
    }

    return [$children[0], static function (?Type\TypeInterface $type) use ($children, $suffixes): ?Type\TypeInterface {
        for ($i = \count($suffixes) - 1; $i >= 0; --$i) {
            $type = $suffixes[$i]($type);
        }

        return $children[1]($type);
    }, ...$attributes];
}
  : ::T_LPAREN:: Declarator()
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the declarator, \")\" expected")
    DeclaratorSuffix()*
  ;

/**
 * 6.7.8 Type names, a declarator without a name
 */
AbstractDeclarator
  : AbstractPointerDeclarator()
  | DirectAbstractDeclarator()
  ;

/**
 * A pointer or the attributes of the declarator, as in a declarator with a
 * name. The calling conventions alone end an unnamed parameter,
 * "void f(int * __cdecl)". The GCC attributes alone are no declarator,
 * "(__attribute__((x)))" is a parameter list.
 */
AbstractPointerDeclarator -> {
    /**
     * @var array{
     *     \Closure(Type\TypeInterface|null): (Type\TypeInterface|null),
     *     1?: \Closure(Type\TypeInterface|null): (Type\TypeInterface|null)
     * } $children
     */
    if (!isset($children[1])) {
        return $children[0];
    }

    return static fn(?Type\TypeInterface $type): ?Type\TypeInterface => $children[1]($children[0]($type));
}
  : (Pointer() | BlockPointer() | &<T_CALLING_CONVENTION> DeclaratorAttributes()) AbstractDeclarator()?
  | DeclaratorAttributes() AbstractDeclarator()
  ;

/**
 * A parenthesized abstract declarator followed by the arrays and the
 * functions, "(*)(int)", or the arrays and the functions alone. They apply
 * in the same order as in a declarator with a name.
 */
DirectAbstractDeclarator -> {
    /** @var non-empty-list<\Closure(Type\TypeInterface|null): (Type\TypeInterface|null)> $children */
    return static function (?Type\TypeInterface $type) use ($children): ?Type\TypeInterface {
        for ($i = \count($children) - 1; $i >= 0; --$i) {
            $type = $children[$i]($type);
        }

        return $type;
    };
}
  : ::T_LPAREN:: AbstractDeclarator() ::T_RPAREN:: AbstractDeclaratorSuffix()*
  | AbstractDeclaratorSuffix()+
  ;

/**
 * An array or a function of an abstract declarator, whose array of
 * unspecified size has no qualifiers: "[*]", not "[const *]" (6.7.8)
 */
AbstractDeclaratorSuffix
  : !QualifiedUnspecifiedSize() DeclaratorSuffix()
  ;

QualifiedUnspecifiedSize
  : <T_LBRACKET> TypeQualifier()+ <T_ASTERISK> <T_RBRACKET>
  ;

/**
 * 6.7.7.2 Pointer declarators
 */
Pointer -> {
    /**
     * @var array{
     *     TokenInterface,
     *     Attribute\AttributeList|null,
     *     \Closure(Type\TypeInterface): Type\TypeInterface
     * } $children
     */
    return static fn(?Type\TypeInterface $type): Type\TypeInterface
        => $children[2](new Type\PointerType($type, $children[1], $offset));
}
  : <T_ASTERISK> PointerQualifiers()
  ;

/**
 * Clang: a block pointer, "void (^callback)(int)", with the qualifiers and
 * the attributes of a pointer. Requires the BlockPointers feature.
 */
BlockPointer -> {
    /**
     * @var array{
     *     TokenInterface,
     *     Attribute\AttributeList|null,
     *     \Closure(Type\TypeInterface): Type\TypeInterface
     * } $children
     */
    $this->assertFeature(Feature::BlockPointers, $source, $children[0]->offset, $children[0]->size);

    return static fn(?Type\TypeInterface $type): Type\TypeInterface
        => $children[2](new Type\BlockPointerType($type, $children[1], $offset));
}
  : <T_CARET> PointerQualifiers()
  ;

/**
 * The attributes and the qualifiers after "*" or "^": the attributes before
 * the qualifiers, and the GCC and MSVC attributes, the MSVC modifiers of a
 * pointer and the Clang nullability and signing of a pointer anywhere among
 * them. The attributes belong to the pointer, and the qualifiers wrap it.
 * Passed to
 * the parent as two children: the attributes, null in case of none is
 * written, and the function from the pointer to the qualified one.
 */
PointerQualifiers -> {
    /** @var list<Type\QualifiedType\TypeQualifier|Attribute\AttributeInterface> $children */
    $qualifiers = [];
    $attributes = [];

    for ($i = 0, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Type\QualifiedType\TypeQualifier) {
            $qualifiers[] = $children[$i];
        } else {
            $attributes[] = $children[$i];
        }
    }

    $attributeList = $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset);

    if ($qualifiers === []) {
        return [$attributeList, static fn(Type\TypeInterface $pointer): Type\TypeInterface => $pointer];
    }

    return [$attributeList, static fn(Type\TypeInterface $pointer): Type\TypeInterface => new Type\QualifiedType(
        $qualifiers,
        $pointer,
        $pointer->offset,
    )];
}
  : StandardAttributeSpecifier()*
    (
        TypeQualifier() | GnuAttributeSpecifier() | TrailingDeclSpec() | PointerModifier()
      | BasedPointerModifier() | Nullability() | PointerAuth()
    )*
  ;

/**
 * An array or a function and the attributes after it, which apply to it
 * (6.7.7.3, 6.7.7.4). The GCC attributes after the whole declarator belong
 * to the declaration, as in "void exit(int) __attribute__((noreturn));".
 */
DeclaratorSuffix -> {
    /**
     * @var list{
     *     \Closure(Type\TypeInterface|null, Attribute\AttributeList|null=): Type\TypeInterface,
     *     ...<Attribute\AttributeInterface>
     * } $children
     */
    if (!isset($children[1])) {
        return $children[0];
    }

    $attributes = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $attributes[] = $children[$i];
    }

    $attributeList = new Attribute\AttributeList($attributes, $children[1]->offset);

    return static fn(?Type\TypeInterface $type): Type\TypeInterface => $children[0]($type, $attributeList);
}
  : (ArrayDeclarator() | FunctionDeclarator()) StandardAttributeSpecifier()*
  ;

/**
 * -----------------------------------------------------------------------------
 *  6.7.7.3 Array declarators
 * -----------------------------------------------------------------------------
 *
 *  "[*p]" has a size, "[*]" has an unspecified one. The bracket marks the
 *  start of the array. The attributes after the brackets are given to the
 *  function of the array, after the GCC attributes in the brackets.
 */

/**
 * A qualifier in the brackets of an array, or among them the attributes and
 * the qualifiers of the extensions a pointer takes after "*": the GCC
 * attributes, "int a[__attribute__((x)) 3]", the MSVC modifiers of a
 * pointer, the Clang nullability, and the MSVC attributes and the calling
 * conventions of PHP FFI
 */
ArrayQualifier
  : TypeQualifier()
  | GnuAttributeSpecifier()
  | PointerModifier()
  | Nullability()
  | TrailingDeclSpec()
  | ArrayCallingConvention()
  ;

/**
 * PHP FFI: a calling convention in the brackets of an array,
 * "void f(int a[__cdecl 3])". Requires the TrailingCallingConventions
 * feature.
 */
ArrayCallingConvention -> {
    /** @var Attribute\AttributeInterface $children */
    $this->assertFeature(Feature::TrailingCallingConventions, $source, $offset, $length);

    return $children;
}
  : CallingConvention()
  ;

ArrayDeclarator
  : SizedArrayDeclarator()
  | UnspecifiedSizeArrayDeclarator()
  | IncompleteArrayDeclarator()
  ;

/**
 * [3], [const 3], [static 3], [static const 3] and [const static 3]
 */
SizedArrayDeclarator -> {
    /**
     * @var list{
     *     TokenInterface,
     *     ...<
     *         TokenInterface
     *         |Type\QualifiedType\TypeQualifier
     *         |Attribute\AttributeInterface
     *         |Expression\ExpressionInterface
     *     >
     * } $children
     */
    $qualifiers = [];
    $attributes = [];
    $isStatic = false;
    $last = \count($children) - 1;

    for ($i = 1; $i < $last; ++$i) {
        if ($children[$i] instanceof Type\QualifiedType\TypeQualifier) {
            $qualifiers[] = $children[$i];
        } elseif ($children[$i] instanceof Attribute\AttributeInterface) {
            $attributes[] = $children[$i];
        } else {
            $isStatic = true;
        }
    }

    // The size ends the rule
    \assert($children[$last] instanceof Expression\ExpressionInterface);

    return static function (
        ?Type\TypeInterface $type,
        ?Attribute\AttributeList $after = null,
    ) use ($children, $last, $isStatic, $qualifiers, $attributes, $offset): Type\TypeInterface {
        foreach ($after ?? [] as $attribute) {
            $attributes[] = $attribute;
        }

        return new Type\ArrayType\SizedArrayType(
            $type,
            $children[$last],
            $isStatic,
            $qualifiers,
            $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset),
            $offset,
        );
    };
}
  : <T_LBRACKET>
        (<T_STATIC> ArrayQualifier()* | ArrayQualifier()* <T_STATIC>?)
        AssignmentExpression()
    ::T_RBRACKET:: @error("Syntax error, unexpected {token} in the array declarator, \"]\" expected")
  ;

/**
 * [*] and [const *]
 */
UnspecifiedSizeArrayDeclarator -> {
    /** @var list{TokenInterface, ...<Type\QualifiedType\TypeQualifier|Attribute\AttributeInterface>} $children */
    $qualifiers = [];
    $attributes = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Type\QualifiedType\TypeQualifier) {
            $qualifiers[] = $children[$i];
        } else {
            $attributes[] = $children[$i];
        }
    }

    return static function (
        ?Type\TypeInterface $type,
        ?Attribute\AttributeList $after = null,
    ) use ($qualifiers, $attributes, $offset): Type\TypeInterface {
        foreach ($after ?? [] as $attribute) {
            $attributes[] = $attribute;
        }

        return new Type\ArrayType\UnspecifiedSizeArrayType(
            $type,
            $qualifiers,
            $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset),
            $offset,
        );
    };
}
  : <T_LBRACKET> ArrayQualifier()* ::T_ASTERISK::
    ::T_RBRACKET:: @error("Syntax error, unexpected {token} in the array declarator, \"]\" expected")
  ;

/**
 * [] and [const]
 */
IncompleteArrayDeclarator -> {
    /** @var list{TokenInterface, ...<Type\QualifiedType\TypeQualifier|Attribute\AttributeInterface>} $children */
    $qualifiers = [];
    $attributes = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Type\QualifiedType\TypeQualifier) {
            $qualifiers[] = $children[$i];
        } else {
            $attributes[] = $children[$i];
        }
    }

    return static function (
        ?Type\TypeInterface $type,
        ?Attribute\AttributeList $after = null,
    ) use ($qualifiers, $attributes, $offset): Type\TypeInterface {
        foreach ($after ?? [] as $attribute) {
            $attributes[] = $attribute;
        }

        return new Type\ArrayType\IncompleteArrayType(
            $type,
            $qualifiers,
            $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset),
            $offset,
        );
    };
}
  : <T_LBRACKET> ArrayQualifier()*
    ::T_RBRACKET:: @error("Syntax error, unexpected {token} in the array declarator, a size or \"]\" expected")
  ;

/**
 * -----------------------------------------------------------------------------
 *  6.7.7.4 Function declarators
 * -----------------------------------------------------------------------------
 */

/**
 * (), (void), (int a, char *b), (int, ...) and (...). The parenthesis marks
 * the start of the function.
 */
FunctionDeclarator -> {
    /** @var list{TokenInterface, ...<Type\FunctionType\Parameter|TokenInterface>} $children */
    $parameters = [];
    $isVariadic = false;

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Type\FunctionType\Parameter) {
            $parameters[] = $children[$i];
        } else {
            $isVariadic = true;
        }
    }

    $list = new Type\FunctionType\ParameterList($parameters, $parameters[0]->offset ?? $offset);

    return static fn(
        ?Type\TypeInterface $type,
        ?Attribute\AttributeList $attributes = null,
    ): Type\TypeInterface => new Type\FunctionType($type, $list, $isVariadic, $attributes, $offset);
}
  : <T_LPAREN> ParameterTypeList()?
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the parameters, \",\" or \")\" expected")
  ;

ParameterTypeList
  : ParameterDeclaration() (::T_COMMA:: ParameterDeclaration())* (::T_COMMA:: <T_ELLIPSIS>)?
  | <T_ELLIPSIS>
  ;

/**
 * A parameter, after __extension__ or not
 */
ParameterDeclaration
  : ExtensionKeyword()* Parameter()
  ;

/**
 * A parameter with a name, an abstract declarator or none, the attributes
 * after the name and the GCC attributes after the declarator
 */
Parameter -> {
    /**
     * @var list{
     *     Type\TypeInterface|null,
     *     Specifier\SpecifierList|null,
     *     ...<
     *         Node\Identifier
     *         |\Closure(Type\TypeInterface|null): (Type\TypeInterface|null)
     *         |Attribute\AttributeInterface
     *     >
     * } $children
     */
    $name = null;
    $type = $children[0];
    $attributes = [];

    for ($i = 2, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Node\Identifier) {
            $name = $children[$i];
        } elseif ($children[$i] instanceof \Closure) {
            $type = $children[$i]($children[0]);
        } else {
            $attributes[] = $children[$i];
        }
    }

    return new Type\FunctionType\Parameter(
        $type,
        $name,
        $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset),
        $children[1],
        $offset,
    );
}
  : DeclarationSpecifiers() (!ParenthesizedName() Declarator() | AbstractDeclarator())? GnuAttributeSpecifier()*
  ;

/**
 * 6.7.7.4 Function declarators, a declarator whose name is parenthesized
 * alone: "(T)", "*(T)", "((T))". In a parameter such a name is read as the
 * parameter of a function, "int (T)" is a function of T returning int. So
 * is a parenthesized keyword that starts the declaration specifiers and
 * that PHP FFI reads as a name: "int (bool)" is a function of bool.
 */
ParenthesizedName
  : (Pointer() | BlockPointer())* <T_LPAREN> (ParenthesizedName() | <T_IDENTIFIER> <T_RPAREN> | SpecifierKeyword())
  ;

/**
 * A keyword of the declaration specifiers among the ones a keyword name can
 * be (KeywordIdentifier)
 */
SpecifierKeyword
  : <T_BOOL> | <T_ALIGNAS> | <T_TYPEOF> | <T_TYPEOF_UNQUAL> | <T_BITINT> | <T_DECIMAL_NX> | <T_DECIMAL_N>
  | <T_FLOAT_NX> | <T_FLOAT_N> | <T_CONSTEXPR> | <T_THREAD_LOCAL> | <T_IMAGINARY> | <T_FORCE_INLINE>
  | <T_POINTER_MODIFIER> | <T_BASED> | <T_NULLABILITY> | <T_PTRAUTH>
  ;

/**
 * 6.7.8 Type names, the type in a cast, sizeof, alignof, alignas, typeof
 * and _Atomic(T): the specifiers and an abstract declarator
 */
TypeName -> {
    /** @var array{Type\TypeInterface, 1?: \Closure(Type\TypeInterface|null): (Type\TypeInterface|null)} $children */
    if (!isset($children[1])) {
        return $children[0];
    }

    // An abstract declarator always builds a type around the specifiers
    $type = $children[1]($children[0]);
    \assert($type !== null);

    return $type;
}
  : TypeNameSpecifiers() AbstractDeclarator()?
  ;

/**
 * The first tokens of a type name that reads as an expression as well,
 * other than a lone identifier: the name of a built-in function before
 * its parenthesis "__builtin_expect(", an array with a size "a[3]", a
 * function without parameters "f()", and a function or a function returning a
 * pointer whose first parameter starts with a typedef name and reads as an
 * expression too, "f(x)", "f(x, y)", "a * (b)", "a * ((b), c)",
 * "a * (b[2])" or "a * (b * c)". Where an expression is allowed too (a
 * cast, sizeof, typeof, typeof_unqual and alignas), such a type name is
 * read as the expression: "sizeof(a[0])" is the size of an element,
 * "typeof(f())" is the type of a call, "(a * (b)) + 1" is a product. Only
 * the first tokens are checked: "typeof(T[3])" and "typeof(T *(U, V))" are
 * expressions as well, though a typedef name T makes them valid types. The
 * arrays without a size and the parameters that cannot be an expression
 * ("T[]", "T[static 3]", "T(U *)", "T *(U *)") stay type names.
 */
ExpressionLikeTypeName
  : <T_BUILTIN_CALL>
  | <T_IDENTIFIER> <T_LBRACKET> !ArrayDeclaratorStart()
  | <T_IDENTIFIER> <T_LPAREN> <T_RPAREN>
  | <T_IDENTIFIER> (<T_ASTERISK> | <T_CARET>)* <T_LPAREN>+ <T_IDENTIFIER> ExpressionLikeParameterEnd()
  ;

/**
 * What follows the "[" of an array that has no size or has the qualifiers
 * and "static" of a parameter
 */
ArrayDeclaratorStart
  : <T_RBRACKET>
  | <T_STATIC>
  | <T_GNU_ATTRIBUTE>
  | <T_POINTER_MODIFIER>
  | <T_NULLABILITY>
  | <T_DECLSPEC>
  | <T_CALLING_CONVENTION>
  | <T_CONST>
  | <T_VOLATILE>
  | <T_RESTRICT>
  | <T_ATOMIC>
  | <T_ASTERISK> <T_RBRACKET>
  ;

/**
 * A token after the typedef name of a parameter that an expression can have
 * after an identifier too
 */
ExpressionLikeParameterEnd
  : <T_RPAREN>
  | <T_COMMA>
  | <T_LBRACKET>
  | (<T_ASTERISK> | <T_CARET>)+ (<T_IDENTIFIER> | <T_LPAREN>)
  ;
