//
// Declarators and type names, 6.7.7 and 6.7.8.
//
// A declarator is turned into the tree of types of what it declares: the
// reducers return no node, but a function from the type of the specifiers
// to the declared type, which the reducer of the declaration applies. The
// closures are composed so that the parts nearest to the name apply last:
// in "*a[3]" the pointer applies to the base, the array to the pointer. A
// concrete declarator gives its parent the name, the function and the
// attributes written after the name, which belong to the declaration, an
// abstract one gives the function alone.
//

// 6.7.7.1 General, a declarator with a name
Declarator
  : PointerDeclarator()
  | NameDeclarator()
  | NestedDeclarator()
  ;

// A pointer, or the attributes at the start of a parenthesized declarator,
// before the rest of the declarator. Both wrap the type the declarator
// receives.
PointerDeclarator -> {
    /**
     * @var list{
     *     \Closure(Type\TypeInterface|null): (Type\TypeInterface|null),
     *     Node\Identifier,
     *     \Closure(Type\TypeInterface|null): (Type\TypeInterface|null),
     *     ...<Attribute\AttributeInterface>
     * } $children
     */
    $result = [
        $children[1],
        static fn(?Type\TypeInterface $type): ?Type\TypeInterface => $children[2]($children[0]($type)),
    ];

    for ($i = 3, $count = \count($children); $i < $count; ++$i) {
        $result[] = $children[$i];
    }

    return $result;
}
  : (Pointer() | DeclaratorAttributes()) Declarator()
  ;

// The attributes at the start of a parenthesized declarator apply to the
// type it receives, as GCC has them: in "(__stdcall *f)(int)" they apply to
// the function. Elsewhere the attributes before a declarator are taken by
// the specifiers or by the declaration first, and the ones after "*" by the
// pointer.
DeclaratorAttributes -> {
    /** @var list<Attribute\AttributeInterface> $children */
    if ($children === []) {
        return static fn(?Type\TypeInterface $type): ?Type\TypeInterface => $type;
    }

    $attributes = new Attribute\AttributeList($children, $children[0]->offset);

    return static fn(?Type\TypeInterface $type): Type\TypeInterface => new Type\AttributedType(
        $attributes,
        $type,
        $offset,
    );
}
  : AttributeSpecifier()+
  ;

// The name, its attributes and the arrays and the functions after it,
// which apply in reverse order: "a[2][3]" is an array of two arrays of
// three. The name is read here rather than by Identifier(), as in
// NamedType: every declarator would build it in a rule of its own.
NameDeclarator -> {
    /**
     * @var list{
     *     TokenInterface,
     *     ...<Attribute\AttributeInterface|\Closure(Type\TypeInterface|null): (Type\TypeInterface|null)>
     * } $children
     */
    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    $name = new Node\Identifier($children[0]->value, $offset);
    $attributes = [];
    $suffixes = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof \Closure) {
            $suffixes[] = $children[$i];
        } else {
            $attributes[] = $children[$i];
        }
    }

    return [$name, static function (?Type\TypeInterface $type) use ($suffixes): ?Type\TypeInterface {
        for ($i = \count($suffixes) - 1; $i >= 0; --$i) {
            $type = $suffixes[$i]($type);
        }

        return $type;
    }, ...$attributes];
}
  : <T_IDENTIFIER> (AttributeSpecifier()+)? (DeclaratorSuffix()+)?
  ;

// A parenthesized declarator followed by the arrays and the functions. The
// parenthesized declarator applies last of all, so "(*f)(int)" is a
// pointer to a function.
NestedDeclarator -> {
    /**
     * @var list{
     *     Node\Identifier,
     *     \Closure(Type\TypeInterface|null): (Type\TypeInterface|null),
     *     ...<Attribute\AttributeInterface|\Closure(Type\TypeInterface|null): (Type\TypeInterface|null)>
     * } $children
     */
    $attributes = [];
    $suffixes = [];

    for ($i = 2, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof \Closure) {
            $suffixes[] = $children[$i];
        } else {
            $attributes[] = $children[$i];
        }
    }

    return [$children[0], static function (?Type\TypeInterface $type) use ($children, $suffixes): ?Type\TypeInterface {
        for ($i = \count($suffixes) - 1; $i >= 0; --$i) {
            $type = $suffixes[$i]($type);
        }

        return $children[1]($type);
    }, ...$attributes];
}
  : ::T_LPAREN:: Declarator() ::T_RPAREN:: (DeclaratorSuffix()+)?
  ;

// 6.7.8 Type names, a declarator without a name
AbstractDeclarator
  : AbstractPointerDeclarator()
  | DirectAbstractDeclarator()
  ;

// A pointer, or the attributes at the start of a parenthesized declarator,
// as in a declarator with a name. The attributes alone are no declarator.
AbstractPointerDeclarator -> {
    /**
     * @var array{
     *     \Closure(Type\TypeInterface|null): (Type\TypeInterface|null),
     *     1?: \Closure(Type\TypeInterface|null): (Type\TypeInterface|null)
     * } $children
     */
    if (!isset($children[1])) {
        return $children[0];
    }

    return static fn(?Type\TypeInterface $type): ?Type\TypeInterface => $children[1]($children[0]($type));
}
  : Pointer() AbstractDeclarator()?
  | DeclaratorAttributes() AbstractDeclarator()
  ;

// The parenthesized declarator is tried before the parameters of a
// function: "(*)" and "(__stdcall *)" start with a token no parameter
// does, or fail at the first token after the attributes. Without a name
// the parenthesized declarator applies first and the arrays and the
// functions after it, in the same order as in a declarator with a name.
DirectAbstractDeclarator -> {
    /** @var non-empty-list<\Closure(Type\TypeInterface|null): (Type\TypeInterface|null)> $children */
    return static function (?Type\TypeInterface $type) use ($children): ?Type\TypeInterface {
        for ($i = \count($children) - 1; $i >= 0; --$i) {
            $type = $children[$i]($type);
        }

        return $type;
    };
}
  : ::T_LPAREN:: AbstractDeclarator() ::T_RPAREN:: (DeclaratorSuffix()+)?
  | DeclaratorSuffix()+
  ;

// 6.7.7.2 Pointer declarators. The qualifiers of the pointer wrap it, and
// its attributes wrap them, written before the qualifiers in C23 and
// anywhere among them in GCC.
Pointer -> {
    /** @var list{TokenInterface, ...<Type\QualifiedType\TypeQualifier|Attribute\AttributeInterface>} $children */
    $qualifiers = [];
    $attributes = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Type\QualifiedType\TypeQualifier) {
            $qualifiers[] = $children[$i];
        } else {
            $attributes[] = $children[$i];
        }
    }

    $attributeList = $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset);

    if ($qualifiers === []) {
        return static fn(?Type\TypeInterface $type): Type\TypeInterface
            => new Type\PointerType($type, $attributeList, $offset);
    }

    return static fn(?Type\TypeInterface $type): Type\TypeInterface => new Type\QualifiedType(
        $qualifiers,
        new Type\PointerType($type, $attributeList, $offset),
        $offset,
    );
}
  : <T_ASTERISK> ((TypeQualifier() | AttributeSpecifier())+)?
  ;

// An array or a function and the C23 attributes after it, which apply to it
// (6.7.7.3, 6.7.7.4). The attributes of GCC and MSVC are not taken: after
// the whole declarator they belong to the declaration, as GCC has them in
// "void exit(int) __attribute__((noreturn));".
DeclaratorSuffix -> {
    /**
     * @var list{
     *     \Closure(Type\TypeInterface|null, Attribute\AttributeList|null=): Type\TypeInterface,
     *     ...<TokenInterface|Attribute\AttributeInterface>
     * } $children
     */
    $attributes = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        // The first bracket of each specifier is kept for the offsets
        if ($children[$i] instanceof Attribute\AttributeInterface) {
            $attributes[] = $children[$i];
        }
    }

    if ($attributes === []) {
        return $children[0];
    }

    $attributeList = new Attribute\AttributeList($attributes, $attributes[0]->offset);

    return static fn(?Type\TypeInterface $type): Type\TypeInterface => $children[0]($type, $attributeList);
}
  : (ArrayDeclarator() | FunctionDeclarator()) (StandardAttributeSpecifier()+)?
  ;

//
// 6.7.7.3 Array declarators. The expression of the size is tried first, so
// that "[*p]" is a size and "[*]" is not. The bracket is kept, so that the
// array starts where it is written.
//

ArrayDeclarator
  : SizedArrayDeclarator()
  | UnspecifiedSizeArrayDeclarator()
  | IncompleteArrayDeclarator()
  ;

// [3], [const 3], [static 3], [static const 3] and [const static 3]
SizedArrayDeclarator -> {
    /**
     * @var list{
     *     TokenInterface,
     *     ...<TokenInterface|Type\QualifiedType\TypeQualifier|Expression\ExpressionInterface>
     * } $children
     */
    $qualifiers = [];
    $isStatic = false;
    $last = \count($children) - 1;

    for ($i = 1; $i < $last; ++$i) {
        if ($children[$i] instanceof Type\QualifiedType\TypeQualifier) {
            $qualifiers[] = $children[$i];
        } else {
            $isStatic = true;
        }
    }

    // The size ends the rule
    \assert($children[$last] instanceof Expression\ExpressionInterface);

    return static fn(
        ?Type\TypeInterface $type,
        ?Attribute\AttributeList $attributes = null,
    ): Type\TypeInterface => new Type\ArrayType\SizedArrayType(
        $type,
        $children[$last],
        $isStatic,
        $qualifiers,
        $attributes,
        $offset,
    );
}
  : <T_LBRACKET>
        (<T_STATIC> (TypeQualifier()+)? | (TypeQualifier()+)? <T_STATIC>?)
        ConditionalExpression()
    ::T_RBRACKET::
  ;

// [*] and [const *]. C allows the qualifiers only in a declarator with a
// name, but the parser accepts them in a type name as well, as GCC does.
UnspecifiedSizeArrayDeclarator -> {
    /** @var list{TokenInterface, ...<Type\QualifiedType\TypeQualifier>} $children */
    $qualifiers = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $qualifiers[] = $children[$i];
    }

    return static fn(
        ?Type\TypeInterface $type,
        ?Attribute\AttributeList $attributes = null,
    ): Type\TypeInterface => new Type\ArrayType\UnspecifiedSizeArrayType(
        $type,
        $qualifiers,
        $attributes,
        $offset,
    );
}
  : <T_LBRACKET> (TypeQualifier()+)? ::T_ASTERISK:: ::T_RBRACKET::
  ;

// [] and [const]
IncompleteArrayDeclarator -> {
    /** @var list{TokenInterface, ...<Type\QualifiedType\TypeQualifier>} $children */
    $qualifiers = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $qualifiers[] = $children[$i];
    }

    return static fn(
        ?Type\TypeInterface $type,
        ?Attribute\AttributeList $attributes = null,
    ): Type\TypeInterface => new Type\ArrayType\IncompleteArrayType(
        $type,
        $qualifiers,
        $attributes,
        $offset,
    );
}
  : <T_LBRACKET> (TypeQualifier()+)? ::T_RBRACKET::
  ;

//
// 6.7.7.4 Function declarators
//

// (), (void), (int a, char *b), (int, ...) and (...). The parenthesis is
// kept, so that the function starts where it is written.
FunctionDeclarator -> {
    /** @var list{TokenInterface, ...<Type\FunctionType\Parameter|TokenInterface>} $children */
    $parameters = [];
    $isVariadic = false;

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Type\FunctionType\Parameter) {
            $parameters[] = $children[$i];
        } else {
            $isVariadic = true;
        }
    }

    $list = new Type\FunctionType\ParameterList($parameters, $parameters[0]->offset ?? $offset);

    return static fn(
        ?Type\TypeInterface $type,
        ?Attribute\AttributeList $attributes = null,
    ): Type\TypeInterface => new Type\FunctionType($type, $list, $isVariadic, $attributes, $offset);
}
  : <T_LPAREN> ParameterTypeList()? ::T_RPAREN::
  ;

ParameterTypeList
  : Parameter() ((::T_COMMA:: Parameter())+)? (::T_COMMA:: <T_ELLIPSIS>)?
  | <T_ELLIPSIS>
  ;

// A parameter with a name, an abstract declarator or none, and the
// attributes after the name and after the whole declarator. A declarator
// fails before its arrays and functions, at the place of the name, so an
// abstract one parses only the pointers and the parentheses once again.
Parameter -> {
    /**
     * @var list{
     *     Type\TypeInterface|null,
     *     Specifier\SpecifierList,
     *     ...<
     *         Node\Identifier
     *         |\Closure(Type\TypeInterface|null): (Type\TypeInterface|null)
     *         |Attribute\AttributeInterface
     *     >
     * } $children
     */
    $name = null;
    $type = $children[0];
    $attributes = [];

    for ($i = 2, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Node\Identifier) {
            $name = $children[$i];
        } elseif ($children[$i] instanceof \Closure) {
            $type = $children[$i]($children[0]);
        } else {
            $attributes[] = $children[$i];
        }
    }

    return new Type\FunctionType\Parameter(
        $type,
        $name,
        $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset),
        $children[1],
        $offset,
    );
}
  : DeclarationSpecifiers() (Declarator() | AbstractDeclarator())? (AttributeSpecifier()+)?
  ;

// 6.7.8 Type names, the type in a cast, sizeof, alignof, alignas, typeof
// and _Atomic(T): the specifiers and an abstract declarator
TypeName -> {
    /** @var array{Type\TypeInterface, 1?: \Closure(Type\TypeInterface|null): (Type\TypeInterface|null)} $children */
    if (!isset($children[1])) {
        return $children[0];
    }

    // An abstract declarator always builds a type around the specifiers
    $type = $children[1]($children[0]);
    \assert($type !== null);

    return $type;
}
  : TypeNameSpecifiers() AbstractDeclarator()?
  ;

// The first tokens of a type name that reads as an expression as well,
// other than a lone identifier: an array with a size "a[3]" or a function
// returning a pointer whose first parameter starts with a typedef name and
// reads as an expression too, "a * (b)", "a * ((b), c)", "a * (b[2])" or
// "a * (b * c)". Where an expression is allowed too (a cast, sizeof,
// typeof, typeof_unqual and alignas), such a type name is read as the
// expression: "sizeof(a[0])" is the size of an element, "(a * (b)) + 1" is
// a product. Only the first tokens are checked, so "typeof(T[3])" and
// "typeof(T *(U, V))" are expressions as well, though a typedef name T
// makes them valid types. The arrays without a size and the parameters
// that cannot be an expression ("T[]", "T[static 3]", "T *(U *)") stay
// type names.
ExpressionLikeTypeName
  : <T_IDENTIFIER> <T_LBRACKET> !ArrayDeclaratorStart()
  | <T_IDENTIFIER> <T_ASTERISK>+ <T_LPAREN>+ <T_IDENTIFIER> ExpressionLikeParameterEnd()
  ;

// What follows the "[" of an array without a size, the qualifiers and
// "static" of a parameter: no expression starts with it
ArrayDeclaratorStart
  : <T_RBRACKET>
  | <T_STATIC>
  | <T_CONST>
  | <T_VOLATILE>
  | <T_RESTRICT>
  | <T_ATOMIC>
  | <T_ASTERISK> <T_RBRACKET>
  ;

// A token after the typedef name of a parameter that an expression can have
// after an identifier too
ExpressionLikeParameterEnd
  : <T_RPAREN>
  | <T_COMMA>
  | <T_LBRACKET>
  | <T_ASTERISK>+ (<T_IDENTIFIER> | <T_LPAREN>)
  ;
