/**
 * -----------------------------------------------------------------------------
 *  External declarations, 6.7 and 6.9.
 * -----------------------------------------------------------------------------
 */

/**
 * A static assertion, a declaration, or a lone ";", which GCC and Clang
 * accept at file scope and which gives nothing
 */
ExternalDeclaration
  : StaticAssertDeclaration()
  | Declaration()
  | ::T_SEMICOLON::
  ;

/**
 * 6.7.1 Declarations. A declaration gives a node for each of its
 * declarators. Without declarators a bare structure, union or enumeration
 * is the declaration of its tag (6.7.3.4p11), attributes alone are an
 * attribute declaration, "[[deprecated]];", anything else is a declaration
 * of the specifiers alone: "int;", "const struct S;". A body after the
 * first declarator without an initializer makes the declaration a function
 * definition (6.9.1), whose statements are kept as text.
 */
Declaration @error("Syntax error, unexpected {token} in the declaration") -> {
    /**
     * @var list{
     *     Type\TypeInterface|null,
     *     Specifier\SpecifierList,
     *     ...<
     *         \Closure(
     *             Type\TypeInterface|null,
     *             Specifier\SpecifierList,
     *             int<0, max>,
     *             SpecifiedDeclaration\DeclaratorDeclaration\FunctionDefinition\FunctionBody|null=,
     *             Initializer\InitializerInterface|null=
     *         ): SpecifiedDeclaration\DeclaratorDeclaration
     *         |SpecifiedDeclaration\DeclaratorDeclaration\FunctionDefinition\FunctionBody
     *         |Initializer\InitializerInterface
     *     >
     * } $children
     */
    if (\count($children) === 2) {
        // The specifiers alone, without declarators
        if ($children[0] instanceof Type\RecordType || $children[0] instanceof Type\EnumType) {
            return new SpecifiedDeclaration\TagDeclaration($children[0], $children[1], $offset);
        }

        if ($children[0] === null) {
            $attributes = [];

            foreach ($children[1] as $specifier) {
                if ($specifier instanceof Attribute\AttributeInterface) {
                    $attributes[] = $specifier;
                }
            }

            if (\count($attributes) === \count($children[1])) {
                return new Declaration\AttributeDeclaration(
                    new Attribute\AttributeList($attributes, $children[1]->offset),
                    $offset,
                );
            }
        }

        return new SpecifiedDeclaration\TypeDeclaration($children[0], $children[1], $offset);
    }

    \assert($children[2] instanceof \Closure);

    if (($children[3] ?? null) instanceof SpecifiedDeclaration\DeclaratorDeclaration\FunctionDefinition\FunctionBody) {
        // The body follows the only declarator
        return $children[2]($children[0], $children[1], $offset, $children[3]);
    }

    $initializer = null;
    $first = 3;

    if (($children[3] ?? null) instanceof Initializer\InitializerInterface) {
        // The initializer of the first declarator
        $initializer = $children[3];
        $first = 4;
    }

    $declarations = [$children[2]($children[0], $children[1], $offset, null, $initializer)];

    for ($i = $first, $count = \count($children); $i < $count; ++$i) {
        \assert($children[$i] instanceof \Closure);

        $declarations[] = $children[$i]($children[0], $children[1], $offset);
    }

    return $declarations;
}
  : DeclarationSpecifiers() (
        DeclarationDeclarator() (
            FunctionBody()
          | (::T_ASSIGN:: Initializer())? (::T_COMMA:: InitDeclarator())* ::T_SEMICOLON::
        ) @error("Syntax error, unexpected {token} in the declaration, \";\" expected")
      | ::T_SEMICOLON::
    )
  ;

/**
 * A declarator of the list and its initializer
 */
InitDeclarator @error("Syntax error, unexpected {token} in the declarator") -> {
    /**
     * @var array{
     *     \Closure(
     *         Type\TypeInterface|null,
     *         Specifier\SpecifierList,
     *         int<0, max>,
     *         SpecifiedDeclaration\DeclaratorDeclaration\FunctionDefinition\FunctionBody|null=,
     *         Initializer\InitializerInterface|null=
     *     ): SpecifiedDeclaration\DeclaratorDeclaration,
     *     1?: Initializer\InitializerInterface
     * } $children
     */
    if (!isset($children[1])) {
        return $children[0];
    }

    return static function (
        ?Type\TypeInterface $type,
        Specifier\SpecifierList $specifiers,
        int $start,
    ) use ($children): SpecifiedDeclaration\DeclaratorDeclaration {
        \assert($start >= 0);

        return $children[0]($type, $specifiers, $start, null, $children[1]);
    };
}
  : DeclarationDeclarator() (::T_ASSIGN:: Initializer())?
  ;

/**
 * The declarator of a declaration is a function from the type and the
 * other specifiers of the declaration, its start, the body and the
 * initializer to the declared one. A body gives a function definition,
 * "typedef" among the specifiers a typedef name, a function type a
 * function, anything else an object, and each keeps the initializer, even
 * where C allows none. The attributes of GCC before the declarator (other
 * than the first one of the declaration, whose attributes go to the
 * specifiers) and after it, around the assembler label, belong to the
 * declared one.
 */
DeclarationDeclarator -> {
    /**
     * @var list<
     *     Attribute\AttributeInterface
     *     |Node\Identifier
     *     |\Closure(Type\TypeInterface|null): (Type\TypeInterface|null)
     *     |SpecifiedDeclaration\DeclaratorDeclaration\AsmLabel
     * > $children
     */
    $name = null;
    $declarator = null;
    $asmLabel = null;
    $attributes = [];

    for ($i = 0, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Node\Identifier) {
            $name = $children[$i];
        } elseif ($children[$i] instanceof \Closure) {
            $declarator = $children[$i];
        } elseif ($children[$i] instanceof Attribute\AttributeInterface) {
            $attributes[] = $children[$i];
        } else {
            $asmLabel = $children[$i];
        }
    }

    // A declarator gives its name and its function
    \assert($name !== null && $declarator !== null);

    $attributeList = $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset);

    return static function (
        ?Type\TypeInterface $type,
        Specifier\SpecifierList $specifiers,
        int $start,
        ?SpecifiedDeclaration\DeclaratorDeclaration\FunctionDefinition\FunctionBody $body = null,
        ?Initializer\InitializerInterface $initializer = null,
    ) use ($name, $declarator, $asmLabel, $attributeList): SpecifiedDeclaration\DeclaratorDeclaration {
        \assert($start >= 0);

        $type = $declarator($type);

        if ($body !== null) {
            return new SpecifiedDeclaration\DeclaratorDeclaration\FunctionDefinition(
                $type,
                $name,
                $body,
                $attributeList,
                $asmLabel,
                $initializer,
                $specifiers,
                $start,
            );
        }

        foreach ($specifiers as $specifier) {
            if ($specifier instanceof Specifier\StorageClassSpecifier\TypeDefSpecifier) {
                return new SpecifiedDeclaration\DeclaratorDeclaration\TypeDefDeclaration(
                    $type,
                    $name,
                    $attributeList,
                    $asmLabel,
                    $initializer,
                    $specifiers,
                    $start,
                );
            }
        }

        if ($type instanceof Type\FunctionType) {
            return new SpecifiedDeclaration\DeclaratorDeclaration\FunctionDeclaration(
                $type,
                $name,
                $attributeList,
                $asmLabel,
                $initializer,
                $specifiers,
                $start,
            );
        }

        return new SpecifiedDeclaration\DeclaratorDeclaration\VariableDeclaration(
            $type,
            $name,
            $attributeList,
            $asmLabel,
            $initializer,
            $specifiers,
            $start,
        );
    };
}
  : AttributeSpecifier()* Declarator() AttributeSpecifier()* (AsmLabel() AttributeSpecifier()*)?
  ;

/**
 * 6.9.1 The body of a function definition
 */
FunctionBody -> {
    /** @var array{non-empty-string} $children */
    return new SpecifiedDeclaration\DeclaratorDeclaration\FunctionDefinition\FunctionBody($children[0], $offset);
}
  : CompoundStatement()
  ;

/**
 * 6.8.3 A compound statement as text: any sequence of tokens with balanced
 * brackets in braces
 */
CompoundStatement -> {
    $raw = \substr($content, $offset, $length);
    // The statement holds at least its braces
    \assert($raw !== '');

    return $raw;
}
  : <T_LBRACE> (BalancedToken() | <T_COMMA>)*
    <T_RBRACE> @error("Syntax error, unexpected {token} in the compound statement, \"}\" expected")
  ;

/**
 * GCC: the name of the symbol in the object file, __asm__("_f"), also
 * spelled __asm
 */
AsmLabel -> {
    /** @var array{TokenInterface, Literal\StringLiteral|Expression\ConcatenatedStringExpression} $children */
    return new SpecifiedDeclaration\DeclaratorDeclaration\AsmLabel($children[1], $offset);
}
  : <T_ASM>
    ::T_LPAREN:: @error("Syntax error, unexpected {token} in the assembler label, \"(\" expected")
    ConcatenatedStringExpression() @error("Syntax error, unexpected {token} in the assembler label, a string literal expected")
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the assembler label, \")\" expected")
  ;

/**
 * -----------------------------------------------------------------------------
 *  6.7.11 Initialization
 * -----------------------------------------------------------------------------
 */

/**
 * A constant expression (6.7.11p4) or a list in braces
 */
Initializer @error("Syntax error, unexpected {token} in the initializer")
  : InitializerList()
  | ConditionalExpression()
  ;

/**
 * {}, {1, 2}, {1, 2,} and {.a = 1, [2] = {3}}. The brace marks the start of
 * the list.
 */
InitializerList -> {
    /**
     * @var list{
     *     TokenInterface,
     *     ...<Initializer\InitializerInterface|DesignatedInitializer>
     * } $children
     */
    $items = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $items[] = $children[$i];
    }

    return new Initializer\InitializerList($items, $offset);
}
  : <T_LBRACE>
        (InitializerListItem() (::T_COMMA:: InitializerListItem())* ::T_COMMA::?)?
    ::T_RBRACE:: @error("Syntax error, unexpected {token} in the initializer list, \",\" or \"}\" expected")
  ;

/**
 * An element of an initializer list, with or without designators
 */
InitializerListItem
  : DesignatedInitializer()
  | Initializer()
  ;

/**
 * .a = 1, [2] = 3 and .a[2].b = 4
 */
DesignatedInitializer -> {
    /**
     * @var array{
     *     DesignatedInitializer\DesignatorList,
     *     Initializer\InitializerInterface
     * } $children
     */
    return new DesignatedInitializer($children[0], $children[1], $offset);
}
  : DesignatorList()
    ::T_ASSIGN:: @error("Syntax error, unexpected {token} in the designated initializer, \"=\" expected")
    Initializer()
  ;

DesignatorList -> {
    /** @var non-empty-list<DesignatedInitializer\Designator> $children */
    return new DesignatedInitializer\DesignatorList($children, $offset);
}
  : Designator()+
  ;

Designator
  : MemberDesignator()
  | IndexDesignator()
  | RangeDesignator()
  ;

MemberDesignator -> {
    /** @var array{TokenInterface, Node\Identifier} $children */
    return new DesignatedInitializer\Designator\MemberDesignator($children[1], $offset);
}
  : <T_DOT> Identifier() @error("Syntax error, unexpected {token} in the designator, a member name expected")
  ;

/**
 * [2]
 */
IndexDesignator -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new DesignatedInitializer\Designator\IndexDesignator($children[1], $offset);
}
  : <T_LBRACKET> ConditionalExpression()
    ::T_RBRACKET:: @error("Syntax error, unexpected {token} in the designator, \"]\" or \"...\" expected")
  ;

/**
 * GCC: a range of elements, [0 ... 3]
 */
RangeDesignator -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface, Expression\ExpressionInterface} $children */
    return new DesignatedInitializer\Designator\RangeDesignator($children[1], $children[2], $offset);
}
  : <T_LBRACKET> ConditionalExpression() ::T_ELLIPSIS:: ConditionalExpression()
    ::T_RBRACKET:: @error("Syntax error, unexpected {token} in the designator, \"]\" expected")
  ;

/**
 * 6.7.12 Static assertions, static_assert(condition, "message"), the message
 * is optional
 */
StaticAssertDeclaration -> {
    /**
     * @var array{
     *     TokenInterface,
     *     Expression\ExpressionInterface,
     *     2?: Literal\StringLiteral|Expression\ConcatenatedStringExpression
     * } $children
     */
    return new Declaration\StaticAssertDeclaration($children[1], $children[2] ?? null, $offset);
}
  : <T_STATIC_ASSERT>
    ::T_LPAREN:: @error("Syntax error, unexpected {token} in the static assertion, \"(\" expected")
        ConditionalExpression()
        StaticAssertMessage()?
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the static assertion, \",\" or \")\" expected")
    ::T_SEMICOLON:: @error("Syntax error, unexpected {token} after the static assertion, \";\" expected")
  ;

/**
 * The comma and the message of a static assertion
 */
StaticAssertMessage
  : ::T_COMMA::
    ConcatenatedStringExpression() @error("Syntax error, unexpected {token} in the static assertion, a string literal expected")
  ;
