/**
 * -----------------------------------------------------------------------------
 *  Declaration specifiers, 6.7.1 to 6.7.6.
 * -----------------------------------------------------------------------------
 *
 *  The specifiers go in any order (6.7.3.1p2): the rules below collect
 *  them, the rule of a keyword gives its node or its case of an enum, and
 *  DeclarationSpecifiers or SpecifierQualifierList sorts them out. A
 *  keyword token marks the start of the specifiers.
 */

/**
 * 6.7.1 Declaration specifiers. An identifier is a typedef name only while no
 * other type specifier is written, after one it is a declarator: "T x",
 * "unsigned T". No more than one base is written, "int int" is a syntax
 * error, the modifiers of the base are not checked: "long char" gives a
 * syntax tree. The type specifiers and the qualifiers build the type, the
 * other specifiers go to a list in the order written, with the attributes
 * before the specifiers and after the last of them and the GCC attributes
 * anywhere among them. Both are passed to the
 * parent as two children: the type and the list, each null in case of
 * there is none.
 */
DeclarationSpecifiers -> {
    /**
     * @var (list<
     *     Type\TypeInterface
     *     |Type\ModifiedType\TypeModifier
     *     |Type\QualifiedType\TypeQualifier
     *     |Specifier\SpecifierInterface
     *     |Attribute\AttributeInterface
     * >) $children
     */
    $type = null;
    $modifiers = [];
    $qualifiers = [];
    $specifiers = [];

    foreach ($children as $child) {
        if ($child instanceof Type\ModifiedType\TypeModifier) {
            $modifiers[] = $child;
        } elseif ($child instanceof Type\QualifiedType\TypeQualifier) {
            $qualifiers[] = $child;
        } elseif ($child instanceof Specifier\SpecifierInterface || $child instanceof Attribute\AttributeInterface) {
            $specifiers[] = $child;
        } else {
            $type = $child;
        }
    }

    if ($modifiers !== []) {
        $type = new Type\ModifiedType($modifiers, $type, $offset);
    }

    if ($qualifiers !== []) {
        $type = new Type\QualifiedType($qualifiers, $type, $offset);
    }

    if ($specifiers === []) {
        return [$type, null];
    }

    return [$type, new Specifier\SpecifierList($specifiers, $specifiers[0]->offset)];
}
  : StandardAttributeSpecifier()* (
        (NonTypeSpecifier() | LeadingCallingConventions())+ TypeSpecifiers()?
      | TypeSpecifiers()
    )
    StandardAttributeSpecifier()*
  ;

/**
 * Clang and PHP FFI: the calling conventions before the type specifiers,
 * "__cdecl int f(void);", given to the declaration among its specifiers.
 * A keyword of a type specifier follows them, possibly after other
 * specifiers: before a name they are the start of the declarator. Requires
 * the LeadingCallingConventions feature.
 */
LeadingCallingConventions -> {
    /** @var non-empty-list<Attribute\AttributeInterface> $children */
    $this->assertFeature(Feature::LeadingCallingConventions, $source, $offset, $length);

    return $children;
}
  : CallingConvention()+ &LeadingCallingConventionsEnd()
  ;

LeadingCallingConventionsEnd
  : NonTypeSpecifier()* TypeSpecifierKeyword()
  ;

/**
 * The first token of a type specifier other than a typedef name
 */
TypeSpecifierKeyword
  : <T_VOID> | <T_CHAR> | <T_SHORT> | <T_INT> | <T_LONG> | <T_FLOAT> | <T_DOUBLE> | <T_SIGNED> | <T_UNSIGNED>
  | <T_BOOL> | <T_COMPLEX> | <T_IMAGINARY> | <T_BITINT> | <T_DECIMAL_NX> | <T_DECIMAL_N> | <T_FLOAT_NX>
  | <T_FLOAT_N> | <T_ATOMIC_SPECIFIER> | <T_STRUCT> | <T_UNION> | <T_ENUM> | <T_TYPEOF> | <T_TYPEOF_UNQUAL>
  ;

/**
 * A typedef name or type specifiers with at most one base, intermixed with
 * the other specifiers
 */
TypeSpecifiers
  : NamedType() (TypeModifier() | NonTypeSpecifier())*
  | TypeModifier() (TypeModifier() | NonTypeSpecifier())*
        ((BaseType() | ModifiedNamedType()) (TypeModifier() | NonTypeSpecifier())*)?
  | BaseType() (TypeModifier() | NonTypeSpecifier())*
  ;

/**
 * A typedef name after the modifiers, followed by a declarator, possibly
 * after other specifiers: "unsigned __int64 x", "unsigned T *p",
 * "unsigned __int64 __cdecl f(void)", "unsigned __int64 (*f)(void)".
 * Without a declarator after it the
 * name is the declarator: "unsigned T;", "unsigned T[3];". The modifiers of
 * a typedef name are checked by a validator.
 */
ModifiedNamedType
  : NamedType() &ModifiedNamedTypeEnd()
  ;

ModifiedNamedTypeEnd
  : NonTypeSpecifier()* (
        <T_IDENTIFIER> | <T_BUILTIN_CALL> | <T_ASTERISK> | <T_CARET> | <T_CALLING_CONVENTION> | NestedDeclaratorStart()
    )
  ;

/**
 * The start of a parenthesized declarator, which a parameter list cannot
 * have: "(*", "(^", "(__stdcall", "(__attribute__"
 */
NestedDeclaratorStart
  : <T_LPAREN> (<T_ASTERISK> | <T_CARET> | <T_CALLING_CONVENTION> | <T_GNU_ATTRIBUTE>)
  ;

/**
 * A specifier other than a type specifier
 */
NonTypeSpecifier
  : StorageClassSpecifier()
  | FunctionSpecifier()
  | SpecifierQualifier()
  ;

/**
 * 6.7.3.2 The specifier qualifier list of a member declaration and of a
 * type name: the declaration specifiers without the storage-class and the
 * function specifiers. The attributes before the specifiers belong to a
 * member declaration. Passed to the parent as the declaration specifiers
 * are.
 */
SpecifierQualifierList -> {
    /**
     * @var (list<
     *     Type\TypeInterface
     *     |Type\ModifiedType\TypeModifier
     *     |Type\QualifiedType\TypeQualifier
     *     |Specifier\SpecifierInterface
     *     |Attribute\AttributeInterface
     * >) $children
     */
    $type = null;
    $modifiers = [];
    $qualifiers = [];
    $specifiers = [];

    foreach ($children as $child) {
        if ($child instanceof Type\ModifiedType\TypeModifier) {
            $modifiers[] = $child;
        } elseif ($child instanceof Type\QualifiedType\TypeQualifier) {
            $qualifiers[] = $child;
        } elseif ($child instanceof Specifier\SpecifierInterface || $child instanceof Attribute\AttributeInterface) {
            $specifiers[] = $child;
        } else {
            $type = $child;
        }
    }

    if ($modifiers !== []) {
        $type = new Type\ModifiedType($modifiers, $type, $offset);
    }

    if ($qualifiers !== []) {
        $type = new Type\QualifiedType($qualifiers, $type, $offset);
    }

    if ($specifiers === []) {
        return [$type, null];
    }

    return [$type, new Specifier\SpecifierList($specifiers, $specifiers[0]->offset)];
}
  : StandardAttributeSpecifier()* (SpecifierQualifier()+ QualifiedTypeSpecifiers()? | QualifiedTypeSpecifiers())
    StandardAttributeSpecifier()*
  ;

/**
 * A typedef name or type specifiers with at most one base, intermixed with
 * the qualifiers and the alignment specifiers
 */
QualifiedTypeSpecifiers
  : NamedType() (TypeModifier() | SpecifierQualifier())*
  | TypeModifier() (TypeModifier() | SpecifierQualifier())*
        ((BaseType() | QualifiedModifiedNamedType()) (TypeModifier() | SpecifierQualifier())*)?
  | BaseType() (TypeModifier() | SpecifierQualifier())*
  ;

/**
 * A typedef name after the modifiers in a specifier qualifier list,
 * followed by a declarator or ending a type name: "unsigned __int64 c : 3",
 * "(unsigned __int64)x"
 */
QualifiedModifiedNamedType
  : NamedType() &QualifiedModifiedNamedTypeEnd()
  ;

QualifiedModifiedNamedTypeEnd
  : SpecifierQualifier()* (
        <T_IDENTIFIER> | <T_ASTERISK> | <T_CARET> | <T_CALLING_CONVENTION> | <T_RPAREN> | NestedDeclaratorStart()
    )
  ;

/**
 * A type qualifier or an alignment specifier, the specifiers other than
 * the type specifiers that a specifier qualifier list allows, and the GCC
 * and MSVC attributes, the MSVC modifiers of a pointer and the Clang
 * nullability and signing of a pointer, which go anywhere among the
 * specifiers
 */
SpecifierQualifier
  : TypeQualifier()
  | AlignmentSpecifier()
  | GnuAttributeSpecifier()
  | DeclSpecAttributeSpecifier()
  | PointerModifier()
  | BasedPointerModifier()
  | Nullability()
  | PointerAuth()
  ;

/**
 * 6.7.8 The specifier qualifier list of a type name, and of the underlying
 * type of an enumeration, which has no declarator and no attributes before
 * the specifiers. The alignment specifiers and the attributes are kept by a
 * SpecifiedType around the type of the specifiers.
 */
TypeNameSpecifiers -> {
    /** @var array{Type\TypeInterface|null, Specifier\SpecifierList|null} $children */
    if ($children[1] === null) {
        // Without the other specifiers at least one type specifier or
        // qualifier is written
        \assert($children[0] !== null);

        return $children[0];
    }

    return new Type\SpecifiedType($children[0], $children[1], $offset);
}
  : !AttributeSpecifierStart() SpecifierQualifierList()
  ;

AttributeSpecifierStart
  : <T_ATTRIBUTE_START>
  ;

/**
 * -----------------------------------------------------------------------------
 *  6.7.2 Storage-class specifiers
 * -----------------------------------------------------------------------------
 */

StorageClassSpecifier
  : TypeDefSpecifier()
  | ExternSpecifier()
  | StaticSpecifier()
  | ThreadLocalSpecifier()
  | AutoSpecifier()
  | RegisterSpecifier()
  | ConstExprSpecifier()
  ;

TypeDefSpecifier -> { return new Specifier\StorageClassSpecifier\TypeDefSpecifier($offset); }
  : <T_TYPEDEF>
  ;

ExternSpecifier -> { return new Specifier\StorageClassSpecifier\ExternSpecifier($offset); }
  : <T_EXTERN>
  ;

StaticSpecifier -> { return new Specifier\StorageClassSpecifier\StaticSpecifier($offset); }
  : <T_STATIC>
  ;

ThreadLocalSpecifier -> {
    /** @var TokenInterface $children */
    $this->assertKeywordSpelling($source, $children);

    return new Specifier\StorageClassSpecifier\ThreadLocalSpecifier($offset);
}
  : <T_THREAD_LOCAL>
  ;

AutoSpecifier -> { return new Specifier\StorageClassSpecifier\AutoSpecifier($offset); }
  : <T_AUTO>
  ;

RegisterSpecifier -> { return new Specifier\StorageClassSpecifier\RegisterSpecifier($offset); }
  : <T_REGISTER>
  ;

ConstExprSpecifier -> { return new Specifier\StorageClassSpecifier\ConstExprSpecifier($offset); }
  : <T_CONSTEXPR>
  ;

/**
 * -----------------------------------------------------------------------------
 *  6.7.3.1 Type specifiers: the modifiers of the base
 * -----------------------------------------------------------------------------
 */

TypeModifier
  : SignedModifier()
  | UnsignedModifier()
  | ShortModifier()
  | LongModifier()
  | ComplexModifier()
  | ImaginaryModifier()
  ;

SignedModifier -> {
    /** @var TokenInterface $children */
    $this->assertKeywordSpelling($source, $children);

    return Type\ModifiedType\TypeModifier::Signed;
}
  : <T_SIGNED>
  ;

UnsignedModifier -> { return Type\ModifiedType\TypeModifier::Unsigned; }
  : <T_UNSIGNED>
  ;

ShortModifier -> { return Type\ModifiedType\TypeModifier::Short; }
  : <T_SHORT>
  ;

LongModifier -> { return Type\ModifiedType\TypeModifier::Long; }
  : <T_LONG>
  ;

ComplexModifier -> {
    /** @var TokenInterface $children */
    $this->assertKeywordSpelling($source, $children);

    return Type\ModifiedType\TypeModifier::Complex;
}
  : <T_COMPLEX>
  ;

ImaginaryModifier -> { return Type\ModifiedType\TypeModifier::Imaginary; }
  : <T_IMAGINARY>
  ;

/**
 * -----------------------------------------------------------------------------
 *  6.7.3 Type specifiers: the base
 * -----------------------------------------------------------------------------
 */

BaseType
  : VoidType()
  | CharType()
  | IntType()
  | FloatType()
  | DoubleType()
  | BoolType()
  | DecimalNType()
  | DecimalNxType()
  | FloatNType()
  | FloatNxType()
  | BitIntType()
  | AtomicType()
  | StructType()
  | UnionType()
  | EnumType()
  | TypeOfTypeType()
  | TypeOfType()
  | TypeOfUnqualTypeType()
  | TypeOfUnqualType()
  ;

VoidType -> { return new Type\BuiltinType\VoidType($offset); }
  : <T_VOID>
  ;

CharType -> { return new Type\BuiltinType\CharType($offset); }
  : <T_CHAR>
  ;

IntType -> { return new Type\BuiltinType\IntType($offset); }
  : <T_INT>
  ;

FloatType -> { return new Type\BuiltinType\FloatType($offset); }
  : <T_FLOAT>
  ;

DoubleType -> { return new Type\BuiltinType\DoubleType($offset); }
  : <T_DOUBLE>
  ;

BoolType -> { return new Type\BuiltinType\BoolType($offset); }
  : <T_BOOL>
  ;

/**
 * 6.7.3.1 and Annex H.7: the width N of the type is the digits of its
 * keyword, 32 in _Decimal32
 */
DecimalNType -> {
    /** @var TokenInterface $children */
    /** @var int<1, max> $width */
    $width = (int) \substr($children->value, \strlen('_Decimal'));

    return new Type\BuiltinType\DecimalNType($width, $offset);
}
  : <T_DECIMAL_N>
  ;

DecimalNxType -> {
    /** @var TokenInterface $children */
    /** @var int<1, max> $width */
    $width = (int) \substr($children->value, \strlen('_Decimal'));

    return new Type\BuiltinType\DecimalNxType($width, $offset);
}
  : <T_DECIMAL_NX>
  ;

FloatNType -> {
    /** @var TokenInterface $children */
    /** @var int<1, max> $width */
    $width = (int) \substr($children->value, \strlen('_Float'));

    return new Type\BuiltinType\FloatNType($width, $offset);
}
  : <T_FLOAT_N>
  ;

FloatNxType -> {
    /** @var TokenInterface $children */
    /** @var int<1, max> $width */
    $width = (int) \substr($children->value, \strlen('_Float'));

    return new Type\BuiltinType\FloatNxType($width, $offset);
}
  : <T_FLOAT_NX>
  ;

BitIntType -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new Type\BuiltinType\BitIntType($children[1], $offset);
}
  : <T_BITINT>
    ::T_LPAREN:: @error("Syntax error, unexpected {token} in the bit-precise integer type, \"(\" expected")
    ConditionalExpression()
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the bit-precise integer type, \")\" expected")
  ;

/**
 * 6.7.3.5 Atomic type specifiers, _Atomic(T)
 */
AtomicType -> {
    /** @var array{TokenInterface, Type\TypeInterface} $children */
    return new Type\AtomicType($children[1], $offset);
}
  : <T_ATOMIC_SPECIFIER> ::T_LPAREN::
    TypeName() @error("Syntax error, unexpected {token} in the atomic type specifier, a type name expected")
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the atomic type specifier, \")\" expected")
  ;

/**
 * A typedef name, of an unknown kind of type. A name before "=" is a
 * declarator: "auto x = 1;" and "constexpr auto n = 1;" infer the type
 * (6.7.10), "static x = 1;" has no type specifier.
 */
NamedType -> {
    /** @var array{TokenInterface} $children */
    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    return new Type\NamedType(new Node\Identifier($children[0]->value, $offset), $offset);
}
  : (<T_IDENTIFIER> | <T_BUILTIN_CALL>) !InitializerStart()
  ;

InitializerStart
  : <T_ASSIGN>
  ;

/**
 * -----------------------------------------------------------------------------
 *  6.7.3.2 Structure and union specifiers
 * -----------------------------------------------------------------------------
 */

StructType -> {
    /**
     * @var array{
     *     TokenInterface,
     *     Node\Identifier|null,
     *     Type\RecordType\MemberDeclarationList|null,
     *     Attribute\AttributeList|null
     * } $children
     */
    return new Type\RecordType\StructType($children[1], $children[2], $children[3], $offset);
}
  : <T_STRUCT>
    RecordTypeContents() @error("Syntax error, unexpected {token} in the structure specifier, a tag or \"{{\" expected")
  ;

UnionType -> {
    /**
     * @var array{
     *     TokenInterface,
     *     Node\Identifier|null,
     *     Type\RecordType\MemberDeclarationList|null,
     *     Attribute\AttributeList|null
     * } $children
     */
    return new Type\RecordType\UnionType($children[1], $children[2], $children[3], $offset);
}
  : <T_UNION>
    RecordTypeContents() @error("Syntax error, unexpected {token} in the union specifier, a tag or \"{{\" expected")
  ;

/**
 * What follows "struct" or "union": a tag, a body or both, with the
 * attributes after the keyword (the MSVC ones and the calling conventions
 * of PHP FFI included) and the GCC attributes after the body, in the order
 * written. Passed to the parent as three children:
 * the tag, the members and the attributes, each null in case of none is
 * written.
 */
RecordTypeContents -> {
    /** @var list<Attribute\AttributeInterface|Node\Identifier|Type\RecordType\MemberDeclarationList> $children */
    $name = null;
    $members = null;
    $attributes = [];

    for ($i = 0, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Node\Identifier) {
            $name = $children[$i];
        } elseif ($children[$i] instanceof Type\RecordType\MemberDeclarationList) {
            $members = $children[$i];
        } else {
            $attributes[] = $children[$i];
        }
    }

    return [
        $name,
        $members,
        $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset),
    ];
}
  : (AttributeSpecifier() | DeclSpecAttributeSpecifier() | TagCallingConventions())*
    (DeclaredIdentifier() RecordBody()? | RecordBody())
  ;

/**
 * The members and the GCC attributes after them, which belong to the
 * structure or union
 */
RecordBody
  : MemberDeclarationList() GnuAttributeSpecifier()*
  ;

/**
 * The members in braces, at least one. The brace marks the start of the
 * list. GCC: no members at all, "struct S {};", requires the EmptyRecords
 * feature.
 */
MemberDeclarationList -> {
    /**
     * @var list{
     *     TokenInterface,
     *     ...<Type\RecordType\MemberDeclaration|Declaration\StaticAssertDeclaration>
     * } $children
     */
    if (!isset($children[1])) {
        $this->assertFeature(Feature::EmptyRecords, $source, $children[0]->offset, $children[0]->size);
    }

    $members = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $members[] = $children[$i];
    }

    return new Type\RecordType\MemberDeclarationList($members, $members[0]->offset ?? $offset);
}
  : <T_LBRACE> RecordMember()* LastMemberDeclarations()?
    ::T_RBRACE:: @error("Syntax error, unexpected {token} in the members, \"}\" expected")
  ;

/**
 * A member declaration or a static assertion
 */
RecordMember
  : ExtensionKeyword()* (
        MemberDeclarations()
        ::T_SEMICOLON:: @error("Syntax error, unexpected {token} in the member declaration, \";\" expected")
      | StaticAssertDeclaration()
      | ExtraSemicolon()
    )
  ;

/**
 * PHP FFI: the last member declaration without its semicolon,
 * "struct S { int a };". Requires the OptionalLastMemberSemicolon feature.
 */
LastMemberDeclarations -> {
    /** @var non-empty-list<Type\RecordType\MemberDeclaration> $children */
    $this->assertFeature(Feature::OptionalLastMemberSemicolon, $source, $offset, $length);

    return $children;
}
  : ExtensionKeyword()* MemberDeclarations()
  ;

/**
 * A member declaration gives a node for each of its declarators, and a
 * single node without a name when it has none: an anonymous structure or
 * union, "struct { int a; };".
 */
MemberDeclarations -> {
    /**
     * @var list{
     *     Type\TypeInterface|null,
     *     Specifier\SpecifierList|null,
     *     ...<\Closure(
     *         Type\TypeInterface|null,
     *         Specifier\SpecifierList|null,
     *         int<0, max>
     *     ): Type\RecordType\MemberDeclaration>
     * } $children
     */
    if (\count($children) === 2) {
        return new Type\RecordType\MemberDeclaration($children[0], specifiers: $children[1], offset: $offset);
    }

    $members = [];

    for ($i = 2, $count = \count($children); $i < $count; ++$i) {
        $members[] = $children[$i]($children[0], $children[1], $offset);
    }

    return $members;
}
  : SpecifierQualifierList() (MemberDeclarator() (::T_COMMA:: MemberDeclarator())*)?
  ;

/**
 * The declarator of a member is a function from the type and the other
 * specifiers of the member declaration and its start to the declared one
 */
MemberDeclarator
  : NamedMemberDeclarator()
  | UnnamedBitFieldDeclarator()
  ;

/**
 * A declarator with the attributes after its name and the width of a
 * bit-field, and the GCC attributes before the declarator and after it
 */
NamedMemberDeclarator -> {
    /**
     * @var list<
     *     Attribute\AttributeInterface
     *     |Node\Identifier
     *     |\Closure(Type\TypeInterface|null): (Type\TypeInterface|null)
     *     |Expression\ExpressionInterface
     * > $children
     */
    $name = null;
    $declarator = null;
    $width = null;
    $attributes = [];

    for ($i = 0, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Node\Identifier) {
            $name = $children[$i];
        } elseif ($children[$i] instanceof \Closure) {
            $declarator = $children[$i];
        } elseif ($children[$i] instanceof Attribute\AttributeInterface) {
            $attributes[] = $children[$i];
        } else {
            $width = $children[$i];
        }
    }

    // A declarator gives its name and its function
    \assert($name !== null && $declarator !== null);

    return static function (
        ?Type\TypeInterface $type,
        ?Specifier\SpecifierList $specifiers,
        int $start,
    ) use ($declarator, $name, $width, $attributes): Type\RecordType\MemberDeclaration {
        \assert($start >= 0);

        return new Type\RecordType\MemberDeclaration(
            $declarator($type),
            $name,
            $width,
            $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset),
            $specifiers,
            $start,
        );
    };
}
  : GnuAttributeSpecifier()* Declarator() (::T_COLON:: ConditionalExpression())? GnuAttributeSpecifier()*
  ;

/**
 * The width of a bit-field without a name and the GCC attributes after it
 */
UnnamedBitFieldDeclarator -> {
    /** @var list{Expression\ExpressionInterface, ...<Attribute\AttributeInterface>} $children */
    $attributes = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $attributes[] = $children[$i];
    }

    $attributeList = $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset);

    return static function (
        ?Type\TypeInterface $type,
        ?Specifier\SpecifierList $specifiers,
        int $start,
    ) use ($children, $attributeList): Type\RecordType\MemberDeclaration {
        \assert($start >= 0);

        return new Type\RecordType\MemberDeclaration($type, null, $children[0], $attributeList, $specifiers, $start);
    };
}
  : ::T_COLON:: ConditionalExpression() GnuAttributeSpecifier()*
  ;

/**
 * -----------------------------------------------------------------------------
 *  6.7.3.3 Enumeration specifiers
 * -----------------------------------------------------------------------------
 */

/**
 * An enumeration with a tag (a reference to it, its declaration with the
 * underlying type only, "enum E : int;", or its definition) or an anonymous
 * one, with the attributes after the keyword of a definition. The GCC and
 * MSVC attributes and the calling conventions of PHP FFI go after the
 * keyword of a reference as well: "enum __attribute__((packed)) E;".
 */
EnumType -> {
    /**
     * @var list{
     *     TokenInterface,
     *     ...<Attribute\AttributeInterface|Node\Identifier|Type\TypeInterface|Type\EnumType\EnumeratorList>
     * } $children
     */
    $name = null;
    $underlyingType = null;
    $enumerators = null;
    $attributes = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Node\Identifier) {
            $name = $children[$i];
        } elseif ($children[$i] instanceof Type\EnumType\EnumeratorList) {
            $enumerators = $children[$i];
        } elseif ($children[$i] instanceof Attribute\AttributeInterface) {
            $attributes[] = $children[$i];
        } else {
            $underlyingType = $children[$i];
        }
    }

    return new Type\EnumType(
        $name,
        $underlyingType,
        $enumerators,
        $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset),
        $offset,
    );
}
  : <T_ENUM> (
        DeclaredIdentifier() EnumUnderlyingType()? EnumBody()?
      | (AttributeSpecifier() | DeclSpecAttributeSpecifier() | TagCallingConventions())+
            DeclaredIdentifier()? EnumUnderlyingType()? EnumBody()
      | (GnuAttributeSpecifier() | DeclSpecAttributeSpecifier() | TagCallingConventions())+
            DeclaredIdentifier() EnumUnderlyingType()?
      | EnumUnderlyingType()? EnumBody()
    ) @error("Syntax error, unexpected {token} in the enumeration specifier, a tag, \":\" or \"{{\" expected")
  ;

EnumUnderlyingType
  : ::T_COLON::
    TypeNameSpecifiers() @error("Syntax error, unexpected {token} in the enumeration specifier, an underlying type expected")
  ;

/**
 * The enumerators in braces and the GCC attributes after them, which belong
 * to the enumeration
 */
EnumBody
  : EnumeratorList() GnuAttributeSpecifier()*
  ;

/**
 * The enumerators in braces, at least one, a trailing comma is allowed.
 * The first enumerator marks the start of the list, the brace of an empty
 * one. Clang with the Microsoft extensions: no enumerators at all,
 * "enum E {};", requires the EmptyEnums feature.
 */
EnumeratorList -> {
    /** @var list{TokenInterface, ...<Type\EnumType\Enumerator>} $children */
    if (!isset($children[1])) {
        $this->assertFeature(Feature::EmptyEnums, $source, $children[0]->offset, $children[0]->size);
    }

    $enumerators = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $enumerators[] = $children[$i];
    }

    return new Type\EnumType\EnumeratorList($enumerators, $enumerators[0]->offset ?? $offset);
}
  : <T_LBRACE> (
        Enumerator() (::T_COMMA:: Enumerator())* ::T_COMMA::?
        ::T_RBRACE:: @error("Syntax error, unexpected {token} in the enumerators, \",\" or \"}\" expected")
      | ::T_RBRACE::
    ) @error("Syntax error, unexpected {token} in the enumerators, an enumerator or \"}\" expected")
  ;

/**
 * A name, the attributes after it and the value: A [[deprecated]] = 1
 */
Enumerator -> {
    /** @var list{Node\Identifier, ...<Attribute\AttributeInterface|Expression\ExpressionInterface>} $children */
    $value = null;
    $attributes = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Attribute\AttributeInterface) {
            $attributes[] = $children[$i];
        } else {
            $value = $children[$i];
        }
    }

    return new Type\EnumType\Enumerator(
        $children[0],
        $value,
        $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset),
        $offset,
    );
}
  : DeclaredIdentifier() AttributeSpecifier()* (::T_ASSIGN:: ConditionalExpression())?
  ;

/**
 * -----------------------------------------------------------------------------
 *  6.7.3.6 Typeof specifiers
 * -----------------------------------------------------------------------------
 *
 *  Whether the operand is a type name or an expression is the class of the
 *  node, as in sizeof. A lone identifier in the parentheses is read as a
 *  type name.
 */

TypeOfTypeType -> {
    /** @var array{TokenInterface, Type\TypeInterface} $children */
    $this->assertKeywordSpelling($source, $children[0]);

    return new Type\TypeOfTypeType($children[1], $offset);
}
  : <T_TYPEOF> ::T_LPAREN:: !ExpressionLikeTypeName()
    TypeName() @error("Syntax error, unexpected {token} in the typeof specifier, a type name or an expression expected")
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the typeof specifier, \")\" expected")
  ;

TypeOfType -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    $this->assertKeywordSpelling($source, $children[0]);

    return new Type\TypeOfType($children[1], $offset);
}
  : <T_TYPEOF>
    ::T_LPAREN:: @error("Syntax error, unexpected {token} in the typeof specifier, \"(\" expected")
    Expression()
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the typeof specifier, \")\" expected")
  ;

TypeOfUnqualTypeType -> {
    /** @var array{TokenInterface, Type\TypeInterface} $children */
    $this->assertKeywordSpelling($source, $children[0]);

    return new Type\TypeOfUnqualTypeType($children[1], $offset);
}
  : <T_TYPEOF_UNQUAL> ::T_LPAREN:: !ExpressionLikeTypeName()
    TypeName() @error("Syntax error, unexpected {token} in the typeof_unqual specifier, a type name or an expression expected")
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the typeof_unqual specifier, \")\" expected")
  ;

TypeOfUnqualType -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    $this->assertKeywordSpelling($source, $children[0]);

    return new Type\TypeOfUnqualType($children[1], $offset);
}
  : <T_TYPEOF_UNQUAL>
    ::T_LPAREN:: @error("Syntax error, unexpected {token} in the typeof_unqual specifier, \"(\" expected")
    Expression()
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the typeof_unqual specifier, \")\" expected")
  ;

/**
 * -----------------------------------------------------------------------------
 *  6.7.4 Type qualifiers
 * -----------------------------------------------------------------------------
 */

TypeQualifier
  : ConstQualifier()
  | VolatileQualifier()
  | RestrictQualifier()
  | AtomicQualifier()
  ;

ConstQualifier -> {
    /** @var TokenInterface $children */
    $this->assertKeywordSpelling($source, $children);

    return Type\QualifiedType\TypeQualifier::Const;
}
  : <T_CONST>
  ;

VolatileQualifier -> {
    /** @var TokenInterface $children */
    $this->assertKeywordSpelling($source, $children);

    return Type\QualifiedType\TypeQualifier::Volatile;
}
  : <T_VOLATILE>
  ;

RestrictQualifier -> {
    /** @var TokenInterface $children */
    $this->assertKeywordSpelling($source, $children);

    return Type\QualifiedType\TypeQualifier::Restrict;
}
  : <T_RESTRICT>
  ;

AtomicQualifier -> { return Type\QualifiedType\TypeQualifier::Atomic; }
  : <T_ATOMIC>
  ;

/**
 * -----------------------------------------------------------------------------
 *  6.7.5 Function specifiers
 * -----------------------------------------------------------------------------
 */

FunctionSpecifier
  : InlineSpecifier()
  | NoReturnSpecifier()
  | ForceInlineSpecifier()
  ;

InlineSpecifier -> {
    /** @var TokenInterface $children */
    $this->assertKeywordSpelling($source, $children);

    return new Specifier\FunctionSpecifier\InlineSpecifier($offset);
}
  : <T_INLINE>
  ;

NoReturnSpecifier -> { return new Specifier\FunctionSpecifier\NoReturnSpecifier($offset); }
  : <T_NORETURN>
  ;

/**
 * MSVC: __forceinline. Requires the ForceInline feature.
 */
ForceInlineSpecifier -> {
    /** @var TokenInterface $children */
    $this->assertFeature(Feature::ForceInline, $source, $children->offset, $children->size);

    return new Specifier\FunctionSpecifier\ForceInlineSpecifier($offset);
}
  : <T_FORCE_INLINE>
  ;

/**
 * -----------------------------------------------------------------------------
 *  6.7.6 Alignment specifier
 * -----------------------------------------------------------------------------
 */

AlignmentSpecifier
  : AlignAsTypeSpecifier()
  | AlignAsSpecifier()
  ;

AlignAsTypeSpecifier -> {
    /** @var array{TokenInterface, Type\TypeInterface} $children */
    return new Specifier\AlignmentSpecifier\AlignAsTypeSpecifier($children[1], $offset);
}
  : <T_ALIGNAS> ::T_LPAREN:: !ExpressionLikeTypeName()
    TypeName() @error("Syntax error, unexpected {token} in the alignment specifier, a type name or an expression expected")
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the alignment specifier, \")\" expected")
  ;

AlignAsSpecifier -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new Specifier\AlignmentSpecifier\AlignAsSpecifier($children[1], $offset);
}
  : <T_ALIGNAS>
    ::T_LPAREN:: @error("Syntax error, unexpected {token} in the alignment specifier, \"(\" expected")
    ConditionalExpression()
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the alignment specifier, \")\" expected")
  ;
