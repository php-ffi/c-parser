//
// Declaration specifiers, 6.7.1 to 6.7.6.
//
// The specifiers go in any order (6.7.3.1p2), so the rules below only
// collect them: the rule of a keyword gives its node or its case of an enum,
// and DeclarationSpecifiers sorts them out. A keyword is kept as a token, so
// that the specifiers start where it is written.
//

// 6.7.1 Declaration specifiers. An identifier is a typedef name only while no
// other type specifier is written, otherwise it is a declarator: "T x",
// "unsigned T". No more than one base is written, "int int" is a syntax
// error, the modifiers of the base are not checked: "long char" gives a
// syntax tree. The type specifiers and the qualifiers build the type, the
// other specifiers go to a list in the order written. Both are passed to
// the parent as two children: the type, null in case of there is none, and
// the list.
DeclarationSpecifiers -> {
    /**
     * @var (list<
     *     Type\TypeInterface
     *     |Type\ModifiedType\TypeModifier
     *     |Type\QualifiedType\TypeQualifier
     *     |Specifier\SpecifierInterface
     *     |Attribute\AttributeInterface
     * >) $children
     */
    $type = null;
    $modifiers = [];
    $qualifiers = [];
    $specifiers = [];

    foreach ($children as $child) {
        if ($child instanceof Type\ModifiedType\TypeModifier) {
            $modifiers[] = $child;
        } elseif ($child instanceof Type\QualifiedType\TypeQualifier) {
            $qualifiers[] = $child;
        } elseif ($child instanceof Specifier\SpecifierInterface || $child instanceof Attribute\AttributeInterface) {
            $specifiers[] = $child;
        } else {
            $type = $child;
        }
    }

    if ($modifiers !== []) {
        $type = new Type\ModifiedType($modifiers, $type, $offset);
    }

    if ($qualifiers !== []) {
        $type = new Type\QualifiedType($qualifiers, $type, $offset);
    }

    return [$type, new Specifier\SpecifierList($specifiers, $specifiers[0]->offset ?? $offset)];
}
  : NonTypeSpecifier()+ TypeSpecifiers()?
  | TypeSpecifiers()
  ;

// A typedef name or type specifiers with at most one base, intermixed with
// the other specifiers. The alternatives here and in DeclarationSpecifiers
// start with different tokens, so that none of them parses the specifiers
// written before it once again.
TypeSpecifiers
  : NamedType() ((TypeModifier() | NonTypeSpecifier())+)?
  | TypeModifier() ((TypeModifier() | NonTypeSpecifier())+)? (BaseType() ((TypeModifier() | NonTypeSpecifier())+)?)?
  | BaseType() ((TypeModifier() | NonTypeSpecifier())+)?
  ;

// The attributes are not specifiers in C, which allows them only before
// all the specifiers and after them (6.7.1), but GCC allows them anywhere
// among the specifiers, and the parser keeps them along with the
// specifiers in the order written
NonTypeSpecifier
  : StorageClassSpecifier()
  | FunctionSpecifier()
  | TypeQualifier()
  | AlignmentSpecifier()
  | AttributeSpecifier()
  ;

// 6.7.8 The specifiers of a type name, and of the underlying type of an
// enumeration, which has no declarator. C allows only type specifiers,
// qualifiers and, in a compound literal, alignment specifiers in a type
// name (6.7.6), and no storage-class or function specifier in a member
// declaration either (6.7.3.2), but the parser accepts any specifier
// everywhere, as Clang's parser does: the other specifiers of a type name are kept
// by a SpecifiedType around the type of the specifiers, and the ones of a
// member by the member itself.
TypeNameSpecifiers -> {
    /** @var array{Type\TypeInterface|null, Specifier\SpecifierList} $children */
    if ($children[1]->items === []) {
        // Without the other specifiers at least one type specifier or
        // qualifier is written
        \assert($children[0] !== null);

        return $children[0];
    }

    return new Type\SpecifiedType($children[0], $children[1], $offset);
}
  : DeclarationSpecifiers()
  ;

//
// 6.7.2 Storage-class specifiers
//

StorageClassSpecifier
  : TypeDefSpecifier()
  | ExternSpecifier()
  | StaticSpecifier()
  | ThreadLocalSpecifier()
  | AutoSpecifier()
  | RegisterSpecifier()
  | ConstExprSpecifier()
  ;

TypeDefSpecifier -> { return new Specifier\StorageClassSpecifier\TypeDefSpecifier($offset); }
  : <T_TYPEDEF>
  ;

ExternSpecifier -> { return new Specifier\StorageClassSpecifier\ExternSpecifier($offset); }
  : <T_EXTERN>
  ;

StaticSpecifier -> { return new Specifier\StorageClassSpecifier\StaticSpecifier($offset); }
  : <T_STATIC>
  ;

ThreadLocalSpecifier -> { return new Specifier\StorageClassSpecifier\ThreadLocalSpecifier($offset); }
  : <T_THREAD_LOCAL>
  ;

AutoSpecifier -> { return new Specifier\StorageClassSpecifier\AutoSpecifier($offset); }
  : <T_AUTO>
  ;

RegisterSpecifier -> { return new Specifier\StorageClassSpecifier\RegisterSpecifier($offset); }
  : <T_REGISTER>
  ;

ConstExprSpecifier -> { return new Specifier\StorageClassSpecifier\ConstExprSpecifier($offset); }
  : <T_CONSTEXPR>
  ;

//
// 6.7.3.1 Type specifiers: the modifiers of the base
//

TypeModifier
  : SignedModifier()
  | UnsignedModifier()
  | ShortModifier()
  | LongModifier()
  | ComplexModifier()
  | ImaginaryModifier()
  ;

SignedModifier -> { return Type\ModifiedType\TypeModifier::Signed; }
  : <T_SIGNED>
  ;

UnsignedModifier -> { return Type\ModifiedType\TypeModifier::Unsigned; }
  : <T_UNSIGNED>
  ;

ShortModifier -> { return Type\ModifiedType\TypeModifier::Short; }
  : <T_SHORT>
  ;

LongModifier -> { return Type\ModifiedType\TypeModifier::Long; }
  : <T_LONG>
  ;

ComplexModifier -> { return Type\ModifiedType\TypeModifier::Complex; }
  : <T_COMPLEX>
  ;

ImaginaryModifier -> { return Type\ModifiedType\TypeModifier::Imaginary; }
  : <T_IMAGINARY>
  ;

//
// 6.7.3 Type specifiers: the base
//

BaseType
  : VoidType()
  | CharType()
  | IntType()
  | FloatType()
  | DoubleType()
  | BoolType()
  | Decimal32Type()
  | Decimal64Type()
  | Decimal128Type()
  | BitIntType()
  | Int8Type()
  | Int16Type()
  | Int32Type()
  | Int64Type()
  | Int128Type()
  | AtomicType()
  | StructType()
  | UnionType()
  | EnumType()
  | TypeOfTypeType()
  | TypeOfType()
  | TypeOfUnqualTypeType()
  | TypeOfUnqualType()
  ;

VoidType -> { return new Type\BuiltinType\VoidType($offset); }
  : <T_VOID>
  ;

CharType -> { return new Type\BuiltinType\CharType($offset); }
  : <T_CHAR>
  ;

IntType -> { return new Type\BuiltinType\IntType($offset); }
  : <T_INT>
  ;

FloatType -> { return new Type\BuiltinType\FloatType($offset); }
  : <T_FLOAT>
  ;

DoubleType -> { return new Type\BuiltinType\DoubleType($offset); }
  : <T_DOUBLE>
  ;

BoolType -> { return new Type\BuiltinType\BoolType($offset); }
  : <T_BOOL>
  ;

Decimal32Type -> { return new Type\BuiltinType\Decimal32Type($offset); }
  : <T_DECIMAL32>
  ;

Decimal64Type -> { return new Type\BuiltinType\Decimal64Type($offset); }
  : <T_DECIMAL64>
  ;

Decimal128Type -> { return new Type\BuiltinType\Decimal128Type($offset); }
  : <T_DECIMAL128>
  ;

BitIntType -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new Type\BuiltinType\BitIntType($children[1], $offset);
}
  : <T_BITINT> ::T_LPAREN:: ConditionalExpression() ::T_RPAREN::
  ;

// The integer types of MSVC
Int8Type -> { return new Type\BuiltinType\Int8Type($offset); }
  : <T_INT8>
  ;

Int16Type -> { return new Type\BuiltinType\Int16Type($offset); }
  : <T_INT16>
  ;

Int32Type -> { return new Type\BuiltinType\Int32Type($offset); }
  : <T_INT32>
  ;

Int64Type -> { return new Type\BuiltinType\Int64Type($offset); }
  : <T_INT64>
  ;

// The 128-bit integer type of GCC
Int128Type -> { return new Type\BuiltinType\Int128Type($offset); }
  : <T_INT128>
  ;

// 6.7.3.5 Atomic type specifiers, _Atomic(T)
AtomicType -> {
    /** @var array{TokenInterface, Type\TypeInterface} $children */
    return new Type\AtomicType($children[1], $offset);
}
  : <T_ATOMIC> ::T_LPAREN:: TypeName() ::T_RPAREN::
  ;

// A typedef name, the parser has no table of the declared names to tell what
// kind of type it is. A name before "=" is the declarator of a declaration
// whose type is inferred (6.7.10), "static x = 1;" and "constexpr auto n = 1;":
// no declarator starts with "=".
NamedType -> {
    /** @var array{TokenInterface} $children */
    // The name is read here rather than by Identifier(): every typedef name
    // would build it in a rule of its own, which costs a trace entry and a
    // reducer call per name
    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    return new Type\NamedType(new Node\Identifier($children[0]->value, $offset), $offset);
}
  : <T_IDENTIFIER> !InitializerStart()
  ;

InitializerStart
  : <T_ASSIGN>
  ;

//
// 6.7.3.2 Structure and union specifiers
//

// A tag, a body or both, with the attributes after the keyword and after
// the body. The tag and the body are alternatives of one rule, so that the
// attributes are parsed once.
StructType -> {
    /**
     * @var list{
     *     TokenInterface,
     *     ...<Attribute\AttributeInterface|Node\Identifier|Type\RecordType\MemberDeclarationList>
     * } $children
     */
    $name = null;
    $members = null;
    $attributes = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Node\Identifier) {
            $name = $children[$i];
        } elseif ($children[$i] instanceof Type\RecordType\MemberDeclarationList) {
            $members = $children[$i];
        } else {
            $attributes[] = $children[$i];
        }
    }

    return new Type\RecordType\StructType(
        $name,
        $members,
        $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset),
        $offset,
    );
}
  : <T_STRUCT> (AttributeSpecifier()+)? (Identifier() RecordBody()? | RecordBody())
  ;

UnionType -> {
    /**
     * @var list{
     *     TokenInterface,
     *     ...<Attribute\AttributeInterface|Node\Identifier|Type\RecordType\MemberDeclarationList>
     * } $children
     */
    $name = null;
    $members = null;
    $attributes = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Node\Identifier) {
            $name = $children[$i];
        } elseif ($children[$i] instanceof Type\RecordType\MemberDeclarationList) {
            $members = $children[$i];
        } else {
            $attributes[] = $children[$i];
        }
    }

    return new Type\RecordType\UnionType(
        $name,
        $members,
        $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset),
        $offset,
    );
}
  : <T_UNION> (AttributeSpecifier()+)? (Identifier() RecordBody()? | RecordBody())
  ;

// The members and the attributes GCC allows after the body
RecordBody
  : MemberDeclarationList() (AttributeSpecifier()+)?
  ;

// C23 requires at least one member, but GCC allows an empty body. The brace
// is kept, so that an empty list starts where it is written.
MemberDeclarationList -> {
    /**
     * @var list{
     *     TokenInterface,
     *     ...<Type\RecordType\MemberDeclaration|Declaration\StaticAssertDeclaration>
     * } $children
     */
    $members = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $members[] = $children[$i];
    }

    return new Type\RecordType\MemberDeclarationList($members, $members[0]->offset ?? $offset);
}
  : <T_LBRACE> (RecordMember()+)? ::T_RBRACE::
  ;

// A lone ";" among the members is not valid C, but GCC and Clang accept it
// as they do at file scope, so it is skipped
RecordMember
  : MemberDeclarations()
  | StaticAssertDeclaration()
  | ::T_SEMICOLON::
  ;

// A member declaration gives a node for each of its declarators, and a
// single node without a name when it has none: an anonymous structure or
// union, "struct { int a; };". Both forms are one rule, so that the
// specifiers, which may hold a nested body, are parsed only once.
MemberDeclarations -> {
    /**
     * @var list{
     *     Type\TypeInterface|null,
     *     Specifier\SpecifierList,
     *     ...<\Closure(
     *         Type\TypeInterface|null,
     *         Specifier\SpecifierList,
     *         int<0, max>
     *     ): Type\RecordType\MemberDeclaration>
     * } $children
     */
    if (\count($children) === 2) {
        return new Type\RecordType\MemberDeclaration($children[0], specifiers: $children[1], offset: $offset);
    }

    $members = [];

    for ($i = 2, $count = \count($children); $i < $count; ++$i) {
        $members[] = $children[$i]($children[0], $children[1], $offset);
    }

    return $members;
}
  : DeclarationSpecifiers() (MemberDeclarator() ((::T_COMMA:: MemberDeclarator())+)?)? ::T_SEMICOLON::
  ;

// The declarator of a member is a function from the type and the other
// specifiers of the member declaration and its start to the declared one
MemberDeclarator
  : NamedMemberDeclarator()
  | UnnamedBitFieldDeclarator()
  ;

// A declarator, the width of a bit-field and the attributes GCC allows
// before the declarator (other than the first one of the member
// declaration, whose attributes go to the specifiers), after it and after
// the width
NamedMemberDeclarator -> {
    /**
     * @var list<
     *     Attribute\AttributeInterface
     *     |Node\Identifier
     *     |\Closure(Type\TypeInterface|null): (Type\TypeInterface|null)
     *     |Expression\ExpressionInterface
     * > $children
     */
    $name = null;
    $declarator = null;
    $width = null;
    $attributes = [];

    for ($i = 0, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Node\Identifier) {
            $name = $children[$i];
        } elseif ($children[$i] instanceof \Closure) {
            $declarator = $children[$i];
        } elseif ($children[$i] instanceof Attribute\AttributeInterface) {
            $attributes[] = $children[$i];
        } else {
            $width = $children[$i];
        }
    }

    // A declarator gives its name and its function
    \assert($name !== null && $declarator !== null);

    return static function (
        ?Type\TypeInterface $type,
        Specifier\SpecifierList $specifiers,
        int $start,
    ) use ($declarator, $name, $width, $attributes): Type\RecordType\MemberDeclaration {
        // The start of a declaration is a byte offset
        \assert($start >= 0);

        return new Type\RecordType\MemberDeclaration(
            $declarator($type),
            $name,
            $width,
            $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset),
            $specifiers,
            $start,
        );
    };
}
  : (AttributeSpecifier()+)? Declarator() (::T_COLON:: ConditionalExpression())? (AttributeSpecifier()+)?
  ;

UnnamedBitFieldDeclarator -> {
    /** @var list{Expression\ExpressionInterface, ...<Attribute\AttributeInterface>} $children */
    $attributes = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $attributes[] = $children[$i];
    }

    return static function (
        ?Type\TypeInterface $type,
        Specifier\SpecifierList $specifiers,
        int $start,
    ) use ($children, $attributes): Type\RecordType\MemberDeclaration {
        // The start of a declaration is a byte offset
        \assert($start >= 0);

        return new Type\RecordType\MemberDeclaration(
            $type,
            null,
            $children[0],
            $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset),
            $specifiers,
            $start,
        );
    };
}
  : ::T_COLON:: ConditionalExpression() (AttributeSpecifier()+)?
  ;

//
// 6.7.3.3 Enumeration specifiers
//

// An enumeration with a tag (a reference to it, its declaration with the
// underlying type only, "enum E : int;", or its definition) or an anonymous
// one, with the attributes after the keyword and after the body. The tag
// and the body are alternatives of one rule, so that the attributes are
// parsed once.
EnumType -> {
    /**
     * @var list{
     *     TokenInterface,
     *     ...<Attribute\AttributeInterface|Node\Identifier|Type\TypeInterface|Type\EnumType\EnumeratorList>
     * } $children
     */
    $name = null;
    $underlyingType = null;
    $enumerators = null;
    $attributes = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Node\Identifier) {
            $name = $children[$i];
        } elseif ($children[$i] instanceof Type\EnumType\EnumeratorList) {
            $enumerators = $children[$i];
        } elseif ($children[$i] instanceof Attribute\AttributeInterface) {
            $attributes[] = $children[$i];
        } else {
            $underlyingType = $children[$i];
        }
    }

    return new Type\EnumType(
        $name,
        $underlyingType,
        $enumerators,
        $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset),
        $offset,
    );
}
  : <T_ENUM> (AttributeSpecifier()+)? (
        Identifier() EnumUnderlyingType()? EnumBody()?
      | EnumUnderlyingType()? EnumBody()
    )
  ;

EnumUnderlyingType
  : ::T_COLON:: TypeNameSpecifiers()
  ;

// The enumerators and the attributes GCC allows after the body
EnumBody
  : ::T_LBRACE:: EnumeratorList() ::T_RBRACE:: (AttributeSpecifier()+)?
  ;

// C23 requires at least one enumerator, a trailing comma is allowed
EnumeratorList -> {
    /** @var non-empty-list<Type\EnumType\Enumerator> $children */
    return new Type\EnumType\EnumeratorList($children, $offset);
}
  : Enumerator() ((::T_COMMA:: Enumerator())+)? ::T_COMMA::?
  ;

// A name, the attributes after it and the value: A [[deprecated]] = 1
Enumerator -> {
    /** @var list{Node\Identifier, ...<Attribute\AttributeInterface|Expression\ExpressionInterface>} $children */
    $value = null;
    $attributes = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        if ($children[$i] instanceof Attribute\AttributeInterface) {
            $attributes[] = $children[$i];
        } else {
            $value = $children[$i];
        }
    }

    return new Type\EnumType\Enumerator(
        $children[0],
        $value,
        $attributes === [] ? null : new Attribute\AttributeList($attributes, $attributes[0]->offset),
        $offset,
    );
}
  : Identifier() (AttributeSpecifier()+)? (::T_ASSIGN:: ConditionalExpression())?
  ;

//
// 6.7.3.6 Typeof specifiers. Whether the operand is a type name or an
// expression is the class of the node, as in sizeof. A lone identifier in
// the parentheses is read as a type name.
//

TypeOfTypeType -> {
    /** @var array{TokenInterface, Type\TypeInterface} $children */
    return new Type\TypeOfTypeType($children[1], $offset);
}
  : <T_TYPEOF> ::T_LPAREN:: !ExpressionLikeTypeName() TypeName() ::T_RPAREN::
  ;

TypeOfType -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new Type\TypeOfType($children[1], $offset);
}
  : <T_TYPEOF> ::T_LPAREN:: Expression() ::T_RPAREN::
  ;

TypeOfUnqualTypeType -> {
    /** @var array{TokenInterface, Type\TypeInterface} $children */
    return new Type\TypeOfUnqualTypeType($children[1], $offset);
}
  : <T_TYPEOF_UNQUAL> ::T_LPAREN:: !ExpressionLikeTypeName() TypeName() ::T_RPAREN::
  ;

TypeOfUnqualType -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new Type\TypeOfUnqualType($children[1], $offset);
}
  : <T_TYPEOF_UNQUAL> ::T_LPAREN:: Expression() ::T_RPAREN::
  ;

//
// 6.7.4 Type qualifiers
//

TypeQualifier
  : ConstQualifier()
  | VolatileQualifier()
  | RestrictQualifier()
  | AtomicQualifier()
  ;

ConstQualifier -> { return Type\QualifiedType\TypeQualifier::Const; }
  : <T_CONST>
  ;

VolatileQualifier -> { return Type\QualifiedType\TypeQualifier::Volatile; }
  : <T_VOLATILE>
  ;

RestrictQualifier -> { return Type\QualifiedType\TypeQualifier::Restrict; }
  : <T_RESTRICT>
  ;

// 6.7.3.5p4: _Atomic followed by a parenthesis is the atomic type specifier
AtomicQualifier -> { return Type\QualifiedType\TypeQualifier::Atomic; }
  : <T_ATOMIC> !LeftParenthesis()
  ;

LeftParenthesis
  : <T_LPAREN>
  ;

//
// 6.7.5 Function specifiers
//

FunctionSpecifier
  : InlineSpecifier()
  | NoReturnSpecifier()
  ;

InlineSpecifier -> { return new Specifier\FunctionSpecifier\InlineSpecifier($offset); }
  : <T_INLINE>
  ;

NoReturnSpecifier -> { return new Specifier\FunctionSpecifier\NoReturnSpecifier($offset); }
  : <T_NORETURN>
  ;

//
// 6.7.6 Alignment specifier
//

AlignmentSpecifier
  : AlignAsTypeSpecifier()
  | AlignAsSpecifier()
  ;

AlignAsTypeSpecifier -> {
    /** @var array{TokenInterface, Type\TypeInterface} $children */
    return new Specifier\AlignmentSpecifier\AlignAsTypeSpecifier($children[1], $offset);
}
  : <T_ALIGNAS> ::T_LPAREN:: !ExpressionLikeTypeName() TypeName() ::T_RPAREN::
  ;

AlignAsSpecifier -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new Specifier\AlignmentSpecifier\AlignAsSpecifier($children[1], $offset);
}
  : <T_ALIGNAS> ::T_LPAREN:: ConditionalExpression() ::T_RPAREN::
  ;
