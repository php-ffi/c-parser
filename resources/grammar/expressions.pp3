//
// Constant expressions, 6.5 and 6.6.
//
// A constant expression may not contain an assignment, an increment, a
// decrement, a function call or a comma outside of an operand that is not
// evaluated (6.6p3). The function call is left out, so that "(T)(x)" is always
// a cast. The assignment, the increment and the decrement are left out, since
// headers do not use them. The comma is kept, since it is a part of every
// parenthesized expression of C. _Generic (6.5.2.1) is not supported yet.
//
// A node starts where its rule does ($offset), so a parenthesized operand
// keeps its "(" as a token: the parentheses belong to no node, but the node
// that contains them starts at them.
//

// 6.5.18 Comma operator, only allowed in parentheses, in a subscript and
// between "?" and ":"
Expression -> {
    /** @var non-empty-list<Expression\ExpressionInterface> $children */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $result = new BinaryExpression\CommaExpression($result, $children[$i], $offset);
    }

    return $result;
}
  : ConditionalExpression() (
        ::T_COMMA:: ConditionalExpression()
    )*
  ;

// 6.5.16 Conditional operator, right-associative: a ? b : c ? d : e is
// a ? b : (c ? d : e)
ConditionalExpression -> {
    /**
     * @var array{Expression\ExpressionInterface}|array{
     *     Expression\ExpressionInterface,
     *     Expression\ExpressionInterface,
     *     Expression\ExpressionInterface
     * } $children
     */
    if (\count($children) === 1) {
        return $children[0];
    }

    return new Expression\ConditionalExpression($children[0], $children[1], $children[2], $offset);
}
  : LogicalOrExpression() (
        ::T_QUESTION:: Expression()
        ::T_COLON:: ConditionalExpression()
    )?
  ;

// Binary operators, one rule per level of precedence from the loosest to the
// tightest. Every level is left-associative: a - b - c is (a - b) - c.

// 6.5.15 Logical OR operator, a || b
LogicalOrExpression -> {
    /** @var non-empty-list<Expression\ExpressionInterface> $children */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $result = new BinaryExpression\LogicalOrExpression($result, $children[$i], $offset);
    }

    return $result;
}
  : LogicalAndExpression() (
        ::T_LOGICAL_OR:: LogicalAndExpression()
    )*
  ;

// 6.5.14 Logical AND operator, a && b
LogicalAndExpression -> {
    /** @var non-empty-list<Expression\ExpressionInterface> $children */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $result = new BinaryExpression\LogicalAndExpression($result, $children[$i], $offset);
    }

    return $result;
}
  : BitwiseOrExpression() (
        ::T_LOGICAL_AND:: BitwiseOrExpression()
    )*
  ;

// 6.5.13 Bitwise inclusive OR operator, a | b
BitwiseOrExpression -> {
    /** @var non-empty-list<Expression\ExpressionInterface> $children */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $result = new BinaryExpression\BitwiseOrExpression($result, $children[$i], $offset);
    }

    return $result;
}
  : BitwiseXorExpression() (
        ::T_PIPE:: BitwiseXorExpression()
    )*
  ;

// 6.5.12 Bitwise exclusive OR operator, a ^ b
BitwiseXorExpression -> {
    /** @var non-empty-list<Expression\ExpressionInterface> $children */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $result = new BinaryExpression\BitwiseXorExpression($result, $children[$i], $offset);
    }

    return $result;
}
  : BitwiseAndExpression() (
        ::T_CARET:: BitwiseAndExpression()
    )*
  ;

// 6.5.11 Bitwise AND operator, a & b
BitwiseAndExpression -> {
    /** @var non-empty-list<Expression\ExpressionInterface> $children */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $result = new BinaryExpression\BitwiseAndExpression($result, $children[$i], $offset);
    }

    return $result;
}
  : EqualityExpression() (
        ::T_AMPERSAND:: EqualityExpression()
    )*
  ;

// 6.5.10 Equality operators, a == b and a != b
EqualityExpression -> {
    /**
     * @var non-empty-list<Expression\ExpressionInterface|TokenInterface> $children
     * @var Expression\ExpressionInterface $result
     */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; $i += 2) {
        // @phpstan-ignore-next-line odd children are the listed tokens, so id exists and an arm matches
        $result = match ($children[$i]->id) {
            // @phpstan-ignore-next-line even children are operands, a list type cannot express the alternation
            self::T_EQUAL => new BinaryExpression\EqualExpression($result, $children[$i + 1], $offset),
            // @phpstan-ignore-next-line even children are operands, a list type cannot express the alternation
            self::T_NOT_EQUAL => new BinaryExpression\NotEqualExpression($result, $children[$i + 1], $offset),
        };
    }

    return $result;
}
  : RelationalExpression() (
        (<T_EQUAL> | <T_NOT_EQUAL>) RelationalExpression()
    )*
  ;

// 6.5.9 Relational operators, a < b, a > b, a <= b and a >= b
RelationalExpression -> {
    /**
     * @var non-empty-list<Expression\ExpressionInterface|TokenInterface> $children
     * @var Expression\ExpressionInterface $result
     */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; $i += 2) {
        // @phpstan-ignore-next-line odd children are the listed tokens, so id exists and an arm matches
        $result = match ($children[$i]->id) {
            // @phpstan-ignore-next-line even children are operands, a list type cannot express the alternation
            self::T_LESS => new BinaryExpression\LessExpression($result, $children[$i + 1], $offset),
            // @phpstan-ignore-next-line even children are operands, a list type cannot express the alternation
            self::T_GREATER => new BinaryExpression\GreaterExpression($result, $children[$i + 1], $offset),
            // @phpstan-ignore-next-line even children are operands, a list type cannot express the alternation
            self::T_LESS_EQUAL => new BinaryExpression\LessOrEqualExpression($result, $children[$i + 1], $offset),
            // @phpstan-ignore-next-line even children are operands, a list type cannot express the alternation
            self::T_GREATER_EQUAL => new BinaryExpression\GreaterOrEqualExpression($result, $children[$i + 1], $offset),
        };
    }

    return $result;
}
  : ShiftExpression() (
        (<T_LESS> | <T_GREATER> | <T_LESS_EQUAL> | <T_GREATER_EQUAL>) ShiftExpression()
    )*
  ;

// 6.5.8 Bitwise shift operators, a << b and a >> b
ShiftExpression -> {
    /**
     * @var non-empty-list<Expression\ExpressionInterface|TokenInterface> $children
     * @var Expression\ExpressionInterface $result
     */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; $i += 2) {
        // @phpstan-ignore-next-line odd children are the listed tokens, so id exists and an arm matches
        $result = match ($children[$i]->id) {
            // @phpstan-ignore-next-line even children are operands, a list type cannot express the alternation
            self::T_SHL => new BinaryExpression\ShiftLeftExpression($result, $children[$i + 1], $offset),
            // @phpstan-ignore-next-line even children are operands, a list type cannot express the alternation
            self::T_SHR => new BinaryExpression\ShiftRightExpression($result, $children[$i + 1], $offset),
        };
    }

    return $result;
}
  : AdditiveExpression() (
        (<T_SHL> | <T_SHR>) AdditiveExpression()
    )*
  ;

// 6.5.7 Additive operators, a + b and a - b
AdditiveExpression -> {
    /**
     * @var non-empty-list<Expression\ExpressionInterface|TokenInterface> $children
     * @var Expression\ExpressionInterface $result
     */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; $i += 2) {
        // @phpstan-ignore-next-line odd children are the listed tokens, so id exists and an arm matches
        $result = match ($children[$i]->id) {
            // @phpstan-ignore-next-line even children are operands, a list type cannot express the alternation
            self::T_PLUS => new BinaryExpression\AddExpression($result, $children[$i + 1], $offset),
            // @phpstan-ignore-next-line even children are operands, a list type cannot express the alternation
            self::T_MINUS => new BinaryExpression\SubExpression($result, $children[$i + 1], $offset),
        };
    }

    return $result;
}
  : MultiplicativeExpression() (
        (<T_PLUS> | <T_MINUS>) MultiplicativeExpression()
    )*
  ;

// 6.5.6 Multiplicative operators, a * b, a / b and a % b
MultiplicativeExpression -> {
    /**
     * @var non-empty-list<Expression\ExpressionInterface|TokenInterface> $children
     * @var Expression\ExpressionInterface $result
     */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; $i += 2) {
        // @phpstan-ignore-next-line odd children are the listed tokens, so id exists and an arm matches
        $result = match ($children[$i]->id) {
            // @phpstan-ignore-next-line even children are operands, a list type cannot express the alternation
            self::T_ASTERISK => new BinaryExpression\MulExpression($result, $children[$i + 1], $offset),
            // @phpstan-ignore-next-line even children are operands, a list type cannot express the alternation
            self::T_SLASH => new BinaryExpression\DivExpression($result, $children[$i + 1], $offset),
            // @phpstan-ignore-next-line even children are operands, a list type cannot express the alternation
            self::T_PERCENT => new BinaryExpression\RemExpression($result, $children[$i + 1], $offset),
        };
    }

    return $result;
}
  : CastOrUnaryExpression() (
        (<T_ASTERISK> | <T_SLASH> | <T_PERCENT>) CastOrUnaryExpression()
    )*
  ;

CastOrUnaryExpression
  : CastExpression()
  | UnaryExpression()
  ;

// 6.5.5 Cast operators, (T)x, and 6.5.3.6 Compound literals, (T){1}. Most
// type names cannot be an expression, so "(int)-x" and "(T *)-x" are casts,
// and the ones that read as an expression other than a lone identifier are
// never a cast (see ExpressionLikeTypeName). Without a table of the declared
// names "(T)" is a cast only when the next token can start an operand but
// cannot continue a parenthesized expression (CastStart), so "(T)-x" is a
// subtraction and "(x)[0]" is a subscript. The cast and the compound
// literal are one rule, and the lone identifier cases one alternative, so
// that the type name is parsed once: a type name may hold an expression
// with the same construct (an array size, typeof), and parsing it again on
// each level of the nesting would double the work on each of them.
CastExpression -> {
    /**
     * @var array{TokenInterface, Type\TypeInterface, Expression\ExpressionInterface}
     *     |array{
     *         TokenInterface,
     *         Type\TypeInterface,
     *         \Closure(TokenInterface, Type\TypeInterface): Expression\ExpressionInterface
     *     } $children
     */
    if ($children[2] instanceof \Closure) {
        return $children[2]($children[0], $children[1]);
    }

    return new Expression\CastExpression($children[1], $children[2], $offset);
}
  : <T_LPAREN> (!LoneIdentifier() !ExpressionLikeTypeName() | &LoneIdentifierCast()) TypeName() ::T_RPAREN::
        (CompoundLiteral() | CastOrUnaryExpression())
  ;

LoneIdentifier
  : <T_IDENTIFIER> <T_RPAREN>
  ;

LoneIdentifierCast
  : <T_IDENTIFIER> <T_RPAREN> CastStart()
  ;

CastStart
  : <T_IDENTIFIER> | <T_LPAREN>
  | <T_DEC_INT_LITERAL> | <T_HEX_INT_LITERAL> | <T_OCT_INT_LITERAL> | <T_BIN_INT_LITERAL>
  | <T_DEC_FLOAT_LITERAL> | <T_HEX_FLOAT_LITERAL> | <T_CHAR_LITERAL> | <T_STRING_LITERAL>
  | <T_TRUE> | <T_FALSE> | <T_NULLPTR>
  | <T_TILDE> | <T_EXCLAMATION> | <T_SIZEOF> | <T_ALIGNOF> | <T_LBRACE>
  ;

// The braces of a compound literal after its type name, and the postfix
// operators applied to the literal: (struct S){1}.a. A function from the
// parenthesis and the type name to the expression.
CompoundLiteral -> {
    /**
     * @var list{
     *     Initializer\InitializerList,
     *     ...<\Closure(Expression\ExpressionInterface, int): Expression\ExpressionInterface>
     * } $children
     */
    return static function (
        TokenInterface $parenthesis,
        Type\TypeInterface $type,
    ) use ($children): Expression\ExpressionInterface {
        $result = new Expression\CompoundLiteralExpression($type, $children[0], $parenthesis->offset);

        for ($i = 1, $count = \count($children); $i < $count; ++$i) {
            $result = $children[$i]($result, $parenthesis->offset);
        }

        return $result;
    };
}
  : InitializerList() PostfixOperator()*
  ;

// 6.5.4 Unary operators
UnaryExpression
  : PlusExpression()
  | MinusExpression()
  | LogicalNotExpression()
  | BitwiseNotExpression()
  | DereferenceExpression()
  | AddressOfExpression()
  | SizeOfTypeExpression()
  | SizeOfExpression()
  | AlignOfTypeExpression()
  | PostfixExpression()
  ;

// +x
PlusExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\PlusExpression($children[1], $offset);
}
  : <T_PLUS> CastOrUnaryExpression()
  ;

// -x
MinusExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\MinusExpression($children[1], $offset);
}
  : <T_MINUS> CastOrUnaryExpression()
  ;

// !x
LogicalNotExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\LogicalNotExpression($children[1], $offset);
}
  : <T_EXCLAMATION> CastOrUnaryExpression()
  ;

// ~x
BitwiseNotExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\BitwiseNotExpression($children[1], $offset);
}
  : <T_TILDE> CastOrUnaryExpression()
  ;

// *p
DereferenceExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\DereferenceExpression($children[1], $offset);
}
  : <T_ASTERISK> CastOrUnaryExpression()
  ;

// &x
AddressOfExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\AddressOfExpression($children[1], $offset);
}
  : <T_AMPERSAND> CastOrUnaryExpression()
  ;

// 6.5.4.4 The sizeof and alignof operators, sizeof(T). A single name in
// parentheses is read as a type unless a postfix operator follows it:
// sizeof(x)[0] is sizeof((x)[0]). A brace after the type name makes the
// operand a compound literal, sizeof (int){1}, built by the same rule, so
// that the type name is parsed once.
SizeOfTypeExpression -> {
    /**
     * @var array{TokenInterface, TokenInterface, Type\TypeInterface}
     *     |array{
     *         TokenInterface,
     *         TokenInterface,
     *         Type\TypeInterface,
     *         \Closure(TokenInterface, Type\TypeInterface): Expression\ExpressionInterface
     *     } $children
     */
    if (isset($children[3])) {
        return new Expression\SizeOfExpression($children[3]($children[1], $children[2]), $offset);
    }

    return new Expression\SizeOfTypeExpression($children[2], $offset);
}
  : <T_SIZEOF> <T_LPAREN> !ExpressionLikeTypeName() TypeName() ::T_RPAREN::
        (CompoundLiteral() | !PostfixOperatorStart())
  ;

// 6.5.4.4 The sizeof and alignof operators, sizeof x
SizeOfExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new Expression\SizeOfExpression($children[1], $offset);
}
  : <T_SIZEOF> UnaryExpression()
  ;

// 6.5.4.4 The sizeof and alignof operators, alignof(T), also spelled _Alignof
AlignOfTypeExpression -> {
    /** @var array{TokenInterface, Type\TypeInterface} $children */
    return new Expression\AlignOfTypeExpression($children[1], $offset);
}
  : <T_ALIGNOF> ::T_LPAREN:: TypeName() ::T_RPAREN::
  ;

// 6.5.3 Postfix operators, a[i], s.member, p->member. Every node of the
// chain starts where the whole expression does.
PostfixExpression -> {
    /**
     * @var list{
     *     Expression\ExpressionInterface,
     *     ...<\Closure(Expression\ExpressionInterface, int): Expression\ExpressionInterface>
     * } $children
     */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $result = $children[$i]($result, $offset);
    }

    return $result;
}
  : PrimaryExpression() PostfixOperator()*
  ;

// A postfix operator is a function from its operand and the start of the
// whole expression to the expression, so that a compound literal applies
// the same operators
PostfixOperator
  : SubscriptOperator()
  | DirectMemberOperator()
  | PointerMemberOperator()
  ;

SubscriptOperator -> {
    /** @var array{Expression\ExpressionInterface} $children */
    return static function (Expression\ExpressionInterface $operand, int $start) use ($children): Expression\ExpressionInterface {
        // The start of an expression is a byte offset
        \assert($start >= 0);

        return new Expression\SubscriptExpression($operand, $children[0], $start);
    };
}
  : ::T_LBRACKET:: Expression() ::T_RBRACKET::
  ;

DirectMemberOperator -> {
    /** @var array{Node\Identifier} $children */
    return static function (Expression\ExpressionInterface $operand, int $start) use ($children): Expression\ExpressionInterface {
        // The start of an expression is a byte offset
        \assert($start >= 0);

        return new MemberExpression\DirectMemberExpression($operand, $children[0], $start);
    };
}
  : ::T_DOT:: Identifier()
  ;

PointerMemberOperator -> {
    /** @var array{Node\Identifier} $children */
    return static function (Expression\ExpressionInterface $operand, int $start) use ($children): Expression\ExpressionInterface {
        // The start of an expression is a byte offset
        \assert($start >= 0);

        return new MemberExpression\PointerMemberExpression($operand, $children[0], $start);
    };
}
  : ::T_ARROW:: Identifier()
  ;

PostfixOperatorStart
  : <T_LBRACKET> | <T_DOT> | <T_ARROW>
  ;

// 6.5.2 Primary expressions
PrimaryExpression
  : IdentifierExpression()
  | Constant()
  | ConcatenatedStringLiteral()
  | ParenthesizedExpression()
  ;

ParenthesizedExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return $children[1];
}
  : <T_LPAREN> Expression() ::T_RPAREN::
  ;

IdentifierExpression -> {
    /** @var array{Node\Identifier} $children */
    return new Expression\IdentifierExpression($children[0], $offset);
}
  : Identifier()
  ;

// A name by itself, not an expression: it is also the member of a member
// access and the name of a type
Identifier -> {
    /** @var TokenInterface $children */
    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    return new Node\Identifier($children->value, $offset);
}
  : <T_IDENTIFIER>
  ;

