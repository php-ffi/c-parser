/**
 * -----------------------------------------------------------------------------
 *  Expressions, 6.5 and 6.6.
 * -----------------------------------------------------------------------------
 *
 *  A constant expression (6.6) is a conditional expression, the operators
 *  it may not contain are reported by a validator.
 *  "(T)(x)" with a lone identifier T is always a cast.
 *
 *  A node starts where its rule does ($offset). The parentheses around an
 *  expression are a node of their own. The binary operators are the
 *  exception, see BinaryExpression.
 */

/**
 * 6.5.18 Comma operator, only allowed in parentheses, in a subscript and
 * between "?" and ":"
 */
Expression -> {
    /** @var non-empty-list<Expression\ExpressionInterface> $children */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $result = new BinaryExpression\CommaExpression($result, $children[$i], $offset);
    }

    return $result;
}
  : AssignmentExpression() (
        ::T_COMMA:: AssignmentExpression()
    )*
  ;

/**
 * 6.5.17 Assignment operators, right-associative: a = b = c is a = (b = c).
 * The left operand is a unary expression: "a + b = c" and "(int)x = 1" are
 * not assignments, a compound literal "(int){0} = 1" is. A cast to a lone
 * identifier, "(x)", may be a name in parentheses followed by postfix
 * operators, "(f)(x)[0] = 1", the transformers rebuild it once the typedef
 * names are known. A type name in parentheses is read once, as in
 * CastExpression, and the operators after the operand are functions
 * applied to it.
 */
AssignmentExpression @error("Syntax error, unexpected {token} in the expression") -> {
    /**
     * @var non-empty-list<
     *     TokenInterface
     *     |Specifier\SpecifierList
     *     |Type\TypeInterface
     *     |Expression\ExpressionInterface
     *     |\Closure(TokenInterface, Type\TypeInterface, Specifier\SpecifierList|null=): Expression\ExpressionInterface
     *     |\Closure(Expression\ExpressionInterface, int): Expression\ExpressionInterface
     * > $children
     */
    $result = $children[0];
    $first = 1;

    if ($result instanceof TokenInterface) {
        // A cast or a compound literal: the parenthesis, the specifiers of a
        // compound literal, the type name and the function of the operand
        $specifiers = $children[1] instanceof Specifier\SpecifierList ? $children[1] : null;
        $first = $specifiers === null ? 3 : 4;
        $type = $children[$first - 2];
        $operand = $children[$first - 1];
        \assert($type instanceof Type\TypeInterface && $operand instanceof \Closure);

        $result = $operand($result, $type, $specifiers);
    }

    \assert($result instanceof Expression\ExpressionInterface);

    for ($i = $first, $count = \count($children); $i < $count; ++$i) {
        \assert($children[$i] instanceof \Closure);

        $result = $children[$i]($result, $offset);
    }

    return $result;
}
  : <T_LPAREN> (
        !LoneIdentifier() !ExpressionLikeTypeName() TypeName() ::T_RPAREN:: (
            CompoundLiteral() AssignmentTail()
          | CastOperand() BinaryOperations()? ConditionalBranches()?
        )
      | &LoneIdentifierCast() TypeName() ::T_RPAREN:: CastOperand() AssignmentTail()
      | CompoundLiteralSpecifiers()? TypeName() ::T_RPAREN:: CompoundLiteral() AssignmentTail()
    )
  | UnaryExpression() AssignmentTail()
  ;

/**
 * What follows the left operand of an assignment: an assignment operator
 * and its right operand, or the binary and the conditional operators
 */
AssignmentTail
  : AssignmentOperator()
  | BinaryOperations()? ConditionalBranches()?
  ;

/**
 * An assignment operator and its right operand, a function from the left
 * operand and the start of the whole expression to the assignment
 */
AssignmentOperator
  : SimpleAssignmentOperator()
  | MulAssignmentOperator()
  | DivAssignmentOperator()
  | RemAssignmentOperator()
  | AddAssignmentOperator()
  | SubAssignmentOperator()
  | ShiftLeftAssignmentOperator()
  | ShiftRightAssignmentOperator()
  | BitwiseAndAssignmentOperator()
  | BitwiseXorAssignmentOperator()
  | BitwiseOrAssignmentOperator()
  ;

SimpleAssignmentOperator -> {
    /** @var array{Expression\ExpressionInterface} $children */
    return static function (Expression\ExpressionInterface $left, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new AssignmentExpression\AssignExpression($left, $children[0], $start);
    };
}
  : ::T_ASSIGN:: AssignmentExpression()
  ;

MulAssignmentOperator -> {
    /** @var array{Expression\ExpressionInterface} $children */
    return static function (Expression\ExpressionInterface $left, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new AssignmentExpression\MulAssignExpression($left, $children[0], $start);
    };
}
  : ::T_MUL_ASSIGN:: AssignmentExpression()
  ;

DivAssignmentOperator -> {
    /** @var array{Expression\ExpressionInterface} $children */
    return static function (Expression\ExpressionInterface $left, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new AssignmentExpression\DivAssignExpression($left, $children[0], $start);
    };
}
  : ::T_DIV_ASSIGN:: AssignmentExpression()
  ;

RemAssignmentOperator -> {
    /** @var array{Expression\ExpressionInterface} $children */
    return static function (Expression\ExpressionInterface $left, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new AssignmentExpression\RemAssignExpression($left, $children[0], $start);
    };
}
  : ::T_MOD_ASSIGN:: AssignmentExpression()
  ;

AddAssignmentOperator -> {
    /** @var array{Expression\ExpressionInterface} $children */
    return static function (Expression\ExpressionInterface $left, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new AssignmentExpression\AddAssignExpression($left, $children[0], $start);
    };
}
  : ::T_ADD_ASSIGN:: AssignmentExpression()
  ;

SubAssignmentOperator -> {
    /** @var array{Expression\ExpressionInterface} $children */
    return static function (Expression\ExpressionInterface $left, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new AssignmentExpression\SubAssignExpression($left, $children[0], $start);
    };
}
  : ::T_SUB_ASSIGN:: AssignmentExpression()
  ;

ShiftLeftAssignmentOperator -> {
    /** @var array{Expression\ExpressionInterface} $children */
    return static function (Expression\ExpressionInterface $left, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new AssignmentExpression\ShiftLeftAssignExpression($left, $children[0], $start);
    };
}
  : ::T_SHL_ASSIGN:: AssignmentExpression()
  ;

ShiftRightAssignmentOperator -> {
    /** @var array{Expression\ExpressionInterface} $children */
    return static function (Expression\ExpressionInterface $left, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new AssignmentExpression\ShiftRightAssignExpression($left, $children[0], $start);
    };
}
  : ::T_SHR_ASSIGN:: AssignmentExpression()
  ;

BitwiseAndAssignmentOperator -> {
    /** @var array{Expression\ExpressionInterface} $children */
    return static function (Expression\ExpressionInterface $left, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new AssignmentExpression\BitwiseAndAssignExpression($left, $children[0], $start);
    };
}
  : ::T_AND_ASSIGN:: AssignmentExpression()
  ;

BitwiseXorAssignmentOperator -> {
    /** @var array{Expression\ExpressionInterface} $children */
    return static function (Expression\ExpressionInterface $left, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new AssignmentExpression\BitwiseXorAssignExpression($left, $children[0], $start);
    };
}
  : ::T_XOR_ASSIGN:: AssignmentExpression()
  ;

BitwiseOrAssignmentOperator -> {
    /** @var array{Expression\ExpressionInterface} $children */
    return static function (Expression\ExpressionInterface $left, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new AssignmentExpression\BitwiseOrAssignExpression($left, $children[0], $start);
    };
}
  : ::T_OR_ASSIGN:: AssignmentExpression()
  ;

/**
 * 6.5.16 Conditional operator, right-associative: a ? b : c ? d : e is
 * a ? b : (c ? d : e). The operators after the first operand are functions
 * applied to it, as in an assignment expression.
 */
ConditionalExpression @error("Syntax error, unexpected {token} in the expression") -> {
    /**
     * @var list{
     *     Expression\ExpressionInterface,
     *     ...<\Closure(Expression\ExpressionInterface, int): Expression\ExpressionInterface>
     * } $children
     */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $result = $children[$i]($result, $offset);
    }

    return $result;
}
  : CastOrUnaryExpression() BinaryOperations()? ConditionalBranches()?
  ;

/**
 * The expressions after "?" and after ":", a function from the condition
 * and the start of the whole expression to the conditional expression
 */
ConditionalBranches
  : OmittedConditionalOperand()
  | ConditionalOperands()
  ;

/**
 * GCC: the expression after ":" alone, a ?: b, whose middle operand is the
 * condition. Requires the OmittedConditionalOperand feature.
 */
OmittedConditionalOperand -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    $this->assertFeature(Feature::OmittedConditionalOperand, $source, $children[0]->offset, $children[0]->size);

    return static function (Expression\ExpressionInterface $condition, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new Expression\ConditionalExpression($condition, null, $children[1], $start);
    };
}
  : <T_QUESTION> ::T_COLON:: ConditionalExpression()
  ;

ConditionalOperands -> {
    /** @var array{Expression\ExpressionInterface, Expression\ExpressionInterface} $children */
    return static function (Expression\ExpressionInterface $condition, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new Expression\ConditionalExpression($condition, $children[0], $children[1], $start);
    };
}
  : ::T_QUESTION:: Expression()
    ::T_COLON:: @error("Syntax error, unexpected {token} in the conditional expression, \":\" expected")
    ConditionalExpression()
  ;

/**
 * 6.5.6 to 6.5.15 Binary operators after the first operand, all the levels
 * of precedence in one rule: the operators and the operands are read as a
 * flat sequence, and the reducer builds the tree by precedence, every level
 * left-associative: a - b - c is (a - b) - c, a + b * c is a + (b * c). A
 * function from the first operand and the start of the whole expression to
 * the expression.
 *
 * A node starts where its left operand does: the leftmost one at the start
 * of the whole expression, any other one at its own node. In "a + b * c"
 * the product starts at "b".
 */
BinaryOperations -> {
    /** @var non-empty-list<Expression\ExpressionInterface|TokenInterface> $children */
    $precedence = static fn(TokenInterface $operator): int => match ($operator->id) {
        self::T_ASTERISK, self::T_SLASH, self::T_PERCENT => 10,
        self::T_PLUS, self::T_MINUS => 9,
        self::T_SHL, self::T_SHR => 8,
        self::T_LESS, self::T_GREATER, self::T_LESS_EQUAL, self::T_GREATER_EQUAL => 7,
        self::T_EQUAL, self::T_NOT_EQUAL => 6,
        self::T_AMPERSAND => 5,
        self::T_CARET => 4,
        self::T_PIPE => 3,
        self::T_LOGICAL_AND => 2,
        default => 1,
    };

    $build = static function (
        TokenInterface $operator,
        Expression\ExpressionInterface $left,
        Expression\ExpressionInterface $right,
        int $start,
    ): Expression\ExpressionInterface {
        \assert($start >= 0);

        return match ($operator->id) {
            self::T_ASTERISK => new BinaryExpression\MulExpression($left, $right, $start),
            self::T_SLASH => new BinaryExpression\DivExpression($left, $right, $start),
            self::T_PERCENT => new BinaryExpression\RemExpression($left, $right, $start),
            self::T_PLUS => new BinaryExpression\AddExpression($left, $right, $start),
            self::T_MINUS => new BinaryExpression\SubExpression($left, $right, $start),
            self::T_SHL => new BinaryExpression\ShiftLeftExpression($left, $right, $start),
            self::T_SHR => new BinaryExpression\ShiftRightExpression($left, $right, $start),
            self::T_LESS => new BinaryExpression\LessExpression($left, $right, $start),
            self::T_GREATER => new BinaryExpression\GreaterExpression($left, $right, $start),
            self::T_LESS_EQUAL => new BinaryExpression\LessOrEqualExpression($left, $right, $start),
            self::T_GREATER_EQUAL => new BinaryExpression\GreaterOrEqualExpression($left, $right, $start),
            self::T_EQUAL => new BinaryExpression\EqualExpression($left, $right, $start),
            self::T_NOT_EQUAL => new BinaryExpression\NotEqualExpression($left, $right, $start),
            self::T_AMPERSAND => new BinaryExpression\BitwiseAndExpression($left, $right, $start),
            self::T_CARET => new BinaryExpression\BitwiseXorExpression($left, $right, $start),
            self::T_PIPE => new BinaryExpression\BitwiseOrExpression($left, $right, $start),
            self::T_LOGICAL_AND => new BinaryExpression\LogicalAndExpression($left, $right, $start),
            default => new BinaryExpression\LogicalOrExpression($left, $right, $start),
        };
    };

    return static function (
        Expression\ExpressionInterface $first,
        int $start,
    ) use ($children, $precedence, $build): Expression\ExpressionInterface {
        // The operands built so far with their starts, and the operators that
        // wait for their right operand, of an ascending precedence. Even
        // children are the operators and odd ones the operands.
        /** @var non-empty-list<Expression\ExpressionInterface> $operands */
        $operands = [$first];
        $starts = [$start];
        /** @var list<TokenInterface> $operators */
        $operators = [];
        $depth = 0;

        // Past the last operand every operator waiting is built, as if the
        // input ended with an operator of the loosest precedence of all
        for ($i = 0, $count = \count($children); ; $i += 2) {
            $current = 0;

            if ($i < $count) {
                \assert($children[$i] instanceof TokenInterface);

                $current = $precedence($children[$i]);
            }

            while ($depth > 0 && $precedence($operators[$depth - 1]) >= $current) {
                --$depth;
                $operands[$depth] = $build($operators[$depth], $operands[$depth], $operands[$depth + 1], $starts[$depth]);
            }

            if ($i >= $count) {
                break;
            }

            \assert($children[$i] instanceof TokenInterface && $children[$i + 1] instanceof Expression\ExpressionInterface);

            $operators[$depth] = $children[$i];
            ++$depth;
            $operands[$depth] = $children[$i + 1];
            $starts[$depth] = $children[$i + 1]->offset;
        }

        return $operands[0];
    };
}
  : (BinaryOperator() CastOrUnaryExpression())+
  ;

BinaryOperator
  : <T_ASTERISK> | <T_SLASH> | <T_PERCENT> | <T_PLUS> | <T_MINUS> | <T_SHL> | <T_SHR>
  | <T_LESS> | <T_GREATER> | <T_LESS_EQUAL> | <T_GREATER_EQUAL> | <T_EQUAL> | <T_NOT_EQUAL>
  | <T_AMPERSAND> | <T_CARET> | <T_PIPE> | <T_LOGICAL_AND> | <T_LOGICAL_OR>
  ;

CastOrUnaryExpression @error("Syntax error, unexpected {token} in the expression")
  : CastExpression()
  | UnaryExpression()
  ;

/**
 * 6.5.5 Cast operators, (T)x, and 6.5.3.6 Compound literals, (T){1}, which
 * are postfix expressions. The type name in parentheses is read once, the
 * token after it decides. A type name that cannot be an expression makes a
 * cast: "(int)-x", "(T *)-x". A type name that reads as an expression other
 * than a lone identifier is never a cast (see ExpressionLikeTypeName). A
 * lone identifier "(T)" is a cast when the next token can start an operand
 * (CastStart): "(T)-x" is a cast, "(x)[0]" is a subscript. The storage-class
 * specifiers of a compound literal go before its type name.
 */
CastExpression -> {
    /**
     * @var array{
     *     TokenInterface,
     *     Type\TypeInterface,
     *     \Closure(TokenInterface, Type\TypeInterface, Specifier\SpecifierList|null=): Expression\ExpressionInterface
     * }|array{
     *     TokenInterface,
     *     Specifier\SpecifierList,
     *     Type\TypeInterface,
     *     \Closure(TokenInterface, Type\TypeInterface, Specifier\SpecifierList|null=): Expression\ExpressionInterface
     * } $children
     */
    if ($children[1] instanceof Specifier\SpecifierList) {
        return $children[3]($children[0], $children[2], $children[1]);
    }

    return $children[2]($children[0], $children[1]);
}
  : <T_LPAREN> (
        (!LoneIdentifier() !ExpressionLikeTypeName() | &LoneIdentifierCast()) TypeName() ::T_RPAREN::
            (CompoundLiteral() | CastOperand())
      | CompoundLiteralSpecifiers()? TypeName() ::T_RPAREN:: CompoundLiteral()
    )
  ;

/**
 * The operand of a cast, a function from the parenthesis and the type name
 * to the cast
 */
CastOperand -> {
    /** @var array{Expression\ExpressionInterface} $children */
    return static function (TokenInterface $parenthesis, Type\TypeInterface $type) use ($children): Expression\ExpressionInterface {
        return new Expression\CastExpression($type, $children[0], $parenthesis->offset);
    };
}
  : CastOrUnaryExpression()
  ;

/**
 * The braces of a compound literal after its type name, and the postfix
 * operators applied to the literal: (struct S){1}.a. A function from the
 * parenthesis, the type name and the storage-class specifiers to the
 * expression.
 */
CompoundLiteral -> {
    /**
     * @var list{
     *     Initializer\InitializerList,
     *     ...<\Closure(Expression\ExpressionInterface, int): Expression\ExpressionInterface>
     * } $children
     */
    return static function (
        TokenInterface $parenthesis,
        Type\TypeInterface $type,
        ?Specifier\SpecifierList $specifiers = null,
    ) use ($children): Expression\ExpressionInterface {
        $result = new Expression\CompoundLiteralExpression(
            $type,
            $children[0],
            $specifiers,
            $parenthesis->offset,
        );

        for ($i = 1, $count = \count($children); $i < $count; ++$i) {
            $result = $children[$i]($result, $parenthesis->offset);
        }

        return $result;
    };
}
  : InitializerList() PostfixOperator()*
  ;

/**
 * The storage-class specifiers of a compound literal
 */
CompoundLiteralSpecifiers -> {
    /** @var non-empty-list<Specifier\StorageClassSpecifier> $children */
    return new Specifier\SpecifierList($children, $offset);
}
  : StorageClassSpecifier()+
  ;

/**
 * 6.5.3.6 A compound literal as the operand of a prefix increment or
 * decrement, ++(int){1}, whose operand is a unary expression and no cast
 */
CompoundLiteralExpression -> {
    /**
     * @var array{
     *     TokenInterface,
     *     Type\TypeInterface,
     *     \Closure(TokenInterface, Type\TypeInterface, Specifier\SpecifierList|null=): Expression\ExpressionInterface
     * }|array{
     *     TokenInterface,
     *     Specifier\SpecifierList,
     *     Type\TypeInterface,
     *     \Closure(TokenInterface, Type\TypeInterface, Specifier\SpecifierList|null=): Expression\ExpressionInterface
     * } $children
     */
    if ($children[1] instanceof Specifier\SpecifierList) {
        return $children[3]($children[0], $children[2], $children[1]);
    }

    return $children[2]($children[0], $children[1]);
}
  : <T_LPAREN> CompoundLiteralSpecifiers()? TypeName() ::T_RPAREN:: CompoundLiteral()
  ;

/**
 * The operand of a prefix increment or decrement: a unary expression
 */
UnaryOperand
  : CompoundLiteralExpression()
  | UnaryExpression()
  ;

LoneIdentifier
  : <T_IDENTIFIER> <T_RPAREN>
  ;

LoneIdentifierCast
  : <T_IDENTIFIER> <T_RPAREN> CastStart()
  ;

CastStart
  : <T_IDENTIFIER> | <T_BUILTIN_CALL> | <T_LPAREN>
  | <T_DEC_INT_LITERAL> | <T_HEX_INT_LITERAL> | <T_OCT_INT_LITERAL> | <T_BIN_INT_LITERAL>
  | <T_DEC_FLOAT_LITERAL> | <T_HEX_FLOAT_LITERAL> | <T_CHAR_LITERAL> | <T_STRING_LITERAL>
  | <T_TRUE> | <T_FALSE> | <T_NULLPTR>
  | <T_PLUS> | <T_MINUS> | <T_ASTERISK> | <T_AMPERSAND> | <T_INCREMENT> | <T_DECREMENT>
  | <T_TILDE> | <T_EXCLAMATION> | <T_SIZEOF> | <T_ALIGNOF> | <T_GENERIC> | <T_EXTENSION> | <T_REAL> | <T_IMAG>
  ;

/**
 * 6.5.4 Unary operators
 */
UnaryExpression
  : PreIncrementExpression()
  | PreDecrementExpression()
  | PlusExpression()
  | MinusExpression()
  | LogicalNotExpression()
  | BitwiseNotExpression()
  | DereferenceExpression()
  | AddressOfExpression()
  | SizeOfTypeExpression()
  | SizeOfExpression()
  | AlignOfTypeExpression()
  | AlignOfExpression()
  | RealPartExpression()
  | ImagPartExpression()
  | ExtensionExpression()
  | PostfixExpression()
  ;

/**
 * GCC: the real part of a complex number, __real__ z. Requires the
 * ComplexParts feature.
 */
RealPartExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    $this->assertFeature(Feature::ComplexParts, $source, $children[0]->offset, $children[0]->size);

    return new UnaryExpression\RealPartExpression($children[1], $offset);
}
  : <T_REAL> CastOrUnaryExpression()
  ;

/**
 * GCC: the imaginary part of a complex number, __imag__ z. Requires the
 * ComplexParts feature.
 */
ImagPartExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    $this->assertFeature(Feature::ComplexParts, $source, $children[0]->offset, $children[0]->size);

    return new UnaryExpression\ImagPartExpression($children[1], $offset);
}
  : <T_IMAG> CastOrUnaryExpression()
  ;

/**
 * GCC: __extension__ before an operand, which gives the operand itself
 */
ExtensionExpression
  : ExtensionKeyword() CastOrUnaryExpression()
  ;

/**
 * 6.5.4.1 Prefix increment and decrement operators, ++x, whose operand is a
 * unary expression: "++(T)x" is not one
 */
PreIncrementExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\PreIncrementExpression($children[1], $offset);
}
  : <T_INCREMENT> UnaryOperand()
  ;

/**
 * --x
 */
PreDecrementExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\PreDecrementExpression($children[1], $offset);
}
  : <T_DECREMENT> UnaryOperand()
  ;

/**
 * +x
 */
PlusExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\PlusExpression($children[1], $offset);
}
  : <T_PLUS> CastOrUnaryExpression()
  ;

/**
 * -x
 */
MinusExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\MinusExpression($children[1], $offset);
}
  : <T_MINUS> CastOrUnaryExpression()
  ;

/**
 * !x
 */
LogicalNotExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\LogicalNotExpression($children[1], $offset);
}
  : <T_EXCLAMATION> CastOrUnaryExpression()
  ;

/**
 * ~x
 */
BitwiseNotExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\BitwiseNotExpression($children[1], $offset);
}
  : <T_TILDE> CastOrUnaryExpression()
  ;

/**
 * *p
 */
DereferenceExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\DereferenceExpression($children[1], $offset);
}
  : <T_ASTERISK> CastOrUnaryExpression()
  ;

/**
 * &x
 */
AddressOfExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\AddressOfExpression($children[1], $offset);
}
  : <T_AMPERSAND> CastOrUnaryExpression()
  ;

/**
 * 6.5.4.4 The sizeof and alignof operators, sizeof(T)
 */
SizeOfTypeExpression -> {
    /**
     * @var array{TokenInterface, TokenInterface, Type\TypeInterface}
     *     |array{
     *         TokenInterface,
     *         TokenInterface,
     *         Type\TypeInterface,
     *         \Closure(TokenInterface, Type\TypeInterface, Specifier\SpecifierList|null=): Expression\ExpressionInterface
     *     }
     *     |array{
     *         TokenInterface,
     *         TokenInterface,
     *         Specifier\SpecifierList,
     *         Type\TypeInterface,
     *         \Closure(TokenInterface, Type\TypeInterface, Specifier\SpecifierList|null=): Expression\ExpressionInterface
     *     } $children
     */
    if (isset($children[4])) {
        return new Expression\SizeOfExpression($children[4]($children[1], $children[3], $children[2]), $offset);
    }

    if (isset($children[3])) {
        return new Expression\SizeOfExpression($children[3]($children[1], $children[2]), $offset);
    }

    return new Expression\SizeOfTypeExpression($children[2], $offset);
}
  : <T_SIZEOF> TypeOperand()
  ;

/**
 * 6.5.4.4 The sizeof and alignof operators, sizeof x
 */
SizeOfExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new Expression\SizeOfExpression($children[1], $offset);
}
  : <T_SIZEOF> UnaryExpression()
  ;

/**
 * 6.5.4.4 The sizeof and alignof operators, alignof(T), also spelled
 * _Alignof. As in sizeof, a compound literal after the type name makes the
 * operand an expression, which GCC allows: alignof (int){1}.
 */
AlignOfTypeExpression -> {
    /**
     * @var array{TokenInterface, TokenInterface, Type\TypeInterface}
     *     |array{
     *         TokenInterface,
     *         TokenInterface,
     *         Type\TypeInterface,
     *         \Closure(TokenInterface, Type\TypeInterface, Specifier\SpecifierList|null=): Expression\ExpressionInterface
     *     }
     *     |array{
     *         TokenInterface,
     *         TokenInterface,
     *         Specifier\SpecifierList,
     *         Type\TypeInterface,
     *         \Closure(TokenInterface, Type\TypeInterface, Specifier\SpecifierList|null=): Expression\ExpressionInterface
     *     } $children
     */
    $this->assertKeywordSpelling($source, $children[0]);

    if (isset($children[4])) {
        return new Expression\AlignOfExpression($children[4]($children[1], $children[3], $children[2]), $offset);
    }

    if (isset($children[3])) {
        return new Expression\AlignOfExpression($children[3]($children[1], $children[2]), $offset);
    }

    return new Expression\AlignOfTypeExpression($children[2], $offset);
}
  : <T_ALIGNOF> TypeOperand()
  ;

/**
 * GCC: alignof applied to an expression, __alignof__ x
 */
AlignOfExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    $this->assertKeywordSpelling($source, $children[0]);

    return new Expression\AlignOfExpression($children[1], $offset);
}
  : <T_ALIGNOF> UnaryExpression()
  ;

/**
 * The type name in parentheses of sizeof and alignof. A single name is read
 * as a type unless a postfix operator follows it: sizeof(x)[0] is
 * sizeof((x)[0]). A brace after the type name makes the operand a compound
 * literal, sizeof (int){1}, read along with the type name. Passed to the
 * parent as the parenthesis, the storage-class specifiers of a compound
 * literal, the type name and the compound literal, if they are written.
 */
TypeOperand
  : <T_LPAREN> (
        !ExpressionLikeTypeName() TypeName() ::T_RPAREN:: (CompoundLiteral() | !PostfixOperatorStart())
      | CompoundLiteralSpecifiers()? TypeName() ::T_RPAREN:: CompoundLiteral()
    )
  ;

/**
 * 6.5.3 Postfix operators, a[i], f(x), s.member, p->member, x++ and x--.
 * Every node of the chain starts where the whole expression does.
 */
PostfixExpression -> {
    /**
     * @var list{
     *     Expression\ExpressionInterface,
     *     ...<\Closure(Expression\ExpressionInterface, int): Expression\ExpressionInterface>
     * } $children
     */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $result = $children[$i]($result, $offset);
    }

    return $result;
}
  : PrimaryExpression() PostfixOperator()*
  ;

/**
 * A postfix operator is a function from its operand and the start of the
 * whole expression to the expression, applied by a postfix expression and
 * by a compound literal
 */
PostfixOperator
  : SubscriptOperator()
  | CallOperator()
  | DirectMemberOperator()
  | PointerMemberOperator()
  | PostIncrementOperator()
  | PostDecrementOperator()
  ;

SubscriptOperator -> {
    /** @var array{Expression\ExpressionInterface} $children */
    return static function (Expression\ExpressionInterface $operand, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new Expression\SubscriptExpression($operand, $children[0], $start);
    };
}
  : ::T_LBRACKET:: Expression()
    ::T_RBRACKET:: @error("Syntax error, unexpected {token} in the subscript, \"]\" expected")
  ;

/**
 * 6.5.3.3 Function calls, f(), f(x, y). The parenthesis marks the start of
 * an empty argument list.
 */
CallOperator -> {
    /** @var list{TokenInterface, ...<Expression\ExpressionInterface>} $children */
    $arguments = [];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $arguments[] = $children[$i];
    }

    $list = new Expression\CallExpression\ArgumentList($arguments, $arguments[0]->offset ?? $offset);

    return static function (Expression\ExpressionInterface $operand, int $start) use ($list): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new Expression\CallExpression($operand, $list, $start);
    };
}
  : <T_LPAREN> (AssignmentExpression() (::T_COMMA:: AssignmentExpression())*)?
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the arguments, \",\" or \")\" expected")
  ;

DirectMemberOperator -> {
    /** @var array{Node\Identifier} $children */
    return static function (Expression\ExpressionInterface $operand, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new MemberExpression\DirectMemberExpression($operand, $children[0], $start);
    };
}
  : ::T_DOT:: Identifier() @error("Syntax error, unexpected {token} in the member access, a member name expected")
  ;

PointerMemberOperator -> {
    /** @var array{Node\Identifier} $children */
    return static function (Expression\ExpressionInterface $operand, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new MemberExpression\PointerMemberExpression($operand, $children[0], $start);
    };
}
  : ::T_ARROW:: Identifier() @error("Syntax error, unexpected {token} in the member access, a member name expected")
  ;

/**
 * 6.5.3.5 Postfix increment and decrement operators, x++
 */
PostIncrementOperator -> {
    return static function (Expression\ExpressionInterface $operand, int $start): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new PostfixExpression\PostIncrementExpression($operand, $start);
    };
}
  : <T_INCREMENT>
  ;

/**
 * x--
 */
PostDecrementOperator -> {
    return static function (Expression\ExpressionInterface $operand, int $start): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new PostfixExpression\PostDecrementExpression($operand, $start);
    };
}
  : <T_DECREMENT>
  ;

PostfixOperatorStart
  : <T_LBRACKET> | <T_LPAREN> | <T_DOT> | <T_ARROW> | <T_INCREMENT> | <T_DECREMENT>
  ;

/**
 * 6.5.2 Primary expressions
 */
PrimaryExpression
  : BuiltinCallExpression()
  | IdentifierExpression()
  | Constant()
  | ConcatenatedStringExpression()
  | StatementExpression()
  | ParenthesizedExpression()
  | GenericSelectionExpression()
  ;

/**
 * GCC: a statement expression, ({ int y = x; y * 2; }). Requires the
 * StatementExpressions feature.
 */
StatementExpression -> {
    /** @var array{TokenInterface, non-empty-string} $children */
    $this->assertFeature(Feature::StatementExpressions, $source, $children[0]->offset, $children[0]->size);

    return new Expression\StatementExpression($children[1], $offset);
}
  : <T_LPAREN> CompoundStatement()
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the statement expression, \")\" expected")
  ;

/**
 * GCC and Clang: a call of a built-in function, whose arguments may be type
 * names, __builtin_offsetof(struct S, a.b[2]). With expressions only it is
 * a call of a function as any other, __builtin_expect(x, 1).
 */
BuiltinCallExpression -> {
    /** @var list{TokenInterface, TokenInterface, ...<Expression\ExpressionInterface|Type\TypeInterface>} $children */
    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    $name = new Node\Identifier($children[0]->value, $offset);
    $arguments = [];
    $isBuiltin = false;

    for ($i = 2, $count = \count($children); $i < $count; ++$i) {
        $arguments[] = $children[$i];
        $isBuiltin = $isBuiltin || $children[$i] instanceof Type\TypeInterface;
    }

    $start = $arguments[0]->offset ?? $children[1]->offset;

    if ($isBuiltin) {
        $list = new Expression\BuiltinCallExpression\ArgumentList($arguments, $start);

        return new Expression\BuiltinCallExpression($name, $list, $offset);
    }

    $expressions = [];

    foreach ($arguments as $argument) {
        \assert($argument instanceof Expression\ExpressionInterface);
        $expressions[] = $argument;
    }

    return new Expression\CallExpression(
        new Expression\IdentifierExpression($name, $offset),
        new Expression\CallExpression\ArgumentList($expressions, $start),
        $offset,
    );
}
  : <T_BUILTIN_CALL> <T_LPAREN> (::T_RPAREN:: | BuiltinArgumentBeforeComma()* LastBuiltinArgument())
  ;

/**
 * An expression, or a type name where it cannot be one, followed by a
 * comma
 */
BuiltinArgumentBeforeComma
  : AssignmentExpression() ::T_COMMA::
  | TypeName() ::T_COMMA::
  ;

/**
 * The last argument, an expression or a type name, and the closing
 * parenthesis
 */
LastBuiltinArgument @error("Syntax error, unexpected {token} in the arguments, an expression or a type name expected")
  : AssignmentExpression()
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the arguments, \",\" or \")\" expected")
  | TypeName()
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the arguments, \",\" or \")\" expected")
  ;

/**
 * 6.5.2.1 Generic selection, _Generic(x, int: 1, default: 0)
 */
GenericSelectionExpression -> {
    /**
     * @var array{
     *     TokenInterface,
     *     Expression\ExpressionInterface,
     *     Expression\GenericSelectionExpression\GenericAssociationList
     * } $children
     */
    return new Expression\GenericSelectionExpression($children[1], $children[2], $offset);
}
  : <T_GENERIC>
    ::T_LPAREN:: @error("Syntax error, unexpected {token} in the generic selection, \"(\" expected")
    GenericControllingOperand()
    GenericAssociationList()
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the generic selection, \",\" or \")\" expected")
  ;

/**
 * The controlling expression and the comma after it
 */
GenericControllingOperand @error("Syntax error, unexpected {token} in the generic selection, an expression expected")
  : AssignmentExpression()
    ::T_COMMA:: @error("Syntax error, unexpected {token} in the generic selection, \",\" expected")
  ;

GenericAssociationList -> {
    /** @var non-empty-list<Expression\GenericSelectionExpression\GenericAssociation> $children */
    return new Expression\GenericSelectionExpression\GenericAssociationList($children, $offset);
}
  : GenericAssociation() (::T_COMMA:: GenericAssociation())*
  ;

/**
 * A type name and the expression selected for it, int: 1, or the default
 * one, default: 0
 */
GenericAssociation -> {
    /** @var array{Type\TypeInterface|TokenInterface, Expression\ExpressionInterface} $children */
    $type = $children[0] instanceof TokenInterface ? null : $children[0];

    return new Expression\GenericSelectionExpression\GenericAssociation($type, $children[1], $offset);
}
  : (<T_DEFAULT> | TypeName()) @error("Syntax error, unexpected {token} in the generic selection, a type name or \"default\" expected")
    ::T_COLON:: @error("Syntax error, unexpected {token} in the generic association, \":\" expected")
    AssignmentExpression()
  ;

/**
 * 6.5.2 Primary expressions, (x)
 */
ParenthesizedExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new Expression\ParenExpression($children[1], $offset);
}
  : <T_LPAREN> Expression()
    ::T_RPAREN:: @error("Syntax error, unexpected {token} in the parenthesized expression, \")\" expected")
  ;

IdentifierExpression -> {
    /** @var array{Node\Identifier} $children */
    return new Expression\IdentifierExpression($children[0], $offset);
}
  : Identifier()
  ;

/**
 * A name by itself, not an expression: it is also the member of a member
 * access and the name of a type
 */
Identifier -> {
    /** @var TokenInterface $children */
    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    return new Node\Identifier($children->value, $offset);
}
  : <T_IDENTIFIER>
  | <T_BUILTIN_CALL>
  ;

/**
 * The name a declaration introduces as a tag or an enumerator: an
 * identifier, or a keyword in PHP FFI
 */
DeclaredIdentifier -> {
    /** @var TokenInterface $children */
    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    return new Node\Identifier($children->value, $offset);
}
  : <T_IDENTIFIER>
  | KeywordIdentifier()
  ;

/**
 * PHP FFI: a keyword of C23 or of an extension as the name of a variable, a
 * member, a parameter, a typedef name, a tag or an enumerator: "int bool;",
 * "enum { false, true };". Gives the token. Requires the KeywordIdentifiers
 * feature.
 */
KeywordIdentifier -> {
    /** @var TokenInterface $children */
    $this->assertFeature(Feature::KeywordIdentifiers, $source, $children->offset, $children->size);

    return $children;
}
  : <T_BOOL> | <T_TRUE> | <T_FALSE> | <T_NULLPTR> | <T_ALIGNAS> | <T_ALIGNOF> | <T_TYPEOF>
  | <T_TYPEOF_UNQUAL> | <T_STATIC_ASSERT> | <T_GENERIC> | <T_BITINT> | <T_DECIMAL_NX> | <T_DECIMAL_N>
  | <T_FLOAT_NX> | <T_FLOAT_N> | <T_ASM> | <T_CONSTEXPR> | <T_THREAD_LOCAL> | <T_IMAGINARY>
  | <T_FORCE_INLINE> | <T_POINTER_MODIFIER> | <T_REAL> | <T_IMAG> | <T_BASED> | <T_NULLABILITY> | <T_PTRAUTH>
  ;

