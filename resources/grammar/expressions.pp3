/**
 * -----------------------------------------------------------------------------
 *  Constant expressions, 6.5 and 6.6.
 * -----------------------------------------------------------------------------
 *
 *  The constant expressions of 6.6p3 without the assignment, the increment,
 *  the decrement and the function call: "(T)(x)" is always a cast. The comma
 *  operator is included. _Generic (6.5.2.1) is not supported.
 *
 *  A node starts where its rule does ($offset): the parentheses belong to no
 *  node, and the node that contains them starts at them. The binary
 *  operators are the exception, see BinaryExpression.
 */

/**
 * 6.5.18 Comma operator, only allowed in parentheses, in a subscript and
 * between "?" and ":"
 */
Expression -> {
    /** @var non-empty-list<Expression\ExpressionInterface> $children */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $result = new BinaryExpression\CommaExpression($result, $children[$i], $offset);
    }

    return $result;
}
  : ConditionalExpression() (
        ::T_COMMA:: ConditionalExpression()
    )*
  ;

/**
 * 6.5.16 Conditional operator, right-associative: a ? b : c ? d : e is
 * a ? b : (c ? d : e)
 */
ConditionalExpression @error("Syntax error, unexpected {token} in the expression") -> {
    /**
     * @var array{Expression\ExpressionInterface}|array{
     *     Expression\ExpressionInterface,
     *     Expression\ExpressionInterface,
     *     Expression\ExpressionInterface
     * } $children
     */
    if (\count($children) === 1) {
        return $children[0];
    }

    return new Expression\ConditionalExpression($children[0], $children[1], $children[2], $offset);
}
  : BinaryExpression() (
        ::T_QUESTION:: Expression()
        ::T_COLON:: ConditionalExpression()
    )?
  ;

/**
 * 6.5.6 to 6.5.15 Binary operators, all the levels of precedence in one
 * rule: the operands and the operators are read as a flat sequence, and the
 * reducer builds the tree by precedence, every level left-associative:
 * a - b - c is (a - b) - c, a + b * c is a + (b * c).
 *
 * A node starts where its left operand does: the leftmost one at the start
 * of the rule, its parenthesis included, any other one at its own node. In
 * "a + (b) * c" the product starts at "b".
 */
BinaryExpression -> {
    /** @var non-empty-list<Expression\ExpressionInterface|TokenInterface> $children */
    if (\count($children) === 1) {
        // A single operand, an expression of a higher precedence
        \assert($children[0] instanceof Expression\ExpressionInterface);

        return $children[0];
    }

    $precedence = static fn(TokenInterface $operator): int => match ($operator->id) {
        self::T_ASTERISK, self::T_SLASH, self::T_PERCENT => 10,
        self::T_PLUS, self::T_MINUS => 9,
        self::T_SHL, self::T_SHR => 8,
        self::T_LESS, self::T_GREATER, self::T_LESS_EQUAL, self::T_GREATER_EQUAL => 7,
        self::T_EQUAL, self::T_NOT_EQUAL => 6,
        self::T_AMPERSAND => 5,
        self::T_CARET => 4,
        self::T_PIPE => 3,
        self::T_LOGICAL_AND => 2,
        default => 1,
    };

    $build = static fn(
        TokenInterface $operator,
        Expression\ExpressionInterface $left,
        Expression\ExpressionInterface $right,
        int $start,
    ): Expression\ExpressionInterface => match ($operator->id) {
        self::T_ASTERISK => new BinaryExpression\MulExpression($left, $right, $start),
        self::T_SLASH => new BinaryExpression\DivExpression($left, $right, $start),
        self::T_PERCENT => new BinaryExpression\RemExpression($left, $right, $start),
        self::T_PLUS => new BinaryExpression\AddExpression($left, $right, $start),
        self::T_MINUS => new BinaryExpression\SubExpression($left, $right, $start),
        self::T_SHL => new BinaryExpression\ShiftLeftExpression($left, $right, $start),
        self::T_SHR => new BinaryExpression\ShiftRightExpression($left, $right, $start),
        self::T_LESS => new BinaryExpression\LessExpression($left, $right, $start),
        self::T_GREATER => new BinaryExpression\GreaterExpression($left, $right, $start),
        self::T_LESS_EQUAL => new BinaryExpression\LessOrEqualExpression($left, $right, $start),
        self::T_GREATER_EQUAL => new BinaryExpression\GreaterOrEqualExpression($left, $right, $start),
        self::T_EQUAL => new BinaryExpression\EqualExpression($left, $right, $start),
        self::T_NOT_EQUAL => new BinaryExpression\NotEqualExpression($left, $right, $start),
        self::T_AMPERSAND => new BinaryExpression\BitwiseAndExpression($left, $right, $start),
        self::T_CARET => new BinaryExpression\BitwiseXorExpression($left, $right, $start),
        self::T_PIPE => new BinaryExpression\BitwiseOrExpression($left, $right, $start),
        self::T_LOGICAL_AND => new BinaryExpression\LogicalAndExpression($left, $right, $start),
        default => new BinaryExpression\LogicalOrExpression($left, $right, $start),
    };

    // The operands built so far with their starts, and the operators that
    // wait for their right operand, of an ascending precedence. Even
    // children are the operands and odd ones the operators.
    /** @var non-empty-list<Expression\ExpressionInterface> $operands */
    $operands = [$children[0]];
    $starts = [$offset];
    /** @var list<TokenInterface> $operators */
    $operators = [];
    $depth = 0;

    // Past the last operand every operator waiting is built, as if the
    // input ended with an operator of the loosest precedence of all
    for ($i = 1, $count = \count($children); ; $i += 2) {
        $current = 0;

        if ($i < $count) {
            \assert($children[$i] instanceof TokenInterface);

            $current = $precedence($children[$i]);
        }

        while ($depth > 0 && $precedence($operators[$depth - 1]) >= $current) {
            --$depth;
            $operands[$depth] = $build($operators[$depth], $operands[$depth], $operands[$depth + 1], $starts[$depth]);
        }

        if ($i >= $count) {
            break;
        }

        \assert($children[$i] instanceof TokenInterface && $children[$i + 1] instanceof Expression\ExpressionInterface);

        $operators[$depth] = $children[$i];
        ++$depth;
        $operands[$depth] = $children[$i + 1];
        $starts[$depth] = $children[$i + 1]->offset;
    }

    return $operands[0];
}
  : CastOrUnaryExpression() (BinaryOperator() CastOrUnaryExpression())*
  ;

BinaryOperator
  : <T_ASTERISK> | <T_SLASH> | <T_PERCENT> | <T_PLUS> | <T_MINUS> | <T_SHL> | <T_SHR>
  | <T_LESS> | <T_GREATER> | <T_LESS_EQUAL> | <T_GREATER_EQUAL> | <T_EQUAL> | <T_NOT_EQUAL>
  | <T_AMPERSAND> | <T_CARET> | <T_PIPE> | <T_LOGICAL_AND> | <T_LOGICAL_OR>
  ;

CastOrUnaryExpression @error("Syntax error, unexpected {token} in the expression")
  : CastExpression()
  | UnaryExpression()
  ;

/**
 * 6.5.5 Cast operators, (T)x, and 6.5.3.6 Compound literals, (T){1}. A type
 * name that cannot be an expression makes a cast: "(int)-x", "(T *)-x". A
 * type name that reads as an expression other than a lone identifier is
 * never a cast (see ExpressionLikeTypeName). A lone identifier "(T)" is a
 * cast only when the next token can start an operand but cannot continue a
 * parenthesized expression (CastStart): "(T)-x" is a subtraction, "(x)[0]"
 * is a subscript.
 */
CastExpression -> {
    /**
     * @var array{TokenInterface, Type\TypeInterface, Expression\ExpressionInterface}
     *     |array{
     *         TokenInterface,
     *         Type\TypeInterface,
     *         \Closure(TokenInterface, Type\TypeInterface): Expression\ExpressionInterface
     *     } $children
     */
    if ($children[2] instanceof \Closure) {
        return $children[2]($children[0], $children[1]);
    }

    return new Expression\CastExpression($children[1], $children[2], $offset);
}
  : <T_LPAREN> (!LoneIdentifier() !ExpressionLikeTypeName() | &LoneIdentifierCast()) TypeName() ::T_RPAREN::
        (CompoundLiteral() | CastOrUnaryExpression())
  ;

LoneIdentifier
  : <T_IDENTIFIER> <T_RPAREN>
  ;

LoneIdentifierCast
  : <T_IDENTIFIER> <T_RPAREN> CastStart()
  ;

CastStart
  : <T_IDENTIFIER> | <T_LPAREN>
  | <T_DEC_INT_LITERAL> | <T_HEX_INT_LITERAL> | <T_OCT_INT_LITERAL> | <T_BIN_INT_LITERAL>
  | <T_DEC_FLOAT_LITERAL> | <T_HEX_FLOAT_LITERAL> | <T_CHAR_LITERAL> | <T_STRING_LITERAL>
  | <T_TRUE> | <T_FALSE> | <T_NULLPTR>
  | <T_TILDE> | <T_EXCLAMATION> | <T_SIZEOF> | <T_ALIGNOF> | <T_BUILTIN_OFFSETOF> | <T_LBRACE>
  ;

/**
 * The braces of a compound literal after its type name, and the postfix
 * operators applied to the literal: (struct S){1}.a. A function from the
 * parenthesis and the type name to the expression.
 */
CompoundLiteral -> {
    /**
     * @var list{
     *     Initializer\InitializerList,
     *     ...<\Closure(Expression\ExpressionInterface, int): Expression\ExpressionInterface>
     * } $children
     */
    return static function (
        TokenInterface $parenthesis,
        Type\TypeInterface $type,
    ) use ($children): Expression\ExpressionInterface {
        $result = new Expression\CompoundLiteralExpression($type, $children[0], $parenthesis->offset);

        for ($i = 1, $count = \count($children); $i < $count; ++$i) {
            $result = $children[$i]($result, $parenthesis->offset);
        }

        return $result;
    };
}
  : InitializerList() PostfixOperator()*
  ;

/**
 * 6.5.4 Unary operators
 */
UnaryExpression
  : PlusExpression()
  | MinusExpression()
  | LogicalNotExpression()
  | BitwiseNotExpression()
  | DereferenceExpression()
  | AddressOfExpression()
  | SizeOfTypeExpression()
  | SizeOfExpression()
  | AlignOfTypeExpression()
  | AlignOfExpression()
  | PostfixExpression()
  ;

/**
 * +x
 */
PlusExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\PlusExpression($children[1], $offset);
}
  : <T_PLUS> CastOrUnaryExpression()
  ;

/**
 * -x
 */
MinusExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\MinusExpression($children[1], $offset);
}
  : <T_MINUS> CastOrUnaryExpression()
  ;

/**
 * !x
 */
LogicalNotExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\LogicalNotExpression($children[1], $offset);
}
  : <T_EXCLAMATION> CastOrUnaryExpression()
  ;

/**
 * ~x
 */
BitwiseNotExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\BitwiseNotExpression($children[1], $offset);
}
  : <T_TILDE> CastOrUnaryExpression()
  ;

/**
 * *p
 */
DereferenceExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\DereferenceExpression($children[1], $offset);
}
  : <T_ASTERISK> CastOrUnaryExpression()
  ;

/**
 * &x
 */
AddressOfExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new UnaryExpression\AddressOfExpression($children[1], $offset);
}
  : <T_AMPERSAND> CastOrUnaryExpression()
  ;

/**
 * 6.5.4.4 The sizeof and alignof operators, sizeof(T). A single name in
 * parentheses is read as a type unless a postfix operator follows it:
 * sizeof(x)[0] is sizeof((x)[0]). A brace after the type name makes the
 * operand a compound literal, sizeof (int){1}.
 */
SizeOfTypeExpression -> {
    /**
     * @var array{TokenInterface, TokenInterface, Type\TypeInterface}
     *     |array{
     *         TokenInterface,
     *         TokenInterface,
     *         Type\TypeInterface,
     *         \Closure(TokenInterface, Type\TypeInterface): Expression\ExpressionInterface
     *     } $children
     */
    if (isset($children[3])) {
        return new Expression\SizeOfExpression($children[3]($children[1], $children[2]), $offset);
    }

    return new Expression\SizeOfTypeExpression($children[2], $offset);
}
  : <T_SIZEOF> <T_LPAREN> !ExpressionLikeTypeName() TypeName() ::T_RPAREN::
        (CompoundLiteral() | !PostfixOperatorStart())
  ;

/**
 * 6.5.4.4 The sizeof and alignof operators, sizeof x
 */
SizeOfExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new Expression\SizeOfExpression($children[1], $offset);
}
  : <T_SIZEOF> UnaryExpression()
  ;

/**
 * 6.5.4.4 The sizeof and alignof operators, alignof(T), also spelled
 * _Alignof and __alignof__. The operand is read as in sizeof, an
 * expression is allowed as well, as GCC does.
 */
AlignOfTypeExpression -> {
    /**
     * @var array{TokenInterface, TokenInterface, Type\TypeInterface}
     *     |array{
     *         TokenInterface,
     *         TokenInterface,
     *         Type\TypeInterface,
     *         \Closure(TokenInterface, Type\TypeInterface): Expression\ExpressionInterface
     *     } $children
     */
    if (isset($children[3])) {
        return new Expression\AlignOfExpression($children[3]($children[1], $children[2]), $offset);
    }

    return new Expression\AlignOfTypeExpression($children[2], $offset);
}
  : <T_ALIGNOF> <T_LPAREN> !ExpressionLikeTypeName() TypeName() ::T_RPAREN::
        (CompoundLiteral() | !PostfixOperatorStart())
  ;

/**
 * GCC: __alignof__ x
 */
AlignOfExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return new Expression\AlignOfExpression($children[1], $offset);
}
  : <T_ALIGNOF> UnaryExpression()
  ;

/**
 * 6.5.3 Postfix operators, a[i], s.member, p->member. Every node of the
 * chain starts where the whole expression does.
 */
PostfixExpression -> {
    /**
     * @var list{
     *     Expression\ExpressionInterface,
     *     ...<\Closure(Expression\ExpressionInterface, int): Expression\ExpressionInterface>
     * } $children
     */
    $result = $children[0];

    for ($i = 1, $count = \count($children); $i < $count; ++$i) {
        $result = $children[$i]($result, $offset);
    }

    return $result;
}
  : PrimaryExpression() PostfixOperator()*
  ;

/**
 * A postfix operator is a function from its operand and the start of the
 * whole expression to the expression, applied by a postfix expression and
 * by a compound literal
 */
PostfixOperator
  : SubscriptOperator()
  | DirectMemberOperator()
  | PointerMemberOperator()
  ;

SubscriptOperator -> {
    /** @var array{Expression\ExpressionInterface} $children */
    return static function (Expression\ExpressionInterface $operand, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new Expression\SubscriptExpression($operand, $children[0], $start);
    };
}
  : ::T_LBRACKET:: Expression() ::T_RBRACKET::
  ;

DirectMemberOperator -> {
    /** @var array{Node\Identifier} $children */
    return static function (Expression\ExpressionInterface $operand, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new MemberExpression\DirectMemberExpression($operand, $children[0], $start);
    };
}
  : ::T_DOT:: Identifier()
  ;

PointerMemberOperator -> {
    /** @var array{Node\Identifier} $children */
    return static function (Expression\ExpressionInterface $operand, int $start) use ($children): Expression\ExpressionInterface {
        \assert($start >= 0);

        return new MemberExpression\PointerMemberExpression($operand, $children[0], $start);
    };
}
  : ::T_ARROW:: Identifier()
  ;

PostfixOperatorStart
  : <T_LBRACKET> | <T_DOT> | <T_ARROW>
  ;

/**
 * 6.5.2 Primary expressions
 */
PrimaryExpression
  : IdentifierExpression()
  | Constant()
  | ConcatenatedStringLiteral()
  | ParenthesizedExpression()
  | OffsetOfExpression()
  ;

/**
 * GCC: __builtin_offsetof(struct S, a.b[2]), what the offsetof macro of
 * <stddef.h> expands to. The first member of the path, written without a
 * dot, is the first member designator.
 */
OffsetOfExpression -> {
    /**
     * @var list{
     *     TokenInterface,
     *     Type\TypeInterface,
     *     Node\Identifier,
     *     ...<DesignatedInitializer\Designator>
     * } $children
     */
    $designators = [new DesignatedInitializer\Designator\MemberDesignator($children[2], $children[2]->offset)];

    for ($i = 3, $count = \count($children); $i < $count; ++$i) {
        $designators[] = $children[$i];
    }

    return new Expression\OffsetOfExpression(
        $children[1],
        new DesignatedInitializer\DesignatorList($designators, $children[2]->offset),
        $offset,
    );
}
  : <T_BUILTIN_OFFSETOF> ::T_LPAREN:: TypeName() ::T_COMMA:: Identifier() Designator()* ::T_RPAREN::
  ;

ParenthesizedExpression -> {
    /** @var array{TokenInterface, Expression\ExpressionInterface} $children */
    return $children[1];
}
  : <T_LPAREN> Expression() ::T_RPAREN::
  ;

IdentifierExpression -> {
    /** @var array{Node\Identifier} $children */
    return new Expression\IdentifierExpression($children[0], $offset);
}
  : Identifier()
  ;

/**
 * A name by itself, not an expression: it is also the member of a member
 * access and the name of a type
 */
Identifier -> {
    /** @var TokenInterface $children */
    // @phpstan-ignore-next-line the lexer never yields an empty token, but the contract types its value as string
    return new Node\Identifier($children->value, $offset);
}
  : <T_IDENTIFIER>
  ;

