/**
 * -----------------------------------------------------------------------------
 *  Lexemes of C23, see ISO/IEC 9899:2024, 6.4.
 * -----------------------------------------------------------------------------
 *
 *  The lexer works with bytes (see the root grammar): a non-ASCII character
 *  of an identifier is a sequence of bytes in \x80-\xFF, the end of a
 *  keyword is a lookahead that covers such bytes.
 */

/**
 * -----------------------------------------------------------------------------
 *  Fragments
 * -----------------------------------------------------------------------------
 */

/**
 * A universal character name, 6.4.3
 */
%fragment UCN               \\u[0-9A-Fa-f]{4}|\\U[0-9A-Fa-f]{8}
%fragment ID_START          [A-Za-z_\x80-\xFF]|(?&UCN)
%fragment ID_CONTINUE       [A-Za-z0-9_\x80-\xFF]|(?&UCN)
/**
 * What may not directly follow a keyword, the rest of an identifier
 */
%fragment KEYWORD_END       (?![A-Za-z0-9_\x80-\xFF]|\\[uU])
/**
 * What may not directly follow a number: the rest of a number of the
 * preprocessor (6.4.8), a quote, a dot and a sign after "e" or "p". "1.2.3"
 * is not two constants and "0xE+1" is not a sum.
 */
%fragment NUMBER_END        (?![A-Za-z0-9_\x80-\xFF'.]|\\[uU]|(?<=[eEpP])[+-])

/**
 * Digit sequences with optional digit separators, 6.4.4.2
 */
%fragment DEC_DIGITS        [0-9](?:'?[0-9])*+
%fragment HEX_DIGITS        [0-9A-Fa-f](?:'?[0-9A-Fa-f])*+

/**
 * Escape sequences, 6.4.4.5
 */
%fragment SIMPLE_ESCAPE     ['"?\\abfnrtv]
%fragment NUMERIC_ESCAPE    [0-7]{1,3}|x[0-9A-Fa-f]++
%fragment ESCAPE            \\(?:(?&SIMPLE_ESCAPE)|(?&NUMERIC_ESCAPE))|(?&UCN)

/**
 * Integer constants, 6.4.4.2
 */
%fragment HEX_INT           0[xX](?&HEX_DIGITS)
%fragment BIN_INT           0[bB][01](?:'?[01])*+
%fragment OCT_INT           0(?:'?[0-7])*+
%fragment DEC_INT           [1-9](?:'?[0-9])*+
%fragment INT_SIZE          ll|LL|[lL]|wb|WB
%fragment INT_TYPE_SUFFIX   [uU](?&INT_SIZE)?|(?&INT_SIZE)[uU]?
/**
 * GCC: the suffix of an imaginary constant, 2.0i or 3j, before or after the
 * suffix of the type
 */
%fragment IMAGINARY_SUFFIX  [iIjJ]
%fragment INT_SUFFIX        (?&INT_TYPE_SUFFIX)(?&IMAGINARY_SUFFIX)?|(?&IMAGINARY_SUFFIX)(?&INT_TYPE_SUFFIX)?

/**
 * Floating constants, 6.4.4.3
 */
%fragment DEC_FRACTION      (?&DEC_DIGITS)?\.(?&DEC_DIGITS)|(?&DEC_DIGITS)\.
%fragment HEX_SIGNIFICAND   (?&HEX_DIGITS)?\.(?&HEX_DIGITS)|(?&HEX_DIGITS)\.?
%fragment DEC_EXPONENT      [eE][+-]?(?&DEC_DIGITS)
%fragment BIN_EXPONENT      [pP][+-]?(?&DEC_DIGITS)
%fragment DEC_FLOAT         (?&DEC_FRACTION)(?&DEC_EXPONENT)?|(?&DEC_DIGITS)(?&DEC_EXPONENT)
%fragment HEX_FLOAT         0[xX](?&HEX_SIGNIFICAND)(?&BIN_EXPONENT)
%fragment DECIMAL_SUFFIX    [dD](?:128x?|64x?|32)|df|DF|dd|DD|dl|DL
%fragment FLOAT_TYPE_SUFFIX [fF](?:128x?|64x?|32x?|16)|(?&DECIMAL_SUFFIX)|[fFlL]
%fragment FLOAT_SUFFIX      (?&FLOAT_TYPE_SUFFIX)(?&IMAGINARY_SUFFIX)?|(?&IMAGINARY_SUFFIX)(?&FLOAT_TYPE_SUFFIX)?

/**
 * Keywords of statements other than "default", 6.4.1
 */
%fragment STATEMENT_KEYWORD break|case|continue|do|else|for|goto|if|return|switch|while

/**
 * Keywords of the compiler extensions that are attributes by themselves
 */
%fragment CALLING_CONVENTION __cdecl|__clrcall|__stdcall|__fastcall|__thiscall|__vectorcall|__regcall|__pascal|_cdecl|_stdcall|_fastcall
%fragment POINTER_MODIFIER   __ptr32|__ptr64|__sptr|__uptr|__unaligned|__w64|__far|__near|__huge
%fragment NULLABILITY        _Nonnull|_Nullable_result|_Nullable|_Null_unspecified

/**
 * -----------------------------------------------------------------------------
 *  Preprocessing leftovers
 * -----------------------------------------------------------------------------
 */

/**
 * A line starting with "#" or its digraph "%:": line markers of "gcc -E"
 * (# 1 "file.h" 3), #pragma, #define of "gcc -dD", with the indentation of
 * the line and without its newline. A backslash continues the directive
 * onto the next line, whether the line ends with LF or CRLF, the CR of a
 * CRLF ending is not a part of the directive. The first line may also
 * start after the byte order mark. Must be declared before the whitespace.
 */
%fragment LINE_START       ^|(?<=\A\xEF\xBB\xBF)
%fragment DIRECTIVE_BODY   (?:[^\\\r\n]++|\\(?:\r\n|.)|\r(?!\n))*+
%token T_DIRECTIVE          (?&LINE_START)[\x20\t\f\x0B]*+(?:\x23|%:)(?&DIRECTIVE_BODY) -> channel(Directive)

/**
 * The pragma operator, _Pragma("pack(1)") of C (6.10.11) and
 * __pragma(pack(1)) of MSVC, a directive written inside a line: the
 * keyword and its operand in balanced parentheses, nested at most three
 * levels deep
 */
%fragment PRAGMA_ATOM      [^()"']++|"(?:[^"\\\n]|\\.)*+"|'(?:[^'\\\n]|\\.)*+'
%fragment PRAGMA_GROUP     \((?:(?&PRAGMA_ATOM)|\((?:(?&PRAGMA_ATOM))*+\))*+\)
%fragment PRAGMA_OPERAND   \((?:(?&PRAGMA_ATOM)|(?&PRAGMA_GROUP))*+\)
%token T_PRAGMA_OPERATOR    (?:_Pragma|__pragma)[\x20\t\r\n\f\x0B]*+(?&PRAGMA_OPERAND) -> channel(Directive)

/**
 * -----------------------------------------------------------------------------
 *  Whitespace and comments
 * -----------------------------------------------------------------------------
 */

/**
 * The byte order mark an editor may put at the beginning of the file
 */
%skip T_BYTE_ORDER_MARK     \A\xEF\xBB\xBF
/**
 * Comments, 6.4.9
 */
%skip T_COMMENT_LINE        //[^\n]*+
%skip T_COMMENT_BLOCK       /\*(?:[^*]++|\*(?!/))*+\*/
%skip T_NEWLINE             \n++
%skip T_WHITESPACE          [\x20\t\r\f\x0B]++

/**
 * -----------------------------------------------------------------------------
 *  Punctuators, 6.4.6
 * -----------------------------------------------------------------------------
 *
 *  The order of declaration is the order of the expected tokens in a syntax
 *  error: the ones that end or separate something (";", ",", ")") go first.
 *  A longer punctuator goes before the ones it starts with, the dot before a
 *  digit is a floating constant (.5). Digraphs (<: :> <% %>) are spellings
 *  of the brackets and braces and share their tokens. The "#" and "##"
 *  punctuators and their digraphs (%: %:%:) are not tokens, "#" and "%:"
 *  only start a directive (T_DIRECTIVE).
 */

%token T_SEMICOLON          ;
%token T_COMMA              ,
%token T_RPAREN             \)
%token T_RBRACE             \}|%>
%token T_RBRACKET           \]|:>
%token T_LPAREN             \(
%token T_LBRACE             \{|<%
/**
 * The start of an attribute specifier (6.7.13.2): two brackets with any
 * whitespace between them
 */
%token T_ATTRIBUTE_START    (?:\[|<:)[\x20\t\r\n\f\x0B]*+(?:\[|<:)
%token T_LBRACKET           \[|<:
%token T_ELLIPSIS           \.\.\.
%token T_DOT                \.(?![0-9])
%token T_ARROW              ->
%token T_INCREMENT          \+\+
%token T_DECREMENT          --
%token T_SHL_ASSIGN         <<=
%token T_SHR_ASSIGN         >>=
%token T_SHL                <<
%token T_SHR                >>
%token T_LESS_EQUAL         <=
%token T_GREATER_EQUAL      >=
%token T_EQUAL              ==
%token T_NOT_EQUAL          !=
%token T_LOGICAL_AND        &&
%token T_LOGICAL_OR         \|\|
%token T_MUL_ASSIGN         \*=
%token T_DIV_ASSIGN         /=
%token T_MOD_ASSIGN         %=
%token T_ADD_ASSIGN         \+=
%token T_SUB_ASSIGN         -=
%token T_AND_ASSIGN         &=
%token T_XOR_ASSIGN         \^=
%token T_OR_ASSIGN          \|=
%token T_DOUBLE_COLON       ::
%token T_AMPERSAND          &
%token T_ASTERISK           \*
%token T_PLUS               \+
%token T_MINUS              -
%token T_TILDE              ~
%token T_EXCLAMATION        !
%token T_SLASH              /
%token T_PERCENT            %
%token T_LESS               <
%token T_GREATER            >
%token T_CARET              \^
%token T_PIPE               \|
%token T_QUESTION           \?
%token T_COLON              :
%token T_ASSIGN             =

/**
 * -----------------------------------------------------------------------------
 *  Literals, 6.4.4 and 6.4.5
 * -----------------------------------------------------------------------------
 *
 *  Declared before keywords and identifiers, with the encoding prefixes
 *  (u8"..."). A constant of each base is a token of its own, the base is
 *  the class of its node.
 */

%token T_HEX_FLOAT_LITERAL  (?&HEX_FLOAT)(?&FLOAT_SUFFIX)?(?&NUMBER_END)
%token T_DEC_FLOAT_LITERAL  (?&DEC_FLOAT)(?&FLOAT_SUFFIX)?(?&NUMBER_END)
%token T_HEX_INT_LITERAL    (?&HEX_INT)(?&INT_SUFFIX)?(?&NUMBER_END)
%token T_BIN_INT_LITERAL    (?&BIN_INT)(?&INT_SUFFIX)?(?&NUMBER_END)
%token T_OCT_INT_LITERAL    (?&OCT_INT)(?&INT_SUFFIX)?(?&NUMBER_END)
%token T_DEC_INT_LITERAL    (?&DEC_INT)(?&INT_SUFFIX)?(?&NUMBER_END)
%token T_CHAR_LITERAL       (?:u8|[uUL])?'(?:[^'\\\n]|(?&ESCAPE))++'
%token T_STRING_LITERAL     (?:u8|[uUL])?"(?:[^"\\\n]|(?&ESCAPE))*+"

/**
 * A character constant or a string literal that is not closed on its line
 * or holds an unknown escape sequence, "text or "\q": a single invalid
 * token up to the closing quote or the end of the line
 */
%token T_INVALID_CHAR_LITERAL (?:u8|[uUL])?'(?:[^'\\\n]|\\[^\n]?)*+'?
%token T_INVALID_STRING_LITERAL (?:u8|[uUL])?"(?:[^"\\\n]|\\[^\n]?)*+"?

/**
 * A number of the preprocessor (6.4.8) that is no constant, such as "08",
 * "1.2.3" or "0x1p", as a single token. It is only valid in the arguments
 * of an attribute: availability(macos, introduced=10.13.4).
 */
%token T_PP_NUMBER          \.?[0-9](?:[eEpP][+-]|'[A-Za-z0-9_\x80-\xFF]|[A-Za-z0-9_.\x80-\xFF]|(?&UCN))*+

/**
 * -----------------------------------------------------------------------------
 *  Keywords, 6.4.1
 * -----------------------------------------------------------------------------
 *
 *  Alternative spellings of the same keyword (bool and _Bool) share a
 *  token, the exact spelling is kept by the value of the token. The
 *  spellings of GCC (__const__, __inline, __typeof__, __thread...) are
 *  alternative spellings as well.
 */

%token T_ALIGNAS            (?:alignas|_Alignas)(?&KEYWORD_END)
%token T_ALIGNOF            (?:alignof|_Alignof|__alignof__|__alignof)(?&KEYWORD_END)
%token T_AUTO               auto(?&KEYWORD_END)
%token T_BOOL               (?:bool|_Bool)(?&KEYWORD_END)
%token T_CHAR               char(?&KEYWORD_END)
%token T_CONST              (?:const|__const__|__const)(?&KEYWORD_END)
%token T_CONSTEXPR          constexpr(?&KEYWORD_END)
%token T_DEFAULT            default(?&KEYWORD_END)
%token T_DOUBLE             double(?&KEYWORD_END)
%token T_ENUM               enum(?&KEYWORD_END)
%token T_EXTERN             extern(?&KEYWORD_END)
%token T_FALSE              false(?&KEYWORD_END)
%token T_FLOAT              float(?&KEYWORD_END)
%token T_INLINE             (?:inline|__inline__|__inline)(?&KEYWORD_END)
%token T_INT                int(?&KEYWORD_END)
%token T_LONG               long(?&KEYWORD_END)
%token T_NULLPTR            nullptr(?&KEYWORD_END)
%token T_REGISTER           register(?&KEYWORD_END)
%token T_RESTRICT           (?:restrict|__restrict__|__restrict)(?&KEYWORD_END)
%token T_SHORT              short(?&KEYWORD_END)
%token T_SIGNED             (?:signed|__signed__|__signed)(?&KEYWORD_END)
%token T_SIZEOF             sizeof(?&KEYWORD_END)
%token T_STATIC_ASSERT      (?:static_assert|_Static_assert)(?&KEYWORD_END)
%token T_STATIC             static(?&KEYWORD_END)
%token T_STRUCT             struct(?&KEYWORD_END)
%token T_THREAD_LOCAL       (?:thread_local|_Thread_local|__thread)(?&KEYWORD_END)
%token T_TRUE               true(?&KEYWORD_END)
%token T_TYPEDEF            typedef(?&KEYWORD_END)
%token T_TYPEOF_UNQUAL      (?:typeof_unqual|__typeof_unqual__|__typeof_unqual)(?&KEYWORD_END)
%token T_TYPEOF             (?:typeof|__typeof__|__typeof)(?&KEYWORD_END)
%token T_UNION              union(?&KEYWORD_END)
%token T_UNSIGNED           unsigned(?&KEYWORD_END)
%token T_VOID               void(?&KEYWORD_END)
%token T_VOLATILE           (?:volatile|__volatile__|__volatile)(?&KEYWORD_END)
/**
 * 6.7.3.5p4: _Atomic followed by a parenthesis is the atomic type
 * specifier, _Atomic(T), any other _Atomic is the qualifier
 */
%token T_ATOMIC_SPECIFIER   _Atomic(?=[\x20\t\r\n\f\x0B]*+\()
%token T_ATOMIC             _Atomic(?&KEYWORD_END)
%token T_BITINT             _BitInt(?&KEYWORD_END)
%token T_COMPLEX            (?:_Complex|__complex__|__complex)(?&KEYWORD_END)
%token T_DECIMAL128         _Decimal128(?&KEYWORD_END)
%token T_DECIMAL32          _Decimal32(?&KEYWORD_END)
%token T_DECIMAL64          _Decimal64(?&KEYWORD_END)
%token T_GENERIC            _Generic(?&KEYWORD_END)
%token T_IMAGINARY          _Imaginary(?&KEYWORD_END)
%token T_NORETURN           _Noreturn(?&KEYWORD_END)

/**
 * Keywords of the compiler extensions: GCC attributes, assembler labels,
 * MSVC attributes
 */
%token T_ATTRIBUTE          (?:__attribute__|__attribute)(?&KEYWORD_END)
%token T_ASM                (?:__asm__|__asm|asm)(?&KEYWORD_END)
%token T_DECLSPEC           __declspec(?&KEYWORD_END)

/**
 * The name of a built-in function of a compiler followed by its parenthesis,
 * __builtin_offsetof(...). Without the parenthesis it is an identifier, as
 * the __builtin_va_list type is.
 */
%token T_BUILTIN_CALL       __builtin_[A-Za-z0-9_\x80-\xFF]++(?=[\x20\t\r\n\f\x0B]*+\()

/**
 * Attributes spelled by a keyword alone, whatever compiler they come from:
 * calling conventions, modifiers of pointers, the nullability of Clang
 * and __forceinline
 */
%token T_CALLING_CONVENTION (?:(?&CALLING_CONVENTION))(?&KEYWORD_END)
%token T_POINTER_MODIFIER   (?:(?&POINTER_MODIFIER))(?&KEYWORD_END)
/**
 * Modifiers of a pointer with arguments: the based pointers of MSVC,
 * __based(base), and the pointer authentication of Clang,
 * __ptrauth(key, address, discriminator)
 */
%token T_POINTER_MODIFIER_WITH_ARGUMENTS (?:__based|__ptrauth)(?&KEYWORD_END)
%token T_NULLABILITY        (?:(?&NULLABILITY))(?&KEYWORD_END)
%token T_FORCE_INLINE       __forceinline(?&KEYWORD_END)

/**
 * The marker of GCC that silences the warnings about the extensions in what
 * follows. It has no meaning of its own and is skipped wherever it is.
 */
%skip T_EXTENSION           __extension__(?&KEYWORD_END)

/**
 * Keywords of statements: reserved, not identifiers
 */
%token T_RESERVED_KEYWORD   (?:(?&STATEMENT_KEYWORD))(?&KEYWORD_END)

/**
 * -----------------------------------------------------------------------------
 *  Identifiers, 6.4.2
 * -----------------------------------------------------------------------------
 */

%token T_IDENTIFIER         (?&ID_START)(?&ID_CONTINUE)*+
