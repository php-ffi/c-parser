//
// Lexemes of C23, see ISO/IEC 9899:2024, 6.4.
//
// The lexer works with bytes (see the root grammar), so a non-ASCII
// character of an identifier is a sequence of bytes in \x80-\xFF and
// keywords are guarded by a lookahead rather than by \b, which does not
// consider such bytes to be word characters.
//

//
// Fragments
//

// A universal character name, 6.4.3
%fragment UCN               \\u[0-9A-Fa-f]{4}|\\U[0-9A-Fa-f]{8}
%fragment ID_START          [A-Za-z_\x80-\xFF]|(?&UCN)
%fragment ID_CONTINUE       [A-Za-z0-9_\x80-\xFF]|(?&UCN)
// What may not directly follow a keyword, the rest of an identifier
%fragment KEYWORD_END       (?![A-Za-z0-9_\x80-\xFF]|\\[uU])
// What may not directly follow a number: a number of the preprocessor
// (6.4.8) also takes a quote and a dot, so "1.2.3" is not two constants
%fragment NUMBER_END        (?![A-Za-z0-9_\x80-\xFF'.]|\\[uU])

// Digit sequences with optional digit separators, 6.4.4.2
%fragment DEC_DIGITS        [0-9](?:'?[0-9])*+
%fragment HEX_DIGITS        [0-9A-Fa-f](?:'?[0-9A-Fa-f])*+

// Escape sequences, 6.4.4.5
%fragment SIMPLE_ESCAPE     ['"?\\abfnrtv]
%fragment NUMERIC_ESCAPE    [0-7]{1,3}|x[0-9A-Fa-f]++
%fragment ESCAPE            \\(?:(?&SIMPLE_ESCAPE)|(?&NUMERIC_ESCAPE))|(?&UCN)

// Integer constants, 6.4.4.2
%fragment HEX_INT           0[xX](?&HEX_DIGITS)
%fragment BIN_INT           0[bB][01](?:'?[01])*+
%fragment OCT_INT           0(?:'?[0-7])*+
%fragment DEC_INT           [1-9](?:'?[0-9])*+
%fragment INT_SIZE          ll|LL|[lL]|wb|WB
%fragment INT_SUFFIX        [uU](?&INT_SIZE)?|(?&INT_SIZE)[uU]?

// Floating constants, 6.4.4.3
%fragment DEC_FRACTION      (?&DEC_DIGITS)?\.(?&DEC_DIGITS)|(?&DEC_DIGITS)\.
%fragment HEX_SIGNIFICAND   (?&HEX_DIGITS)?\.(?&HEX_DIGITS)|(?&HEX_DIGITS)\.?
%fragment DEC_EXPONENT      [eE][+-]?(?&DEC_DIGITS)
%fragment BIN_EXPONENT      [pP][+-]?(?&DEC_DIGITS)
%fragment DEC_FLOAT         (?&DEC_FRACTION)(?&DEC_EXPONENT)?|(?&DEC_DIGITS)(?&DEC_EXPONENT)
%fragment HEX_FLOAT         0[xX](?&HEX_SIGNIFICAND)(?&BIN_EXPONENT)
%fragment DECIMAL_SUFFIX    [dD](?:128x?|64x?|32)|df|DF|dd|DD|dl|DL
%fragment FLOAT_SUFFIX      [fF](?:128x?|64x?|32x?|16)|(?&DECIMAL_SUFFIX)|[fFlL]

// Keywords of statements, 6.4.1
%fragment STATEMENT_KEYWORD break|case|continue|default|do|else|for|goto|if|return|switch|while

//
// Preprocessing leftovers
//

// A line starting with "#" or its digraph "%:": line markers of "gcc -E"
// (# 1 "file.h" 3), #pragma, #define of "gcc -dD". It is declared before
// the whitespace, which would otherwise consume the indentation of the
// line, and the newline is a separate token, so "^" (multiline mode) still
// holds at the beginning of the next line. A backslash continues the
// directive onto the next line, whether the line ends with LF or CRLF, and
// the CR of a CRLF ending is not a part of the directive. The first line
// may also start after the byte order mark. The vertical tab is written as
// \x0B, since \v of PCRE matches any vertical whitespace, newlines included.
%fragment LINE_START       ^|(?<=\A\xEF\xBB\xBF)
%fragment DIRECTIVE_BODY   (?:[^\\\r\n]++|\\(?:\r\n|.)|\r(?!\n))*+
%token T_DIRECTIVE          (?&LINE_START)[\x20\t\f\x0B]*+(?:\x23|%:)(?&DIRECTIVE_BODY) -> channel(Directive)

//
// Whitespace and comments
//

// The byte order mark an editor may put at the beginning of the file
%skip T_BYTE_ORDER_MARK     \A\xEF\xBB\xBF
// Comments, 6.4.9
%skip T_COMMENT_LINE        //[^\n]*+
// The block comment is matched without backtracking, so that a long one does
// not exhaust the backtrack limit of PCRE
%skip T_COMMENT_BLOCK       /\*(?:[^*]++|\*(?!/))*+\*/
%skip T_NEWLINE             \n++
%skip T_WHITESPACE          [\x20\t\r\f\x0B]++

//
// Literals, 6.4.4 and 6.4.5
//
// Declared before keywords and identifiers, since an encoding prefix
// (u8"...") looks like an identifier, and before punctuators, since a
// floating constant may start with a dot (.5). A constant of each base is
// a token of its own, the base is the class of its node.
//

%token T_HEX_FLOAT_LITERAL  (?&HEX_FLOAT)(?&FLOAT_SUFFIX)?(?&NUMBER_END)
%token T_DEC_FLOAT_LITERAL  (?&DEC_FLOAT)(?&FLOAT_SUFFIX)?(?&NUMBER_END)
%token T_HEX_INT_LITERAL    (?&HEX_INT)(?&INT_SUFFIX)?(?&NUMBER_END)
%token T_BIN_INT_LITERAL    (?&BIN_INT)(?&INT_SUFFIX)?(?&NUMBER_END)
%token T_OCT_INT_LITERAL    (?&OCT_INT)(?&INT_SUFFIX)?(?&NUMBER_END)
%token T_DEC_INT_LITERAL    (?&DEC_INT)(?&INT_SUFFIX)?(?&NUMBER_END)
%token T_CHAR_LITERAL       (?:u8|[uUL])?'(?:[^'\\\n]|(?&ESCAPE))++'
%token T_STRING_LITERAL     (?:u8|[uUL])?"(?:[^"\\\n]|(?&ESCAPE))*+"

//
// Keywords, 6.4.1
//
// Alternative spellings of the same keyword (bool and _Bool) share a
// token, the exact spelling is kept by the value of the token.
//

%token T_ALIGNAS            (?:alignas|_Alignas)(?&KEYWORD_END)
%token T_ALIGNOF            (?:alignof|_Alignof)(?&KEYWORD_END)
%token T_AUTO               auto(?&KEYWORD_END)
%token T_BOOL               (?:bool|_Bool)(?&KEYWORD_END)
%token T_CHAR               char(?&KEYWORD_END)
%token T_CONST              const(?&KEYWORD_END)
%token T_CONSTEXPR          constexpr(?&KEYWORD_END)
%token T_DOUBLE             double(?&KEYWORD_END)
%token T_ENUM               enum(?&KEYWORD_END)
%token T_EXTERN             extern(?&KEYWORD_END)
%token T_FALSE              false(?&KEYWORD_END)
%token T_FLOAT              float(?&KEYWORD_END)
%token T_INLINE             inline(?&KEYWORD_END)
%token T_INT                int(?&KEYWORD_END)
%token T_LONG               long(?&KEYWORD_END)
%token T_NULLPTR            nullptr(?&KEYWORD_END)
%token T_REGISTER           register(?&KEYWORD_END)
%token T_RESTRICT           restrict(?&KEYWORD_END)
%token T_SHORT              short(?&KEYWORD_END)
%token T_SIGNED             signed(?&KEYWORD_END)
%token T_SIZEOF             sizeof(?&KEYWORD_END)
%token T_STATIC_ASSERT      (?:static_assert|_Static_assert)(?&KEYWORD_END)
%token T_STATIC             static(?&KEYWORD_END)
%token T_STRUCT             struct(?&KEYWORD_END)
%token T_THREAD_LOCAL       (?:thread_local|_Thread_local)(?&KEYWORD_END)
%token T_TRUE               true(?&KEYWORD_END)
%token T_TYPEDEF            typedef(?&KEYWORD_END)
%token T_TYPEOF_UNQUAL      typeof_unqual(?&KEYWORD_END)
%token T_TYPEOF             typeof(?&KEYWORD_END)
%token T_UNION              union(?&KEYWORD_END)
%token T_UNSIGNED           unsigned(?&KEYWORD_END)
%token T_VOID               void(?&KEYWORD_END)
%token T_VOLATILE           volatile(?&KEYWORD_END)
%token T_ATOMIC             _Atomic(?&KEYWORD_END)
%token T_BITINT             _BitInt(?&KEYWORD_END)
%token T_COMPLEX            _Complex(?&KEYWORD_END)
%token T_DECIMAL128         _Decimal128(?&KEYWORD_END)
%token T_DECIMAL32          _Decimal32(?&KEYWORD_END)
%token T_DECIMAL64          _Decimal64(?&KEYWORD_END)
%token T_IMAGINARY          _Imaginary(?&KEYWORD_END)
%token T_NORETURN           _Noreturn(?&KEYWORD_END)

// Keywords of statements and of _Generic. Statements are not parsed and
// _Generic is not supported yet, but they are still reserved and may not be
// used as identifiers.
%token T_RESERVED_KEYWORD   (?:(?&STATEMENT_KEYWORD)|_Generic)(?&KEYWORD_END)

//
// Identifiers, 6.4.2
//

%token T_IDENTIFIER         (?&ID_START)(?&ID_CONTINUE)*+

//
// Punctuators, 6.4.6
//
// Longer punctuators go first. Digraphs (<: :> <% %>) are spellings of the
// brackets and braces and share their tokens. The "#" and "##" punctuators
// and their digraphs (%: %:%:) only exist in the preprocessor and are not
// tokens, "#" and "%:" only start a directive (T_DIRECTIVE).
//

%token T_ELLIPSIS           \.\.\.
%token T_ARROW              ->
%token T_INCREMENT          \+\+
%token T_DECREMENT          --
%token T_SHL_ASSIGN         <<=
%token T_SHR_ASSIGN         >>=
%token T_LBRACKET           \[|<:
%token T_RBRACKET           \]|:>
%token T_LBRACE             \{|<%
%token T_RBRACE             \}|%>
%token T_SHL                <<
%token T_SHR                >>
%token T_LESS_EQUAL         <=
%token T_GREATER_EQUAL      >=
%token T_EQUAL              ==
%token T_NOT_EQUAL          !=
%token T_LOGICAL_AND        &&
%token T_LOGICAL_OR         \|\|
%token T_MUL_ASSIGN         \*=
%token T_DIV_ASSIGN         /=
%token T_MOD_ASSIGN         %=
%token T_ADD_ASSIGN         \+=
%token T_SUB_ASSIGN         -=
%token T_AND_ASSIGN         &=
%token T_XOR_ASSIGN         \^=
%token T_OR_ASSIGN          \|=
%token T_DOUBLE_COLON       ::
%token T_LPAREN             \(
%token T_RPAREN             \)
%token T_DOT                \.
%token T_AMPERSAND          &
%token T_ASTERISK           \*
%token T_PLUS               \+
%token T_MINUS              -
%token T_TILDE              ~
%token T_EXCLAMATION        !
%token T_SLASH              /
%token T_PERCENT            %
%token T_LESS               <
%token T_GREATER            >
%token T_CARET              \^
%token T_PIPE               \|
%token T_QUESTION           \?
%token T_COLON              :
%token T_SEMICOLON          ;
%token T_ASSIGN             =
%token T_COMMA              ,
