/**
 * -----------------------------------------------------------------------------
 *  C23 (ISO/IEC 9899:2024) headers after preprocessing.
 * -----------------------------------------------------------------------------
 *
 *  The lexer works with bytes: offsets are byte offsets, and a header in any
 *  ASCII-compatible encoding (UTF-8, Latin-1, CP1251) is accepted.
 */

%pragma root TranslationUnit
%pragma lexer.pcre.disable Utf8

%include grammar/lexemes
%include grammar/literals
%include grammar/expressions
%include grammar/specifiers
%include grammar/declarators
%include grammar/declarations
%include grammar/attributes

/**
 * A sequence of external declarations. Its message describes what no rule
 * inside it does: a token that cannot start a declaration.
 */
TranslationUnit @error("Syntax error, unexpected {token}, a declaration expected")
  : ExternalDeclaration()*
  ;
