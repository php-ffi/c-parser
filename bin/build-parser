#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace FFI\Parser\Bin;

/**
 * Generates the parser from the grammar.
 *
 * The generated parser is committed, so the library itself does not need
 * `phplrt/compiler`. Run it (or `composer grammar:build`) after every change
 * of `resources/grammar.pp3` or `resources/grammar/*.pp3` and commit the
 * result along with the grammar.
 */

use Phplrt\Compiler\Compiler;
use Phplrt\Compiler\Generator\ClassModifier;
use Phplrt\Compiler\Generator\TargetPhpVersion;
use Phplrt\Source\FileSource;

require __DIR__ . '/../vendor/autoload.php';

const GRAMMAR_PATHNAME = __DIR__ . '/../resources/grammar.pp3';
const OUTPUT_PATHNAME = __DIR__ . '/../src/Parser/CompiledParserExecutor.php';

(new Compiler())
    ->load(FileSource::createFromPathname(GRAMMAR_PATHNAME))
    ->generate()
    // The reducers refer to the nodes relative to these namespaces,
    // e.g. Node\Identifier, Literal\IntLiteral\DecIntLiteral or BinaryExpression\AddExpression
    ->withClassImport('FFI\Parser\Node')
    ->withClassImport('FFI\Parser\Node\Declaration')
    ->withClassImport('FFI\Parser\Node\Declaration\SpecifiedDeclaration')
    ->withClassImport('FFI\Parser\Node\Expression')
    ->withClassImport('FFI\Parser\Node\Expression\BinaryExpression')
    ->withClassImport('FFI\Parser\Node\Expression\MemberExpression')
    ->withClassImport('FFI\Parser\Node\Expression\UnaryExpression')
    ->withClassImport('FFI\Parser\Node\Initializer')
    ->withClassImport('FFI\Parser\Node\Initializer\InitializerList\DesignatedInitializer')
    ->withClassImport('FFI\Parser\Node\Literal')
    ->withClassImport('FFI\Parser\Node\Specifier')
    ->withClassImport('FFI\Parser\Node\Type')
    // The token the @var tags of the reducers refer to
    ->withClassImport('Phplrt\Contracts\Lexer\TokenInterface')
    ->withNamespaceName('FFI\Parser\Parser')
    ->withClassName('CompiledParserExecutor')
    // The generated class only exposes parse(), the syntax check is
    // reachable through its protected property alone, so it is opened
    // up by the hand-written ParserExecutor subclass.
    ->withClassModifier(ClassModifier::Abstract)
    // The lowest PHP version the library supports, not the one running
    // this script, otherwise the parser would not load under PHP 8.1.
    ->withTargetPhpVersion(TargetPhpVersion::Php81)
    ->save(OUTPUT_PATHNAME);

\fwrite(\STDOUT, \sprintf("Generated into %s\n", \realpath(OUTPUT_PATHNAME)));
