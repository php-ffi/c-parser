includes:
  - phar://phpstan.phar/conf/bleedingEdge.neon
  - vendor/phpat/phpat/extension.neon
  - vendor/phpstan/phpstan-deprecation-rules/rules.neon
  - vendor/phpstan/phpstan-strict-rules/rules.neon
parameters:
  level: max
  phpVersion:
    min: 80100
    max: 80500
  strictRules:
    allRules: true
  phpat:
    show_rule_names: true
    ignore_built_in_classes: true
  paths:
    - src
    - tests/Architecture
  fileExtensions:
    - php
  tmpDir: vendor/.cache.phpstan
  reportUnmatchedIgnoredErrors: true
  ignoreErrors:
    # Every generated reducer receives $ctx and $children, whether the
    # grammar uses them or not. The rest of the reducer code is analysed.
    -
      identifier: method.unusedParameter
      path: src/Parser/CompiledParserExecutor.php
    # The reducers check the extensions through the methods of the
    # hand-written ParserExecutor, which extends the generated class.
    -
      identifier: method.notFound
      message: '#::assert(Feature|KeywordSpelling)\(\)#'
      path: src/Parser/CompiledParserExecutor.php
services:
  -
    class: FFI\Parser\Tests\Architecture\LibraryArchitectureTest
    tags:
      - phpat.test
