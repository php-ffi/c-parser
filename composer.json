{
    "name": "ffi/c-parser",
    "type": "library",
    "description": "PHP FFI-compatible ISO/IEC 9899:2024 (С23) parser implementation",
    "license": "MIT",
    "keywords": [
        "ffi",
        "reflection",
        "parser",
        "c",
        "ast"
    ],
    "support": {
        "source": "https://github.com/php-ffi/c-parser",
        "issues": "https://github.com/php-ffi/c-parser/issues",
        "docs": "https://github.com/php-ffi/c-parser/blob/master/README.md"
    },
    "authors": [
        {
            "name": "Nesmeyanov Kirill",
            "email": "nesk@xakep.ru",
            "homepage": "https://nesk.me",
            "role": "maintainer"
        }
    ],
    "require": {
        "php": "^8.1",
        "symfony/polyfill-php85": "^1.43",
        "phplrt/exception": "^4.2",
        "phplrt/parser": "^4.2.3",
        "phplrt/lexer": "^4.2"
    },
    "autoload": {
        "psr-4": {
            "FFI\\Parser\\": "src"
        }
    },
    "suggest": {
        "ext-gmp": "Speeds up parsing of integer constants that do not fit in a PHP integer",
        "ext-bcmath": "Speeds up parsing of integer constants that do not fit in a PHP integer",
        "ext-mbstring": "Speeds up decoding of universal character names in string literals"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpat/phpat": "^0.12",
        "phplrt/compiler": "^4.2.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0|^13.0",
        "symfony/var-dumper": "^6.4|^7.4|^8.0"
    },
    "autoload-dev": {
        "psr-4": {
            "FFI\\Parser\\Tests\\": "tests"
        }
    },
    "scripts-aliases": {
        "test:unit": ["test", "phpunit", "unit"],
        "linter:check": ["linter", "stan"],
        "phpcs:fix": ["phpcs", "cs", "psr", "per"],
        "grammar:check": ["grammar"],
        "grammar:build": ["build"]
    },
    "scripts": {
        "grammar:check": "phplrt check resources/grammar.pp3 -v",
        "grammar:build": "@php bin/build-parser",
        "test:unit": "phpunit --testdox",
        "linter:check": "phpstan analyse --configuration phpstan.neon --memory-limit 256M",
        "linter:baseline": "@linter:check --generate-baseline",
        "phpcs:check": "@phpcs:fix --dry-run",
        "phpcs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes --verbose --diff"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev",
            "dev-master": "1.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
